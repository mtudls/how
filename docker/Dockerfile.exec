# Minimal disposable sandbox for executing a single suggested shell command.
# No docker socket, no host mounts, no secrets, no network (--network none).
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
        bash coreutils findutils grep sed gawk \
        git tmux psmisc openssh-client \
        file tar xz-utils gzip bzip2 jq bc less ncurses-bin \
        procps iproute2 \
        curl ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 --shell /bin/bash sandbox
USER sandbox
WORKDIR /home/sandbox
CMD ["bash", "-c", "echo sandbox-ready"]
