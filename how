def check_feedback_safety(message: str) -> tuple[bool, str]:
    """
    Validates feedback content against DoS (payload size) and Prompt Injection / Malicious patterns.
    Returns (is_safe, reason).
    """
    if len(message) > 1000:
        return False, "Feedback message exceeds maximum allowed length (1000 chars)."

    # Prompt injection & jailbreak signature detection
    injection_patterns = [
        r"ignore\s+(previous|all)\s+instructions",
        r"disregard\s+(previous|all)\s+instructions",
        r"system\s*:\s*",
        r"assistant\s*:\s*",
        r"you\s+are\s+now\s+a",
        r"jailbreak",
        r"dan\s+mode",
        r"<\|im_start\|>",
        r"<\|im_end\|>",
        r"\[INST\]",
        r"\[/INST\]",
        r"===\s*system",
        r"base64\s*decode",
        r"eval\s*\(",
        r"exec\s*\(",
        r"DROP\s+TABLE",
        r"--\s*$",
        r"union\s+select",
        r"<script",
        r"javascript:",
    ]
    for pat in injection_patterns:
        if re.search(pat, message, re.IGNORECASE):
            return False, "Potentially unsafe pattern or prompt-injection attempt detected."

    return True, ""

def send_terminal_feedback(message=""):
    """
    Submits ultra-lightweight feedback directly from the terminal.
    Includes rate-limiting (anti-DoS) and prompt-injection safety guardrails.
    If rejected, politely directs user to contact @mtulds on X.
    """
    if not message:
        print(f"\n{BOLD}{MAGENTA}◆ Quick Terminal Feedback{RESET}")
        print(f"{DIM}Share a quick thought, broken command, or suggestion directly from terminal.{RESET}\n")
        try:
            message = input(f"{CYAN}Feedback:{RESET} ").strip()
        except (KeyboardInterrupt, EOFError):
            print()
            return
        if not message:
            print(f"{DIM}Feedback cancelled.{RESET}")
            return

    # 1. Rate-limiting guardrail (local anti-flood: max 1 submission per 10 seconds)
    cfg = load_config()
    last_sent = cfg.get("last_feedback_time", 0)
    now = time.time()
    if now - last_sent < 10:
        print(f"\n{YELLOW}! Please wait {int(10 - (now - last_sent))}s before sending another feedback.{RESET}\n")
        return

    # 2. Content & Prompt-Injection Safety Guardrail
    is_safe, reason = check_feedback_safety(message)
    if not is_safe:
        print(f"\n{YELLOW}Sorry, this feedback could not be accepted automatically ({reason}).{RESET}")
        print(f"{BOLD}Please share your feedback or problem directly via X (Twitter) with {CYAN}@mtulds{RESET}.\n")
        return

    # Update rate-limiting timestamp
    cfg["last_feedback_time"] = now
    save_config(cfg)

    # Check for configured webhook (e.g. Google Apps Script / Worker / Form URL)
    webhook_url = os.environ.get("HOW_FEEDBACK_WEBHOOK") or cfg.get("feedback_webhook")

    if webhook_url:
        import urllib.request
        import urllib.error
        payload = json.dumps({
            "feedback": message,
            "timestamp": now,
            "version": "0.1.0",
            "os": sys.platform
        }).encode("utf-8")
        req = urllib.request.Request(
            webhook_url,
            data=payload,
            headers={**COMMON_HEADERS, "Content-Type": "application/json"}
        )
        print(f"{DIM}Sending feedback...{RESET} ", end="", flush=True)
        try:
            with urllib.request.urlopen(req, timeout=4) as resp:
                if resp.status in (200, 201, 204):
                    print(f"{GREEN}✓ Sent! Thank you.{RESET}\n")
                    return
        except Exception:
            print(f"{YELLOW}(webhook unavailable){RESET}")

    # GitHub CLI fallback (if user has `gh` installed and authenticated, zero browser hop!)
    import subprocess
    try:
        proc = subprocess.run(
            ["gh", "issue", "create", "--repo", "mdsyseng/how", "--title", f"Quick Feedback: {message[:60]}", "--body", message, "--label", "feedback"],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=5
        )
        if proc.returncode == 0:
            issue_url = proc.stdout.strip()
            print(f"{GREEN}✓ Issue created directly from terminal:{RESET} {issue_url}\n")
            return
    except Exception:
        pass

    # Browser fallback
    open_feedback_url(message)

def open_feedback_url(query=""):
    """Opens GitHub issues page to effortlessly report a bug or suggest an improvement."""
    import urllib.parse
    base_url = "https://github.com/mdsyseng/how/issues/new"
    if query:
        title = f"Feedback: {query[:50]}"
        body = f"### Query / Context\n`how {query}`\n\n### What happened / What could be better?\n"
        params = urllib.parse.urlencode({"title": title, "body": body})
        url = f"{base_url}?{params}"
    else:
        url = base_url
    print(f"\n{BOLD}{MAGENTA}◆ Opening feedback in browser...{RESET}")
    print(f"{DIM}{url}{RESET}\n")
    if not open_url_in_browser(url):
        print(f"{YELLOW}! Could not open browser automatically. Visit the link above to submit feedback.{RESET}\n")

