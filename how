def check_all_models():
    """Testuje dostępność każdego z modeli mikro-zapytaniem."""
    import urllib.request
    import urllib.error
    api_key = get_api_key()
    if not api_key:
        print(f"{YELLOW}! Najpierw się zaloguj.{RESET}")
        auth_login()
        api_key = get_api_key()
        if not api_key:
            return

    print(f"\n{BOLD}{MAGENTA}◆ Testowanie dostępności modeli w koncie Groq...{RESET}\n")
    print(f"{DIM}Pobieranie listy modeli...{RESET}", end="", flush=True)
    models, err = fetch_available_models(api_key)
    print("\r" + " " * 35 + "\r", end="")

    if err or not models:
        print(f"{RED}✗ Nie udało się pobrać modeli: {err}{RESET}")
        return

    cfg = load_config()
    tested = cfg.get("tested_models", {})
    headers = {
        **COMMON_HEADERS,
        "Authorization": f"Bearer {api_key}",
        "Content-Type": "application/json"
    }

    for m in models:
        print(f"  {CYAN}➜{RESET} {BOLD}{m:<35}{RESET} ", end="", flush=True)
        payload = json.dumps({
            "model": m,
            "messages": [{"role": "user", "content": "hi"}],
            "max_tokens": 1
        }).encode("utf-8")
        req = urllib.request.Request(GROQ_API_URL, data=payload, headers=headers)
        t0 = time.time()
        try:
            with urllib.request.urlopen(req, timeout=8) as res:
                if res.status == 200:
                    dt = int((time.time() - t0) * 1000)
                    print(f"{GREEN}✓ działa{RESET} {DIM}({dt}ms){RESET}")
                    tested[m] = {"ok": True, "latency_ms": dt}
                else:
                    print(f"{RED}✗ błąd ({res.status}){RESET}")
                    tested[m] = {"ok": False, "error": f"HTTP {res.status}"}
        except urllib.error.HTTPError as e:
            try:
                err_data = json.loads(e.read().decode("utf-8"))
                msg = err_data.get("error", {}).get("message", e.reason)
            except Exception:
                msg = e.reason
            short_msg = f"{e.code}: {msg}"
            if len(short_msg) > 45:
                short_msg = short_msg[:42] + "..."
            print(f"{RED}✗ {short_msg}{RESET}")
            tested[m] = {"ok": False, "error": short_msg}
        except Exception as e:
            print(f"{RED}✗ {e}{RESET}")
            tested[m] = {"ok": False, "error": str(e)}

    cfg["tested_models"] = tested
    save_config(cfg)
    print(f"\n{GREEN}✓ Zakończono test modeli.{RESET}\n")

def select_model_interactive(direct_choice=None):
    """Wybiera aktywny model Groq."""
    api_key = get_api_key()
    if not api_key:
        print(f"{YELLOW}! Najpierw się zaloguj.{RESET}")
        auth_login()
        api_key = get_api_key()
        if not api_key:
            return

    cfg = load_config()
    current_model = cfg.get("model", DEFAULT_MODEL)

    print(f"\n{DIM}Pobieranie listy modeli z Groq API...{RESET}", end="", flush=True)
    models, err = fetch_available_models(api_key)
    print("\r" + " " * 45 + "\r", end="")

    if err or not models:
        print(f"{RED}✗ Nie udało się pobrać modeli: {err}{RESET}")
        return

    if direct_choice:
        if direct_choice.lower() == "check":
            check_all_models()
            return

        if direct_choice.isdigit():
            idx = int(direct_choice) - 1
            if 0 <= idx < len(models):
                chosen = models[idx]
            else:
                print(f"{RED}✗ Nieprawidłowy numer modelu.{RESET}")
                return
        else:
            chosen = direct_choice

        cfg["model"] = chosen
        save_config(cfg)
        print(f"{GREEN}✓ Ustawiono model na:{RESET} {CYAN}{chosen}{RESET}\n")
        return

    tested = cfg.get("tested_models", {})

    print(f"\n{BOLD}{MAGENTA}◆ Dostępne modele w Twoim koncie Groq:{RESET}\n")
    for i, m in enumerate(models, 1):
        is_active = (m == current_model)
        star = f"{GREEN}* {RESET}" if is_active else "  "
        m_name = f"{BOLD}{CYAN}{m:<35}{RESET}" if is_active else f"{m:<35}"

        status_str = ""
        if m in tested:
            if tested[m].get("ok"):
                ms = tested[m].get("latency_ms", "-")
                status_str = f" {GREEN}✓{RESET} {DIM}({ms}ms){RESET}"
            else:
                status_str = f" {RED}✗{RESET} {DIM}(niedostępny){RESET}"

        print(f"{star}[{i:2d}] {m_name}{status_str}")

    print(f"\n{DIM}[Wpisz numer 1-{len(models)}, wpisz 'check' aby przetestować, lub Ctrl+C aby anulować]{RESET}")
    try:
        choice = input(f"{BOLD}Wybór [{current_model}]: {RESET}").strip()
    except (KeyboardInterrupt, EOFError):
        print("\nAnulowano.")
        return

    if choice.lower() == "check":
        check_all_models()
        return

    if choice.isdigit():
        idx = int(choice) - 1
        if 0 <= idx < len(models):
            chosen = models[idx]
            cfg["model"] = chosen
            save_config(cfg)
            print(f"\n{GREEN}✓ Zmieniono model na:{RESET} {CYAN}{chosen}{RESET}\n")
        else:
            print(f"\n{RED}✗ Nieprawidłowy numer.{RESET}\n")
    elif choice:
        cfg["model"] = choice
        save_config(cfg)
        print(f"\n{GREEN}✓ Zmieniono model na:{RESET} {CYAN}{choice}{RESET}\n")
    else:
        print(f"\n{DIM}Pozostawiono model: {current_model}{RESET}\n")

def set_verbosity_interactive(new_level=None):
    """Konfiguruje domyślny tryb gadatliwości (zero, low, normal)."""
    cfg = load_config()
    current = cfg.get("verbosity", DEFAULT_VERBOSITY)

    if new_level:
        lvl = new_level.lower().strip()
        if lvl in ("0", "zero", "none", "quiet"):
            lvl = "zero"
        elif lvl in ("1", "low", "minimal", "min"):
            lvl = "low"
        elif lvl in ("2", "normal", "default", "standard"):
            lvl = "normal"
        else:
            print(f"{RED}✗ Nieprawidłowy poziom verbosity: '{new_level}'{RESET}")
            print(f"{DIM}Dozwolone: zero (tylko komenda), low (minimalny opis), normal (standardowy opis){RESET}\n")
            return
        cfg["verbosity"] = lvl
        save_config(cfg)
        print(f"\n{GREEN}✓ Zmieniono domyślny tryb verbosity na: {BOLD}{lvl}{RESET}\n")
        return

    print(f"\n{BOLD}{MAGENTA}◆ Wybór domyślnego trybu szczegółowości (verbosity){RESET}\n")
    print(f"  Aktualny tryb: {BOLD}{CYAN}{current}{RESET}\n")
    print(f"  {BOLD}1{RESET}) {BOLD}zero{RESET}   - Tylko podpowiedź komendy (brak opisów, czysty wynik)")
    print(f"  {BOLD}2{RESET}) {BOLD}low{RESET}    - Minimalny opis (1 krótkie zdanie co to jest + komenda)")
    print(f"  {BOLD}3{RESET}) {BOLD}normal{RESET} - Standardowy poziom (1-2 zdania zwięzłego wyjaśnienia + komenda)\n")

    try:
        ans = input(f"{CYAN}Wybierz tryb [1-3 / zero / low / normal] (domyślnie: {current}):{RESET} ").strip().lower()
    except (KeyboardInterrupt, EOFError):
        print()
        return

    mapping = {
        "1": "zero", "zero": "zero", "0": "zero",
        "2": "low", "low": "low",
        "3": "normal", "normal": "normal"
    }
    chosen = mapping.get(ans)
    if chosen:
        cfg["verbosity"] = chosen
        save_config(cfg)
        print(f"\n{GREEN}✓ Zapisano domyślny tryb verbosity: {BOLD}{chosen}{RESET}\n")
    elif not ans:
        print(f"\n{DIM}Pozostawiono tryb: {current}{RESET}\n")
    else:
        print(f"\n{RED}✗ Niepoprawny wybór.{RESET}\n")

