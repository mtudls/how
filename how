def auth_login():
    """Proste logowanie kluczem API Groq."""
    print(f"\n{BOLD}{MAGENTA}◆ Logowanie do Groq API (Omarchy Helper){RESET}\n")
    print("Darmowy klucz API uzyskasz na:")
    print(f"  {CYAN}{GROQ_KEYS_URL}{RESET}\n")

    try:
        ans = input(f"{DIM}Czy otworzyć stronę w przeglądarce? [T/n]: {RESET}").strip().lower()
        if ans in ("", "t", "y", "tak", "yes"):
            open_url_in_browser(GROQ_KEYS_URL)
    except (KeyboardInterrupt, EOFError):
        print(f"\n{YELLOW}Anulowano.{RESET}\n")
        return

    try:
        key = input(f"\n{BOLD}Wklej Groq API Key (gsk_...): {RESET}").strip()
    except (KeyboardInterrupt, EOFError):
        print(f"\n{YELLOW}Anulowano.{RESET}\n")
        return

    if not key:
        print(f"{RED}✗ Nie podano klucza.{RESET}\n")
        return

    print(f"{DIM}Weryfikacja klucza API...{RESET}", end="", flush=True)
    models, err = fetch_available_models(key)
    print("\r" + " " * 35 + "\r", end="")

    if err:
        print(f"{RED}✗ Błąd weryfikacji: {err}{RESET}")
        print(f"{DIM}Sprawdź czy klucz jest poprawny.{RESET}\n")
        return

    cfg = load_config()
    cfg["api_key"] = key
    save_config(cfg)
    print(f"{GREEN}✓ Zalogowano pomyślnie!{RESET} Klucz zapisano w: {DIM}{CONFIG_FILE}{RESET}\n")

def auth_status():
    """Wyświetla aktualny status autoryzacji."""
    key = get_api_key()
    if not key:
        print(f"\n{YELLOW}! Brak aktywnego klucza Groq API.{RESET}")
        print(f"{DIM}Zaloguj się: {CYAN}how auth login{RESET} lub ustaw zmienną {CYAN}GROQ_API_KEY{RESET}\n")
        return

    masked = key[:7] + "..." + key[-4:] if len(key) > 11 else "***"
    source = "zmienna środowiskowa GROQ_API_KEY" if os.environ.get("GROQ_API_KEY") else CONFIG_FILE
    cfg = load_config()
    model = cfg.get("model", DEFAULT_MODEL)
    verb = cfg.get("verbosity", DEFAULT_VERBOSITY)

    print(f"\n{GREEN}✓ Zalogowano do Groq API{RESET}")
    print(f"  Klucz:     {CYAN}{masked}{RESET} {DIM}(źródło: {source}){RESET}")
    print(f"  Model:     {BOLD}{model}{RESET}")
    print(f"  Verbosity: {BOLD}{verb}{RESET}\n")

def auth_logout():
    """Wylogowuje usuwając klucz z pliku konfiguracyjnego."""
    cfg = load_config()
    if cfg.get("api_key"):
        cfg.pop("api_key", None)
        save_config(cfg)
        print(f"\n{GREEN}✓ Wylogowano.{RESET} Usunięto klucz z {CONFIG_FILE}.\n")
    else:
        print(f"\n{DIM}Brak zapisanego klucza w {CONFIG_FILE}.{RESET}\n")

