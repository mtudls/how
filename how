    "how", "to", "in", "on", "a", "an", "the", "is", "are", "was", "were",
    "do", "does", "did", "can", "could", "should", "would", "i", "you", "my",
    "we", "it", "for", "with", "and", "or", "of", "at", "from", "by", "as",
    "if", "then", "else", "not", "no", "yes", "all", "any", "some", "what",
    "which", "who", "whom", "this", "that", "these", "those", "there", "here",
    "jak", "w", "na", "do", "z", "ze", "o", "dla", "po", "co", "to", "jest",
    "czy", "sie", "się", "lub", "albo", "i", "oraz", "jaki", "jaka", "jakie",
