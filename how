def auth_login():
    """Simple login with Groq API key."""
    print(f"\n{BOLD}{MAGENTA}◆ Groq API Authentication (Omarchy Helper){RESET}\n")
    print("Get your free API key at:")
    print(f"  {CYAN}{GROQ_KEYS_URL}{RESET}\n")

    try:
        ans = input(f"{DIM}Open page in browser? [Y/n]: {RESET}").strip().lower()
        if ans in ("", "y", "yes", "t", "tak"):
            open_url_in_browser(GROQ_KEYS_URL)
    except (KeyboardInterrupt, EOFError):
        print(f"\n{YELLOW}Cancelled.{RESET}\n")
        return

    try:
        key = input(f"\n{BOLD}Paste your Groq API Key (gsk_...): {RESET}").strip()
    except (KeyboardInterrupt, EOFError):
        print(f"\n{YELLOW}Cancelled.{RESET}\n")
        return

    if not key:
        print(f"{RED}✗ No API key provided.{RESET}\n")
        return

    print(f"{DIM}Verifying API key...{RESET}", end="", flush=True)
    models, err = fetch_available_models(key)
    print("\r" + " " * 35 + "\r", end="")

    if err:
        print(f"{RED}✗ Verification error: {err}{RESET}")
        print(f"{DIM}Please check if the key is valid.{RESET}\n")
        return

    cfg = load_config()
    cfg["api_key"] = key
    save_config(cfg)
    print(f"{GREEN}✓ Logged in successfully!{RESET} Key saved in: {DIM}{CONFIG_FILE}{RESET}\n")

def auth_status():
    """Displays current authentication status."""
    key = get_api_key()
    if not key:
        print(f"\n{YELLOW}! No active Groq API key.{RESET}")
        print(f"{DIM}Login with: {CYAN}how auth login{RESET} or set {CYAN}GROQ_API_KEY{RESET}\n")
        return

    masked = key[:7] + "..." + key[-4:] if len(key) > 11 else "***"
    source = "GROQ_API_KEY environment variable" if os.environ.get("GROQ_API_KEY") else CONFIG_FILE
    cfg = load_config()
    model = cfg.get("model", DEFAULT_MODEL)
    verb = cfg.get("verbosity", DEFAULT_VERBOSITY)
    retention_sec = get_effective_retention()
    ret_str = format_retention(retention_sec)

    print(f"\n{GREEN}✓ Authenticated with Groq API{RESET}")
    print(f"  Key:       {CYAN}{masked}{RESET} {DIM}(source: {source}){RESET}")
    print(f"  Model:     {BOLD}{model}{RESET}")
    print(f"  Verbosity: {BOLD}{verb}{RESET}")
    print(f"  Cache:     {BOLD}{ret_str}{RESET}\n")

def auth_logout():
    """Logs out by removing API key from config."""
    cfg = load_config()
    if cfg.get("api_key"):
        cfg.pop("api_key", None)
        save_config(cfg)
        print(f"\n{GREEN}✓ Logged out.{RESET} Removed API key from {CONFIG_FILE}.\n")
    else:
        print(f"\n{DIM}No saved key in {CONFIG_FILE}.{RESET}\n")

