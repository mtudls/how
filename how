    "wyłącz", "restart", "uruchom", "zainstaluj", "install", "update", "upgrade"
}

def get_tldr_content(cmd):
    """Odczytuje stronę tldr bezpośrednio z lokalnego cache Markdown."""
    for base in TLDR_DIRS:
        if not os.path.isdir(base):
            continue
        for platform in ("linux", "common", "osx"):
            target = os.path.join(base, platform, f"{cmd}.md")
            if os.path.isfile(target):
                try:
                    with open(target, "r", encoding="utf-8", errors="ignore") as f:
                        lines = [l for l in f.read().splitlines() if not l.startswith("Found ")]
                        return "\n".join(lines[:35]).strip()
                except Exception:
                    pass
    return None

def get_man_summary(cmd):
    """Pobiera zwięzły początek systemowej strony podręcznika man."""
    import subprocess
    try:
        proc = subprocess.run(
            ["man", "-P", "cat", cmd],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=1
        )
        if proc.returncode == 0 and proc.stdout:
            lines = [l.strip() for l in proc.stdout.splitlines() if l.strip()]
            return "\n".join(lines[:25]).strip()
    except Exception:
        pass
    return None

def get_cli_help(cmd):
    """Pobiera pomoc bezpośrednio z polecenia (np. cmd --help)."""
    import subprocess
    try:
        proc = subprocess.run(
            [cmd, "--help"],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=1
        )
        out = proc.stdout if proc.stdout.strip() else proc.stderr
        if out.strip():
            lines = [l.strip() for l in out.splitlines() if l.strip()]
            return "\n".join(lines[:25]).strip()
    except Exception:
        pass
    return None

def extract_candidate_commands(query):
    """Wyciąga potencjalne nazwy poleceń CLI z zapytania użytkownika."""
    tokens = re.findall(r"[a-zA-Z0-9_\-\.]+", query.lower())
    candidates = []
    for t in tokens:
        t_clean = t.strip(".-_")
        if len(t_clean) < 2 or t_clean in COMMON_STOPWORDS:
            continue
        if t_clean not in candidates:
            candidates.append(t_clean)
    return candidates

def get_system_docs_context(query):
    """
    Szybki lokalny RAG: sprawdza czy w zapytaniu występuje polecenie systemowe
    i dołącza jego lokalną dokumentację (tldr -> man -> --help) do kontekstu Groq.
    """
    paths = os.environ.get("PATH", "").split(os.path.pathsep)
    bins = set()
    for p in paths:
        if os.path.isdir(p):
            try:
                for entry in os.listdir(p):
                    bins.add(entry)
            except Exception:
                pass

    candidates = extract_candidate_commands(query)
    found_docs = []
    for cmd in candidates:
        if cmd not in bins and not cmd.startswith("omarchy-"):
            continue

        # 1. Sprawdź tldr
        t = get_tldr_content(cmd)
        if t:
            found_docs.append(f"=== Official TLDR documentation for '{cmd}' ===\n{t}")
            if len(found_docs) >= 2:
                break
            continue

        # 2. Sprawdź man
        m = get_man_summary(cmd)
        if m:
            found_docs.append(f"=== System manual (man) for '{cmd}' ===\n{m}")
            if len(found_docs) >= 2:
                break
            continue

        # 3. Sprawdź --help
        h = get_cli_help(cmd)
        if h:
            found_docs.append(f"=== CLI help output for '{cmd}' ===\n{h}")
            if len(found_docs) >= 2:
                break

    if not found_docs:
        return ""
    return "\n\n" + "\n\n".join(found_docs)

