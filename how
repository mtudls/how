def parse_retention(val) -> int:
    """
    Parses retention time string according to format:
      m - minutes
      h - hours
      D - days
      M - months
    Also supports full words (minutes, hours, days, months) and combinations (e.g. 1D 2h).
    Values '0', 'off', 'disable', 'none' disable caching (0 seconds).
    """
    if isinstance(val, (int, float)):
        return max(0, int(val))
    text = str(val).strip().replace(",", ".")
    text_lower = text.lower()
    if text_lower in ("0", "off", "disable", "disabled", "none", "false", "brak", "wylacz", "wyłącz"):
        return 0

    text = re.sub(r"^(?:retention|retencja|time|czas)\s*(?:=|:|\s)?\s*", "", text, flags=re.IGNORECASE)
    pattern = r"(\d+(?:\.\d+)?)\s*([a-zA-Z]+)?"

    # Ensure full string matched with no leftovers
    leftover = re.sub(pattern, "", text).strip()
    if leftover:
        raise ValueError(f"Unrecognized retention time format: \"{leftover}\"")

    matches = list(re.finditer(pattern, text))
    if not matches:
        raise ValueError(f"Invalid retention time format: \"{val}\"")

    WORD_MAP = {
        # Seconds
        "s": 1, "sec": 1, "secs": 1, "second": 1, "seconds": 1,
        # Minutes
        "min": 60, "mins": 60, "minute": 60, "minutes": 60, "minuta": 60, "minuty": 60, "minut": 60,
        # Hours
        "hr": 3600, "hrs": 3600, "hour": 3600, "hours": 3600, "godz": 3600, "godzina": 3600, "godziny": 3600, "godzin": 3600,
        # Days
        "day": 86400, "days": 86400, "dzien": 86400, "dzień": 86400, "dni": 86400,
        # Weeks
        "w": 7 * 86400, "wk": 7 * 86400, "week": 7 * 86400, "weeks": 7 * 86400,
        # Months (30 days)
        "mo": 30 * 86400, "mon": 30 * 86400, "month": 30 * 86400, "months": 30 * 86400, "miesiac": 30 * 86400, "miesiąc": 30 * 86400, "miesiace": 30 * 86400, "miesiące": 30 * 86400, "miesiecy": 30 * 86400, "miesięcy": 30 * 86400,
    }

    total_seconds = 0
    for m in matches:
        num = float(m.group(1))
        unit = m.group(2)
        if not unit:
            if len(matches) == 1:
                int_n = int(num) if num.is_integer() else num
                raise ValueError(f"Missing time unit for value {int_n} (use: m - minutes, h - hours, D - days, M - months)")
            else:
                raise ValueError(f"Missing time unit for value {num}")

        # Case-sensitive single-letter units:
        # m - minutes; h - hours; D - days; M - months
        if unit == "m":
            multiplier = 60
        elif unit == "M":
            multiplier = 30 * 86400
        elif unit in ("D", "d"):
            multiplier = 86400
        elif unit in ("h", "H"):
            multiplier = 3600
        elif unit in ("s", "S"):
            multiplier = 1
        elif unit in ("w", "W"):
            multiplier = 7 * 86400
        else:
            u_lower = unit.lower()
            if u_lower in WORD_MAP:
                multiplier = WORD_MAP[u_lower]
            else:
                raise ValueError(f"Unknown time unit: \"{unit}\" (use: m - minutes, h - hours, D - days, M - months)")

        total_seconds += int(num * multiplier)
    return total_seconds

def format_retention(sec: int) -> str:
    """Returns clear, full retention description with concise notation (m, h, D, M)."""
    if sec <= 0:
        return "disabled (0s)"
    parts = []
    mo = sec // (30 * 86400)
    sec_rem = sec % (30 * 86400)
    d = sec_rem // 86400
    sec_rem %= 86400
    h = sec_rem // 3600
    sec_rem %= 3600
    m = sec_rem // 60
    s = sec_rem % 60

    if mo > 0:
        parts.append(f"{mo} month{'s' if mo > 1 else ''} ({mo}M)")
    if d > 0:
        parts.append(f"{d} day{'s' if d > 1 else ''} ({d}D)")
    if h > 0:
        parts.append(f"{h} hour{'s' if h > 1 else ''} ({h}h)")
    if m > 0:
        parts.append(f"{m} minute{'s' if m > 1 else ''} ({m}m)")
    if s > 0:
        parts.append(f"{s}s")
    return ", ".join(parts) if parts else "0s"

def format_retention_short(sec: int) -> str:
    """Returns short time format using: m - minutes, h - hours, D - days, M - months."""
    if sec < 60:
        return f"{sec}s"
    m = sec // 60
    if m < 60:
        s = sec % 60
        return f"{m}m" if s == 0 else f"{m}m {s}s"
    h = m // 60
    m_rem = m % 60
    if h < 24:
        return f"{h}h" if m_rem == 0 else f"{h}h {m_rem}m"
    d = h // 24
    h_rem = h % 24
    if d < 30:
        return f"{d}D" if h_rem == 0 else f"{d}D {h_rem}h"
    M = d // 30
    d_rem = d % 30
    return f"{M}M" if d_rem == 0 else f"{M}M {d_rem}D"

def get_effective_retention(override=None):
    """
    Returns active retention in seconds according to priorities:
    1. override (--retention / --cache-retention flag)
    2. HOW_CACHE_RETENTION environment variable
    3. value from config.json
    4. default: 3 hours (DEFAULT_CACHE_RETENTION)
    """
    if override is not None:
        try:
            return parse_retention(override)
        except ValueError as e:
            print(f"{YELLOW}! Invalid retention flag ({e}), using current configuration.{RESET}")

    env_val = os.environ.get("HOW_CACHE_RETENTION", "").strip()
    if env_val:
        try:
            return parse_retention(env_val)
        except ValueError:
            pass

    cfg = load_config()
    if "cache_retention_seconds" in cfg:
        try:
            return max(0, int(cfg["cache_retention_seconds"]))
        except Exception:
            pass

    if "cache_retention" in cfg:
        try:
            return parse_retention(cfg["cache_retention"])
        except Exception:
            pass

    return DEFAULT_CACHE_RETENTION

def get_db_connection():
    """Opens connection to SQLite cache database with auto table initialization."""
    os.makedirs(CACHE_DIR, exist_ok=True)
    conn = sqlite3.connect(CACHE_DB_FILE, timeout=5.0)
    try:
        conn.execute("PRAGMA journal_mode=WAL")
    except Exception:
        pass
    with conn:
        conn.execute("""
            CREATE TABLE IF NOT EXISTS response_cache (
                key TEXT PRIMARY KEY,
                query TEXT,
                model TEXT,
                verbosity TEXT,
                response TEXT,
                created_at REAL,
                expires_at REAL
            )
        """)
        conn.execute("CREATE INDEX IF NOT EXISTS idx_expires_at ON response_cache(expires_at)")
    return conn

def get_cached_response(query, model, verbosity, retention_seconds):
    """
    Checks if a valid cached response exists for the query.
    Returns (response_text, created_at) or None.
    """
    if retention_seconds <= 0:
        return None
    conn = None
    try:
        norm_query = re.sub(r"\s+", " ", query.strip())
        cache_key = hashlib.sha256(f"{model}:{verbosity}:{norm_query}".encode("utf-8")).hexdigest()
        now = time.time()
        conn = get_db_connection()
        with conn:
            # Periodic cleanup of expired entries
            conn.execute("DELETE FROM response_cache WHERE expires_at < ?", (now,))
            cur = conn.cursor()
            cur.execute(
                "SELECT response, created_at, expires_at FROM response_cache WHERE key = ?",
                (cache_key,)
            )
            row = cur.fetchone()
            if row:
                resp, created_at, expires_at = row
                if now < expires_at:
                    # Sliding expiration: refresh expiration window upon cache hit
                    new_expires_at = now + retention_seconds
                    conn.execute(
                        "UPDATE response_cache SET expires_at = ? WHERE key = ?",
                        (new_expires_at, cache_key)
                    )
                    return resp, created_at
    except Exception:
        pass
    finally:
        if conn:
            try:
                conn.close()
            except Exception:
                pass
    return None

def save_cached_response(query, model, verbosity, response_text, retention_seconds):
    """Saves response to cache database with expiration timestamp."""
    if retention_seconds <= 0 or not response_text:
        return
    conn = None
    try:
        norm_query = re.sub(r"\s+", " ", query.strip())
        cache_key = hashlib.sha256(f"{model}:{verbosity}:{norm_query}".encode("utf-8")).hexdigest()
        now = time.time()
        expires_at = now + retention_seconds
        conn = get_db_connection()
        with conn:
            conn.execute("""
                INSERT OR REPLACE INTO response_cache (key, query, model, verbosity, response, created_at, expires_at)
                VALUES (?, ?, ?, ?, ?, ?, ?)
            """, (cache_key, query, model, verbosity, response_text, now, expires_at))
    except Exception:
        pass
    finally:
        if conn:
            try:
                conn.close()
            except Exception:
                pass

def cache_status():
    """Displays detailed cache status."""
    retention_sec = get_effective_retention()
    ret_str = format_retention(retention_sec)
    status_label = f"{GREEN}enabled{RESET}" if retention_sec > 0 else f"{YELLOW}disabled (0s){RESET}"

    total_entries = 0
    active_entries = 0
    expired_entries = 0
    db_size_kb = 0.0

    if os.path.exists(CACHE_DB_FILE):
        conn = None
        try:
            db_size_kb = os.path.getsize(CACHE_DB_FILE) / 1024.0
            conn = get_db_connection()
            now = time.time()
            with conn:
                cur = conn.cursor()
                cur.execute("SELECT COUNT(*) FROM response_cache")
                total_entries = cur.fetchone()[0]
                cur.execute("SELECT COUNT(*) FROM response_cache WHERE expires_at > ?", (now,))
                active_entries = cur.fetchone()[0]
                expired_entries = total_entries - active_entries
        except Exception:
            pass
        finally:
            if conn:
                try:
                    conn.close()
                except Exception:
                    pass

    print(f"\n{BOLD}{MAGENTA}◆ Groq Response Cache Status{RESET}\n")
    print(f"  Status:    {status_label}")
    print(f"  Retention: {BOLD}{CYAN}{ret_str}{RESET} {DIM}({retention_sec}s){RESET}")
    print(f"  Entries:   {BOLD}{active_entries}{RESET} active {DIM}(total: {total_entries}, expired: {expired_entries}){RESET}")
    print(f"  DB Size:   {DIM}{db_size_kb:.1f} KB{RESET}")
    print(f"  Database:  {DIM}{CACHE_DB_FILE}{RESET}\n")
    print(f"{BOLD}Cache commands:{RESET}")
    print(f"  {CYAN}how cache retention <time>{RESET}  Change retention (e.g. 30m, 3h, 7D, 1M)")
    print(f"  {CYAN}how cache clear{RESET}             Clear entire cache")
    print(f"  {CYAN}how cache off / on{RESET}          Disable or enable cache")
    print(f"  {CYAN}how --no-cache <query>{RESET}      Query bypassing cache\n")

def cache_clear():
    """Clears cache database entries."""
    count = 0
    if os.path.exists(CACHE_DB_FILE):
        conn = None
        try:
            conn = get_db_connection()
            with conn:
                cur = conn.cursor()
                cur.execute("SELECT COUNT(*) FROM response_cache")
                count = cur.fetchone()[0]
                cur.execute("DELETE FROM response_cache")
            try:
                conn.isolation_level = None
                conn.execute("VACUUM")
            except Exception:
                pass
        except Exception as e:
            print(f"{RED}✗ Error clearing cache: {e}{RESET}\n")
            return
        finally:
            if conn:
                try:
                    conn.close()
                except Exception:
                    pass
    print(f"\n{GREEN}✓ Cache cleared.{RESET} {DIM}Removed {count} entries.{RESET}\n")

def cache_set_retention(val=None):
    """Sets new cache retention time."""
    if not val:
        current_sec = get_effective_retention()
        current_str = format_retention(current_sec)
        print(f"\n{BOLD}{MAGENTA}◆ Set Cache Retention Time{RESET}\n")
        print(f"  Current retention: {BOLD}{CYAN}{current_str}{RESET}\n")
        print(f"  {BOLD}Retention format:{RESET} {CYAN}m{RESET} - minutes, {CYAN}h{RESET} - hours, {CYAN}D{RESET} - days, {CYAN}M{RESET} - months")
        print("  Examples:")
        print("    30m              -> 30 minutes")
        print("    3h               -> 3 hours (default)")
        print("    7D               -> 7 days")
        print("    1M               -> 1 month (30 days)")
        print("    3M               -> 3 months (90 days)")
        print("    0 / off          -> disable cache\n")
        try:
            val = input(f"{BOLD}Enter new retention [{current_str}]: {RESET}").strip()
        except (KeyboardInterrupt, EOFError):
            print(f"\n{YELLOW}Cancelled.{RESET}\n")
            return
        if not val:
            print(f"\n{DIM}Kept retention: {current_str}{RESET}\n")
            return

    try:
