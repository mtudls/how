DEEP_QUERY_INDICATORS = (
    "debug", "troubleshoot", "why is", "why does", "black screen", "boot loop",
    "kernel panic", "secure boot", "deadlock", "race condition", "memory leak",
    "segfault", "corrupted", "complex", "regex", "awk", "architecture",
    "optimize", "refactor", "systemd service", "udev rule", "iptables", "nftables",
)


def heuristic_needs_deep_thinking(query: str) -> bool:
    """Fast local pre-check for queries that strongly benefit from deep reasoning."""
    q_low = query.lower().strip()
    if len(q_low.split()) >= 16:
        return True
    return any(ind in q_low for ind in DEEP_QUERY_INDICATORS)


def triage_query_with_groq(query: str, env_context: str = "", api_key: str = None, cfg: dict = None) -> dict:
    """
    Uses Groq's ultra-fast model to triage a user question into:
      {"route": "fast" | "deep", "reason": "..."}
    """
    import json
    import urllib.request

    if cfg is None:
        cfg = load_config()
    if not api_key:
        api_key = get_api_key()

    # Short simple commands (< 6 words, no troubleshooting keywords) take the 0ms fast path
    words = query.strip().split()
    if len(words) <= 5 and not heuristic_needs_deep_thinking(query):
        return {"route": "fast", "reason": "direct short command query", "source": "fast-path"}

    if not api_key:
        route = "deep" if heuristic_needs_deep_thinking(query) else "fast"
        return {"route": route, "reason": "local heuristic (no Groq key)", "source": "heuristic"}

    triage_model = cfg.get("triage_model", DEFAULT_TRIAGE_MODEL)
    sys_msg = (
        "You are a fast query router for a Linux/Omarchy CLI assistant. "
        "Classify the user's query as either FAST (standard command lookup, flags, simple how-to) "
        "or DEEP (complex debugging, multi-step system troubleshooting, bootloader/kernel/hardware failure, "
        "intricate scripting/regex, or subtle architectural problem). "
        "Reply ONLY with valid JSON: {\"route\": \"fast\" or \"deep\", \"reason\": \"<5 words>\"}"
    )
    user_msg = f"Query: {query}"
    if env_context:
        user_msg += f"\nContext: {env_context}"

    payload = {
        "model": triage_model,
        "messages": [
            {"role": "system", "content": sys_msg},
            {"role": "user", "content": user_msg},
        ],
        "temperature": 0.0,
        "max_tokens": 35,
    }
    headers = {
        **COMMON_HEADERS,
        "Authorization": f"Bearer {api_key}",
        "Content-Type": "application/json",
    }
    req = urllib.request.Request(
        GROQ_API_URL,
        data=json.dumps(payload).encode("utf-8"),
        headers=headers,
    )
    try:
        with urllib.request.urlopen(req, timeout=3) as resp:
            if resp.status == 200:
                data = json.loads(resp.read().decode("utf-8"))
                content = data["choices"][0]["message"].get("content", "").strip()
                # Extract JSON object if wrapped
                start = content.find("{")
                end = content.rfind("}")
                if start != -1 and end != -1 and end > start:
                    parsed = json.loads(content[start : end + 1])
                    route = str(parsed.get("route", "fast")).lower()
                    if route in ("fast", "deep"):
                        return {
                            "route": route,
                            "reason": str(parsed.get("reason", "groq triage")),
                            "source": f"groq:{triage_model}",
                        }
                if "deep" in content.lower():
                    return {"route": "deep", "reason": "groq triage classification", "source": f"groq:{triage_model}"}
                return {"route": "fast", "reason": "groq triage classification", "source": f"groq:{triage_model}"}
    except Exception:
        pass

    route = "deep" if heuristic_needs_deep_thinking(query) else "fast"
    return {"route": route, "reason": "heuristic fallback", "source": "heuristic"}


def resolve_deep_provider(cfg=None) -> tuple[str, str, str]:
    """
    Resolves the best available Deep Thinking provider and model:
    Returns (provider, model_name, api_key_or_cmd).
    Priority:
    1. Explicit `think_model` in config or `HOW_THINK_MODEL` env var (e.g. `gemini:gemini-2.5-pro`, `anthropic:claude-3-7-sonnet-latest`, `openai:o3-mini`, `groq:openai/gpt-oss-120b`, `cli:claude`).
    2. External reasoning API keys if present in environment (`GEMINI_API_KEY`, `ANTHROPIC_API_KEY`, `OPENAI_API_KEY`, `OPENROUTER_API_KEY`).
    3. Default Groq reasoning model (`openai/gpt-oss-120b` / `openai/gpt-oss-20b` / `qwen/qwen3.8-27b`).
    """
    if cfg is None:
        cfg = load_config()

    key_map = {
        "cerebras": ("CEREBRAS_API_KEY", "cerebras_api_key", "llama-3.3-70b"),
        "gemini": ("GEMINI_API_KEY", "gemini_api_key", "gemini-2.5-flash"),
        "anthropic": ("ANTHROPIC_API_KEY", "anthropic_api_key", "claude-3-7-sonnet-latest"),
        "openai": ("OPENAI_API_KEY", "openai_api_key", "o3-mini"),
        "openrouter": ("OPENROUTER_API_KEY", "openrouter_api_key", "deepseek/deepseek-r1"),
        "github": ("GITHUB_TOKEN", "github_token", "gpt-4o-mini"),
    }

    configured = os.environ.get("HOW_THINK_MODEL") or cfg.get("think_model") or ""
    if configured:
        if ":" in configured:
            prov, mod = [x.strip() for x in configured.split(":", 1)]
            prov = prov.lower()
            if prov in key_map:
                env_k, cfg_k, _ = key_map[prov]
                return prov, mod, os.environ.get(env_k) or cfg.get(cfg_k, "")
            if prov == "cli":
                return "cli", mod, mod
            if prov == "groq":
                return "groq", mod, get_api_key() or ""
        return "groq", configured, get_api_key() or ""

    for prov, (env_k, cfg_k, def_mod) in key_map.items():
        val = (os.environ.get(env_k) or cfg.get(cfg_k) or "").strip()
        if val:
            return prov, def_mod, val

    return "groq", DEFAULT_THINK_MODEL, get_api_key() or ""


def ask_deep_model(
    sys_prompt: str,
    user_prompt: str,
    verbosity: str = "normal",
    cfg: dict = None,
    exclude_models: set = None,
    defer_uncertain: bool = False,
) -> tuple[str, str]:
    """
    Executes query using the Deep Thinking tier (external provider, CLI agent, or Groq reasoning model).
    Skips any Groq model in `exclude_models` and tries the next reasoning model if a candidate returns 'I don't know'.
    Returns (cleaned_response_text, model_label).
    """
    import json
    import urllib.request

    if cfg is None:
        cfg = load_config()
    excluded = set(exclude_models or ())

    def _post_json(url, payload, extra_headers, timeout=45):
        req = urllib.request.Request(
            url,
            data=json.dumps(payload).encode("utf-8"),
            headers={**COMMON_HEADERS, "Content-Type": "application/json", **extra_headers},
        )
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return json.loads(resp.read().decode("utf-8"))

    def _finish(raw_text, label):
        clean = strip_think_blocks(strip_control_sequences(raw_text))
        if verbosity != "zero" and not (defer_uncertain and is_uncertain_response(clean)):
            print(clean + f"{RESET}\n")
        return clean, label

    provider, model_name, credential = resolve_deep_provider(cfg)
    last_uncertain = ("", "none")

    if provider == "gemini" and credential:
        try:
            data = _post_json(
                f"https://generativelanguage.googleapis.com/v1beta/models/{model_name}:generateContent?key={credential}",
                {
                    "contents": [{"role": "user", "parts": [{"text": f"{sys_prompt}\n\nUser request:\n{user_prompt}"}]}],
                    "generationConfig": {"temperature": 0.1},
                },
                {},
            )
            txt = data["candidates"][0]["content"]["parts"][0]["text"]
            if not is_uncertain_response(txt):
                return _finish(txt, f"gemini:{model_name}")
            last_uncertain = (strip_think_blocks(strip_control_sequences(txt)), f"gemini:{model_name}")
        except Exception:
            pass

    if provider == "anthropic" and credential:
        try:
            data = _post_json(
                "https://api.anthropic.com/v1/messages",
                {"model": model_name, "max_tokens": 1024, "system": sys_prompt, "messages": [{"role": "user", "content": user_prompt}]},
                {"x-api-key": credential, "anthropic-version": "2023-06-01"},
            )
            texts = [b.get("text", "") for b in data.get("content", []) if b.get("type") == "text"]
            txt = "\n".join(texts)
            if not is_uncertain_response(txt):
                return _finish(txt, f"anthropic:{model_name}")
            last_uncertain = (strip_think_blocks(strip_control_sequences(txt)), f"anthropic:{model_name}")
        except Exception:
            pass

    if provider in ("openai", "openrouter", "cerebras", "github") and credential:
        url_map = {
            "openai": "https://api.openai.com/v1/chat/completions",
            "openrouter": "https://openrouter.ai/api/v1/chat/completions",
            "cerebras": "https://api.cerebras.ai/v1/chat/completions",
            "github": "https://models.inference.ai.azure.com/chat/completions",
        }
        url = url_map[provider]
        try:
            data = _post_json(
                url,
                {"model": model_name, "messages": [{"role": "system", "content": sys_prompt}, {"role": "user", "content": user_prompt}]},
                {"Authorization": f"Bearer {credential}"},
            )
            txt = data["choices"][0]["message"].get("content", "")
            if not is_uncertain_response(txt):
                return _finish(txt, f"{provider}:{model_name}")
            last_uncertain = (strip_think_blocks(strip_control_sequences(txt)), f"{provider}:{model_name}")
        except Exception:
            pass

    if provider == "cli" and credential:
        import shutil
        import subprocess
        bin_name = credential.split()[0]
        if shutil.which(bin_name):
            try:
                proc = subprocess.run(
                    [bin_name, "-p", f"{sys_prompt}\n\n{user_prompt}"],
                    stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=45,
                )
                if proc.returncode == 0 and proc.stdout.strip():
                    txt = proc.stdout.strip()
                    if not is_uncertain_response(txt):
                        return _finish(txt, f"cli:{bin_name}")
                    last_uncertain = (strip_think_blocks(strip_control_sequences(txt)), f"cli:{bin_name}")
            except Exception:
                pass

    groq_key = get_api_key()
    if not groq_key:
        if last_uncertain[0]:
            return _finish(last_uncertain[0], last_uncertain[1])
        return "", "none"

    deep_pool = []
    if provider == "groq" and model_name and model_name not in excluded:
        deep_pool.append(model_name)
    for m in (DEFAULT_THINK_MODEL, "openai/gpt-oss-20b", "qwen/qwen3.8-27b"):
        if m not in deep_pool and m not in excluded:
            deep_pool.append(m)
    if not deep_pool and provider == "groq" and model_name:
        deep_pool.append(model_name)

    tried_in_deep = 0
    for cand_model in deep_pool:
        if tried_in_deep >= 2:
            break
        tried_in_deep += 1
        try:
            data = _post_json(
                GROQ_API_URL,
                {
                    "model": cand_model,
                    "messages": [{"role": "system", "content": sys_prompt}, {"role": "user", "content": user_prompt}],
                    "stream": False,
                    "temperature": 0.1,
                },
                {"Authorization": f"Bearer {groq_key}"},
                timeout=40,
            )
            txt = data["choices"][0]["message"].get("content", "")
            if not is_uncertain_response(txt):
                return _finish(txt, cand_model)
            last_uncertain = (strip_think_blocks(strip_control_sequences(txt)), cand_model)
        except Exception:
            continue

    if last_uncertain[0]:
        return _finish(last_uncertain[0], last_uncertain[1])
    return "", "none"


def _read_gh_hosts_oauth_token() -> str:
    """Fast <0.2ms read-only probe of ~/.config/gh/hosts.yml for an active GitHub CLI oauth_token."""
    import re
    gh_hosts = os.path.expanduser("~/.config/gh/hosts.yml")
    if not os.path.isfile(gh_hosts):
        return ""
    try:
        with open(gh_hosts, "r", encoding="utf-8", errors="ignore") as f:
            text = f.read(8192)
        m = re.search(r"oauth_token:\s*([^\s#\"']+)", text)
        if m:
            return m.group(1).strip()
    except Exception:
        pass
    return ""


def discover_zero_setup_provider(cfg: dict = None, include_groq: bool = False, allow_gh_cli: bool = True) -> dict | None:
    """
    Golden Alternative (GA) Zero-Setup Cloud Auto-Discovery:
    Probes existing environment and CLI credentials already present on the developer's machine
    so `how` works out-of-the-box with zero manual API key setup.
    Returns `{"provider", "model", "credential", "source", "label"}` or `None`.
    """
    if cfg is None:
        cfg = load_config()

    if include_groq:
        g_key = get_api_key()
        if g_key:
            mod = cfg.get("model", DEFAULT_MODEL)
            return {
                "provider": "groq",
                "model": mod,
                "credential": g_key,
                "source": "GROQ_API_KEY" if os.environ.get("GROQ_API_KEY") else "config.json",
                "label": f"groq:{mod}",
            }

    cerebras_k = (os.environ.get("CEREBRAS_API_KEY") or cfg.get("cerebras_api_key") or "").strip()
    if cerebras_k:
        mod = cfg.get("cerebras_model", "llama-3.3-70b")
        return {
            "provider": "cerebras",
            "model": mod,
            "credential": cerebras_k,
            "source": "CEREBRAS_API_KEY",
            "label": f"cerebras:{mod}",
        }

    gemini_k = (
        os.environ.get("GEMINI_API_KEY")
        or os.environ.get("GOOGLE_API_KEY")
        or cfg.get("gemini_api_key")
        or ""
    ).strip()
    if gemini_k:
        mod = cfg.get("gemini_model", "gemini-2.5-flash-lite")
        return {
            "provider": "gemini",
            "model": mod,
            "credential": gemini_k,
            "source": "GEMINI_API_KEY",
            "label": f"gemini:{mod}",
        }

    gh_tok = (
        os.environ.get("GITHUB_TOKEN")
        or os.environ.get("GH_TOKEN")
        or cfg.get("github_token")
        or ""
    ).strip()
    if gh_tok:
        mod = cfg.get("github_model", "gpt-4o-mini")
        return {
            "provider": "github",
            "model": mod,
            "credential": gh_tok,
            "source": "GITHUB_TOKEN",
            "label": f"github:{mod}",
        }

    if allow_gh_cli and os.environ.get("HOW_NO_GH_AUTO") not in ("1", "true", "yes"):
        hosts_tok = _read_gh_hosts_oauth_token()
        if hosts_tok:
            mod = cfg.get("github_model", "gpt-4o-mini")
            return {
                "provider": "github",
                "model": mod,
                "credential": hosts_tok,
                "source": "gh:hosts.yml",
                "label": f"github:{mod}",
            }
        import shutil
        import subprocess
        if shutil.which("gh"):
            try:
                proc = subprocess.run(
                    ["gh", "auth", "token"],
                    stdin=subprocess.DEVNULL,
                    stdout=subprocess.PIPE,
                    stderr=subprocess.DEVNULL,
                    text=True,
                    timeout=1.5,
                )
                if proc.returncode == 0 and proc.stdout.strip():
                    mod = cfg.get("github_model", "gpt-4o-mini")
                    return {
                        "provider": "github",
                        "model": mod,
                        "credential": proc.stdout.strip(),
                        "source": "gh auth token",
                        "label": f"github:{mod}",
                    }
            except Exception:
                pass

    for prov, env_k, cfg_k, def_mod in (
        ("openrouter", "OPENROUTER_API_KEY", "openrouter_api_key", "qwen/qwen3-32b:free"),
        ("openai", "OPENAI_API_KEY", "openai_api_key", "gpt-4o-mini"),
        ("anthropic", "ANTHROPIC_API_KEY", "anthropic_api_key", "claude-3-7-sonnet-latest"),
    ):
        val = (os.environ.get(env_k) or cfg.get(cfg_k) or "").strip()
        if val:
            return {
                "provider": prov,
                "model": def_mod,
                "credential": val,
                "source": env_k,
                "label": f"{prov}:{def_mod}",
            }

    return None


def query_zero_setup_provider(
    provider_info: dict,
    sys_prompt: str,
    user_prompt: str,
    enable_search: bool = False,
    timeout: int = 25,
) -> str:
    """
    Executes a CLI query against a discovered Zero-Setup provider
    (Cerebras WSE, Gemini Flash-Lite + Search Grounding, GitHub Models via `gh` token, OpenRouter, OpenAI, or Anthropic).
    Returns cleaned response text or empty string on error.
    """
    import json
    import urllib.request

    if not provider_info:
        return ""
    prov = provider_info.get("provider", "")
    model = provider_info.get("model", "")
    cred = provider_info.get("credential", "")
    if not (prov and model and cred):
        return ""

    def _post(url, payload, extra_headers):
        req = urllib.request.Request(
            url,
            data=json.dumps(payload).encode("utf-8"),
            headers={**COMMON_HEADERS, "Content-Type": "application/json", **extra_headers},
        )
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return json.loads(resp.read().decode("utf-8"))

    try:
        if prov == "gemini":
            url = f"https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent?key={cred}"
            body = {
                "contents": [{"role": "user", "parts": [{"text": f"{sys_prompt}\n\nUser request:\n{user_prompt}"}]}],
                "generationConfig": {"temperature": 0.1},
            }
            if enable_search:
                body["tools"] = [{"google_search": {}}]
            data = _post(url, body, {})
            parts = data["candidates"][0]["content"].get("parts", [])
            txt = "\n".join(p.get("text", "") for p in parts if p.get("text"))
            return strip_think_blocks(strip_control_sequences(txt)).strip()

        if prov == "anthropic":
            data = _post(
                "https://api.anthropic.com/v1/messages",
                {"model": model, "max_tokens": 512, "system": sys_prompt, "messages": [{"role": "user", "content": user_prompt}]},
                {"x-api-key": cred, "anthropic-version": "2023-06-01"},
            )
            texts = [b.get("text", "") for b in data.get("content", []) if b.get("type") == "text"]
            return strip_think_blocks(strip_control_sequences("\n".join(texts))).strip()

        url_map = {
            "groq": GROQ_API_URL,
            "cerebras": "https://api.cerebras.ai/v1/chat/completions",
            "github": "https://models.inference.ai.azure.com/chat/completions",
            "openrouter": "https://openrouter.ai/api/v1/chat/completions",
            "openai": "https://api.openai.com/v1/chat/completions",
        }
        if prov in url_map:
            data = _post(
                url_map[prov],
                {
                    "model": model,
                    "messages": [{"role": "system", "content": sys_prompt}, {"role": "user", "content": user_prompt}],
                    "temperature": 0.1,
                },
                {"Authorization": f"Bearer {cred}"},
            )
            txt = data["choices"][0]["message"].get("content", "")
            return strip_think_blocks(strip_control_sequences(txt)).strip()
    except Exception:
        return ""
    return ""


def manage_triage_command(args):
    """Handles `how triage [on|off|status|<query...>]` subcommand."""
    cfg = load_config()
    if not args:
        sub = "status"
    else:
        sub = args[0].lower()

    if sub in ("on", "enable", "1", "true") and len(args) == 1:
        cfg["triage"] = True
        save_config(cfg)
        print(f"\n{GREEN}✓ Automatic Groq question triage ENABLED.{RESET}\n")
