class HowError(Exception):
    """An expected failure: printed as `how: message` plus a hint, never as a traceback."""

    def __init__(self, code: str, message: str, hint: str = "", exit_code: int = 1):
        super().__init__(message)
        self.code, self.message, self.hint, self.exit_code = code, message, hint, exit_code


# ----------------------------------------------------------------------------- paths & files

def config_dir() -> Path:
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    return Path(os.environ.get("HOW_CONFIG_DIR") or os.path.join(base, "how"))


def state_dir() -> Path:
    base = os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state")
    return Path(os.environ.get("HOW_STATE_DIR") or os.path.join(base, "how"))


def config_file() -> Path:
    return config_dir() / "config.json"


def log_file() -> Path:
    return state_dir() / "how.log"


def last_file() -> Path:
    return state_dir() / "last.json"


def read_json(path: Path) -> dict:
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError) as e:
        if not isinstance(e, FileNotFoundError):
            debug(f"ignoring unreadable {path}: {e}")
        return {}


def write_private(path: Path, text: str) -> None:
    """Atomically writes `text` to `path` with mode 0600 (directory 0700)."""
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    tmp = path.with_name(path.name + ".tmp")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(text)
    os.replace(tmp, path)


def api_key() -> tuple[str, str]:
    """Returns (key, where it came from); ("", "") when there is none."""
    env = os.environ.get("GROQ_API_KEY", "").strip()
