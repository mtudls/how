#!/usr/bin/env python3
# omarchy:summary=Ask in plain words, get one terminal command (copied to clipboard)
# omarchy:group=agent
# omarchy:args=<question...> | bad [note] | good | key
# omarchy:examples=how to find largest files here | how bad | how good
# omarchy:aliases=howto
"""how — ask in plain words, get one terminal command. Python standard library only."""

import json
import os
import re
import subprocess
import sys
import urllib.error
import urllib.request

__version__ = "1.0.0"

CONFIG_DIR = os.environ.get("HOW_CONFIG_DIR") or os.path.expanduser("~/.config/how")
CONFIG_FILE = os.path.join(CONFIG_DIR, "config.json")
LAST_FILE = os.path.join(CONFIG_DIR, "last_answer.json")

API_URL = "https://api.groq.com/openai/v1/chat/completions"
KEYS_URL = "https://console.groq.com/keys"
MODEL = "openai/gpt-oss-120b"
REPO = "mtudls/how"

TTY = sys.stdout.isatty()
COLOR = TTY and not os.environ.get("NO_COLOR") and os.environ.get("TERM") != "dumb"
B, D, G, Y, R, C, X = (("\033[1m", "\033[2m", "\033[32m", "\033[33m", "\033[31m", "\033[36m", "\033[0m")
                       if COLOR else ("",) * 7)

HELP = f"""{B}how{X} — ask in plain words, get one command (copied to clipboard)

  {C}how{X} <question>     e.g. {C}how{X} to find largest files here
  {C}how bad{X} [note]     last answer was wrong: report it and get a better one
  {C}how bad?{X}           same, but tell more first
  {C}how good{X}           last answer was right: report it
  {C}how key{X}            set your free Groq API key
"""

PROMPT = """You are `how`, a terminal expert. The user asks how to do something on their machine.
Machine: {machine}. Omarchy = Arch Linux + Hyprland (+ `omarchy` CLI, pacman/yay, systemd, PipeWire, wl-copy).
Reply EXACTLY in this format:
```bash
<one command, or a short && chain>
```
<one short line: what it does, max 12 words>
If the question is not a task, answer in one short sentence without a code block.
If you are not sure or the tool does not exist, reply exactly: I don't know"""

DESTRUCTIVE = re.compile(
    r"\brm\s+-\w*[rf]|\bdd\s+.*\bof=|\bmkfs|\bwipefs|\bshred\b|\bfdisk\b|\bparted\b|"
    r">\s*/dev/[sn]|\bchmod\s+-R\s+777\s+/|:\(\)\s*\{|\bgit\s+push\s+.*--force|\bgit\s+reset\s+--hard"
)


# ----------------------------------------------------------------------------- config

def load_json(path):
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return {}


def save_json(path, data):
    os.makedirs(CONFIG_DIR, exist_ok=True)
    with open(path, "w", encoding="utf-8") as f:
        json.dump(data, f, indent=2)
    os.chmod(path, 0o600)


def api_key():
    return os.environ.get("GROQ_API_KEY", "").strip() or load_json(CONFIG_FILE).get("api_key", "").strip()


def machine():
    """OS name + shell — the only context sent with a question."""
    name = sys.platform
    try:
        with open("/etc/os-release", encoding="utf-8") as f:
            name = re.search(r'^PRETTY_NAME="?([^"\n]*)', f.read(), re.M).group(1)
    except Exception:
        pass
    if os.path.isdir(os.path.expanduser("~/.local/share/omarchy")) and "omarchy" not in name.lower():
        name += " (Omarchy)"
    return f"{name}, {os.path.basename(os.environ.get('SHELL', 'sh'))}"


# ----------------------------------------------------------------------------- model

def chat(messages, effort="low"):
    key = api_key()
    if not key:
        raise RuntimeError(f"no API key — run {C}how key{X}")
    body = {"model": load_json(CONFIG_FILE).get("model", MODEL), "messages": messages,
            "temperature": 0.1, "reasoning_effort": effort}
    req = urllib.request.Request(API_URL, data=json.dumps(body).encode(), headers={
        "Authorization": f"Bearer {key}", "Content-Type": "application/json", "User-Agent": f"how/{__version__}"})
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            return json.load(r)["choices"][0]["message"]["content"].strip()
    except urllib.error.HTTPError as e:
        if e.code == 401:
            raise RuntimeError(f"API key rejected — run {C}how key{X}")
        if e.code == 429:
            raise RuntimeError("rate limited — try again in a moment")
        raise RuntimeError(f"Groq error {e.code}")
    except urllib.error.URLError:
        raise RuntimeError("no connection to Groq")


def parse(text):
    """Returns (command or None, short note)."""
    m = re.search(r"```[a-z]*\s*\n(.*?)\n```", text, re.S)
    if not m:
        return None, text.strip()
    lines = [ln.strip() for ln in m.group(1).splitlines() if ln.strip() and not ln.strip().startswith("#")]
    note = (text[:m.start()] + text[m.end():]).strip().splitlines()
    return (" && ".join(lines) or None), (note[0].strip() if note else "")


def copy(text):
    for cmd in (["wl-copy"], ["xclip", "-selection", "clipboard"], ["xsel", "--clipboard"]):
        try:
            if subprocess.run(cmd, input=text.encode(), timeout=2, capture_output=True).returncode == 0:
                return True
        except Exception:
            continue
    return False


def show(query, text):
    """Prints an answer. Piped: command only. Remembers it for `how bad` / `how good`."""
    cmd, note = parse(text)
    save_json(LAST_FILE, {"query": query, "command": cmd, "answer": text[:600], "version": __version__})
    danger = bool(cmd and DESTRUCTIVE.search(cmd))
    if not TTY:
        print(cmd or note)
        if danger:
            print("how: ⚠ destructive command", file=sys.stderr)
        return
    if not cmd:
        print(note)
        print(f"{D}  wrong? how bad{X}")
        return
    print(f"{B}{G}{cmd}{X}")
    bits = [note] if note else []
    if danger:
        bits.insert(0, f"{R}⚠ destructive — read before running{X}{D}")
    if copy(cmd):
        bits.append("⎘ copied")
    bits.append("wrong? how bad")
    print(f"{D}  {' · '.join(bits)}{X}")


def ask(query):
    show(query, chat([{"role": "system", "content": PROMPT.format(machine=machine())},
                      {"role": "user", "content": f"how {query}"}]))


# ----------------------------------------------------------------------------- feedback

UNSAFE_NOTE = re.compile(r"ignore\s+(previous|all)\s+instructions|<script|<\|im_start\|>|\[INST\]|jailbreak", re.I)


def send_report(rating, last, note="", system=False):
    """Webhook (HOW_FEEDBACK_WEBHOOK) -> `gh issue create` -> pre-filled issue in browser."""
    badge = {"bad": "👎", "good": "👍"}[rating]
    title = f"{badge} how {last.get('query', '')}"[:80]
    body = f"**Asked:** `how {last.get('query', '')}`\n\n**Answer:**\n```\n{last.get('answer', '')}\n```\n"
    if note:
        body += f"\n**Note:** {note}\n"
    if system:
        body += f"\n**System:** {machine()}\n"
    body += f"\n_how {__version__}_"
    payload = {"rating": rating, "query": last.get("query"), "command": last.get("command"),
               "note": note or None, "system": machine() if system else None, "version": __version__}

    hook = os.environ.get("HOW_FEEDBACK_WEBHOOK") or load_json(CONFIG_FILE).get("feedback_webhook")
    if hook:
        try:
            req = urllib.request.Request(hook, data=json.dumps(payload).encode(),
                                         headers={"Content-Type": "application/json"})
            urllib.request.urlopen(req, timeout=4).close()
            return True
        except Exception:
            pass
    try:
        r = subprocess.run(["gh", "issue", "create", "--repo", REPO, "--title", title, "--body", body,
                            "--label", "feedback"], capture_output=True, text=True, timeout=8)
        if r.returncode == 0:
            return True
    except Exception:
        pass
    if not os.environ.get("HOW_NO_BROWSER"):
        import urllib.parse
        url = f"https://github.com/{REPO}/issues/new?" + urllib.parse.urlencode({"title": title, "body": body})
        subprocess.Popen(["xdg-open", url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return False


def rate(rating, note, dialogue):
    last = load_json(LAST_FILE)
    if not last.get("query"):
        print(f"{Y}Nothing to rate yet — ask something first.{X}")
        return 1
    system = False
    if dialogue and sys.stdin.isatty():
        print(f"{D}how {last['query']}  →  {last.get('command') or last.get('answer', '')[:80]}{X}")
        try:
            extra = input("What went wrong? " if rating == "bad" else "What helped? ").strip()
            system = input(f"Share OS & shell ({machine()})? [y/N] ").strip().lower() in ("y", "yes")
        except (KeyboardInterrupt, EOFError):
            print()
            return 1
        note = " ".join(x for x in (note, extra) if x)
    if UNSAFE_NOTE.search(note) or len(note) > 1000:
        print(f"{Y}That note can't be sent automatically — please share it with @mtulds on X.{X}")
        return 1

    sent = send_report(rating, last, note, system)
    if rating == "good":
        print(f"{D}👍 thanks{'' if sent else ' (opened in browser)'}{X}")
        return 0
    print(f"{D}👎 reported{'' if sent else ' (opened in browser)'} — trying harder…{X}", file=sys.stderr)
    why = f" because: {note}" if note else ""
    show(last["query"], chat([
        {"role": "system", "content": PROMPT.format(machine=machine())},
        {"role": "user", "content": f"how {last['query']}"},
        {"role": "assistant", "content": last.get("answer", "")},
        {"role": "user", "content": f"That answer was wrong{why}. Think again and give a correct one, same format."},
    ], effort="high"))
    return 0


def set_key():
    print(f"Get a free key at {C}{KEYS_URL}{X}")
    if not os.environ.get("HOW_NO_BROWSER"):
        subprocess.Popen(["xdg-open", KEYS_URL], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    try:
        import getpass
        key = getpass.getpass("Paste key (gsk_…): ").strip()
    except (KeyboardInterrupt, EOFError):
        print()
        return 1
    if not key:
        return 1
    cfg = load_json(CONFIG_FILE)
    cfg["api_key"] = key
    save_json(CONFIG_FILE, cfg)
    print(f"{G}✓ saved{X} {D}— try: how to check disk space{X}")
    return 0


# ----------------------------------------------------------------------------- main

# `how good is my wifi` is a question, `how good thanks` is a rating.
QUESTION_WORDS = {"is", "are", "was", "were", "does", "do", "did", "to", "at", "for", "in", "way", "ways",
                  "practice", "practices", "idea", "ideas", "can", "should", "would"}


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(HELP)
        return 0
    if argv[0] in ("-V", "--version"):
        print(f"how {__version__}")
        return 0
    head = argv[0].lower()
    if argv == ["key"]:
        return set_key()
    if head.rstrip("?") in ("bad", "good") and (head.endswith("?") or len(argv) == 1
                                                 or argv[1].lower() not in QUESTION_WORDS):
        return rate(head.rstrip("?"), " ".join(argv[1:]).strip(), head.endswith("?"))
    if not api_key():
        if not sys.stdin.isatty():
            print(f"how: no API key — run {C}how key{X}", file=sys.stderr)
            return 1
        if set_key():
            return 1
    ask(" ".join(argv))
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except RuntimeError as e:
        print(f"{R}how: {e}{X}", file=sys.stderr)
        sys.exit(1)
    except KeyboardInterrupt:
        sys.exit(130)
