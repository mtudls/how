def ask_groq(raw_query, copy_only=False, verbosity=None, no_cache=False, custom_retention=None):
    cfg = load_config()
    model = cfg.get("model", DEFAULT_MODEL)
    if model == "groq/compound":
        model = DEFAULT_MODEL
        cfg["model"] = model
        save_config(cfg)

    if verbosity is None:
        verbosity = cfg.get("verbosity", DEFAULT_VERBOSITY)
    if verbosity not in ("zero", "low", "normal"):
        verbosity = "normal"

    # Sprawdzenie pamięci podręcznej (Cache)
    retention_sec = get_effective_retention(custom_retention)
    env_no_cache = os.environ.get("HOW_NO_CACHE") in ("1", "true", "yes")
    bypass_cache = no_cache or env_no_cache or (retention_sec <= 0)

    if not bypass_cache:
        cached = get_cached_response(raw_query, model, verbosity, retention_sec)
        if cached:
            cached_text, cached_at = cached
            age_sec = max(0, int(time.time() - cached_at))
            age_str = format_retention_short(age_sec) + " temu" if age_sec > 0 else "przed chwilą"

            if verbosity != "zero":
                v_info = f", {verbosity}" if verbosity != "normal" else ""
                print(f"\n{CYAN}{BOLD}how ❯{RESET} {YELLOW}[cache]{RESET} {DIM}(model: {model}{v_info}, {age_str}){RESET}\n")
                print(cached_text.strip() + f"{RESET}\n")

            cmd = extract_executable_command(cached_text)
            if cmd:
                if verbosity == "zero":
                    save_to_bash_history(cmd)
                    log_command_proposal(raw_query, cmd, executed=False)
                    copied = copy_to_clipboard(cmd)
                    clip_hint = f" {GREEN}[skopiowano: Ctrl+Shift+V]{RESET}" if copied else ""
                    print(f"{BOLD}{GREEN}{cmd}{RESET}{clip_hint} {YELLOW}[cache]{RESET}\n")
                else:
                    display_suggested_command(cmd, query=raw_query, is_cached=True)
            else:
                if verbosity == "zero":
                    print(f"{cached_text.strip()} {YELLOW}[cache]{RESET}\n")
            return

    # Jeśli brak w cache, wymagamy klucza Groq API
    import urllib.request
    import urllib.error
    api_key = get_api_key()
    if not api_key:
        print(f"{YELLOW}! Wymagany klucz Groq API.{RESET}")
        auth_login()
        api_key = get_api_key()
        if not api_key:
            return

    optimized_prompt = format_query(raw_query)
    docs_context = get_system_docs_context(raw_query)
    if docs_context:
        optimized_prompt += f"\n\nContext from local system documentation:\n{docs_context}"

    sys_prompt = get_system_prompt(verbosity)

    payload = {
        "model": model,
        "messages": [
            {"role": "system", "content": sys_prompt},
            {"role": "user", "content": optimized_prompt}
        ],
        "stream": True,
        "temperature": 0.1
    }

    headers = {
        **COMMON_HEADERS,
        "Authorization": f"Bearer {api_key}",
        "Content-Type": "application/json"
    }

    req = urllib.request.Request(
        GROQ_API_URL,
        data=json.dumps(payload).encode("utf-8"),
        headers=headers
    )

    if verbosity != "zero":
        v_info = f", {verbosity}" if verbosity != "normal" else ""
        print(f"\n{CYAN}{BOLD}how ❯{RESET} {DIM}(model: {model}{v_info}){RESET}\n")

    full_response = []
    try:
        with urllib.request.urlopen(req, timeout=30) as response:
            for line in response:
                line = line.decode("utf-8").strip()
                if line.startswith("data: "):
                    data_str = line[6:]
                    if data_str == "[DONE]":
                        break
                    try:
                        chunk = json.loads(data_str)
                        delta = chunk["choices"][0]["delta"].get("content", "")
                        full_response.append(delta)
                        if verbosity != "zero":
                            sys.stdout.write(delta)
                            sys.stdout.flush()
                    except Exception:
                        pass
        if verbosity != "zero":
            print(f"{RESET}\n")

        full_text = "".join(full_response)

        # Zapis do pamięci podręcznej jeśli zapytanie powiodło się
        if not bypass_cache and full_text.strip():
            save_cached_response(raw_query, model, verbosity, full_text, retention_sec)

        cmd = extract_executable_command(full_text)
        if cmd:
            if verbosity == "zero":
                save_to_bash_history(cmd)
                log_command_proposal(raw_query, cmd, executed=False)
                copied = copy_to_clipboard(cmd)
                clip_hint = f" {GREEN}[skopiowano: Ctrl+Shift+V]{RESET}" if copied else ""
                print(f"{BOLD}{GREEN}{cmd}{RESET}{clip_hint}\n")
            else:
                display_suggested_command(cmd, query=raw_query)
        else:
            if verbosity == "zero":
                print(full_text.strip() + "\n")

    except urllib.error.HTTPError as e:
        err_msg = e.read().decode("utf-8")
        try:
            err_json = json.loads(err_msg)
            msg = err_json.get("error", {}).get("message", err_msg)
        except Exception:
            msg = err_msg

        if e.code == 429:
            print(f"\n{YELLOW}⚡ Limit Groq API osiągnięty (429 Rate Limit). Spróbuj ponownie za chwilę.{RESET}\n")
        elif e.code in (404, 503):
            fallback_models = ["openai/gpt-oss-120b", "openai/gpt-oss-20b", "qwen/qwen3.8-27b"]
            untried = [m for m in fallback_models if m != model]
            if untried:
                next_model = untried[0]
                print(f"\n{YELLOW}! Model '{model}' niedostępny ({e.code}).{RESET}")
                print(f"{CYAN}➜ Automatyczny fallback na model: '{next_model}'...{RESET}\n")
                cfg["model"] = next_model
                save_config(cfg)
                ask_groq(raw_query, copy_only=copy_only, verbosity=verbosity, no_cache=no_cache, custom_retention=custom_retention)
                return
            else:
                print(f"\n{RED}✗ Błąd Groq API ({e.code}): {msg}{RESET}\n")
        else:
            print(f"\n{RED}✗ Błąd Groq API ({e.code}): {msg}{RESET}\n")
    except KeyboardInterrupt:
        print(f"\n{YELLOW}Przerwano przez użytkownika.{RESET}\n")
    except Exception as e:
        print(f"\n{RED}✗ Błąd połączenia: {e}{RESET}\n")

# -----------------------------------------------------------------------------
# Pomoc i punkt wejścia CLI
# -----------------------------------------------------------------------------

def print_help():
    print(f"""Usage:
  {CYAN}how{RESET} [-0|--low] [--no-cache] <query...>
  {CYAN}how{RESET} <command> [args...]

Commands:
  {CYAN}auth{RESET} [login|status|logout]   Zarządzanie kluczem Groq API
  {CYAN}model{RESET} [check]                Wybór i test modeli
  {CYAN}cache{RESET} [retention|clear]      Pamięć podręczna i retencja (m, h, D, M)
  {CYAN}verbosity{RESET} [zero|low|normal]  Domyślny poziom szczegółowości
  {CYAN}history{RESET} [filtr]              Historia proponowanych komend

Options:
  {GREEN}-0, --zero{RESET}                   Tylko komenda (brak opisów)
  {GREEN}--low{RESET}                        Minimalny 1-zdaniowy opis
  {GREEN}--no-cache{RESET}                   Pomiń pamięć podręczną
  {GREEN}--retention <czas>{RESET}           Tymczasowy czas retencji (np. 30m, 3h, 7D, 1M)
""")

def main():
    if len(sys.argv) < 2:
        print_help()
        sys.exit(0)

    raw_args = sys.argv[1:]

    if len(raw_args) == 1 and raw_args[0].lower() in ("--help", "-h", "help"):
        print_help()
        sys.exit(0)

    # Podkomenda 'verbosity': how verbosity [poziom]
    if raw_args[0].lower() in ("verbosity", "verbose"):
        target_v = raw_args[1] if len(raw_args) > 1 else None
        set_verbosity_interactive(target_v)
        sys.exit(0)

    # Parsowanie flag (verbosity, clip, cache)
    verbosity = None
    copy_only = False
    no_cache = False
    custom_retention = None
    args = []
    i = 0
    while i < len(raw_args):
        a = raw_args[i]
        a_lower = a.lower()
        if a_lower in ("-c", "--clip", "--copy"):
            copy_only = True
            i += 1
        elif a_lower in ("-0", "--zero", "-q", "--quiet"):
            verbosity = "zero"
            i += 1
        elif a_lower == "--low":
            verbosity = "low"
            i += 1
        elif a_lower == "--normal":
            verbosity = "normal"
            i += 1
        elif a_lower in ("-v", "--verbosity"):
            if i + 1 < len(raw_args):
                verbosity = raw_args[i + 1].lower()
                i += 2
            else:
                print(f"{RED}✗ Podaj poziom verbosity po fladze {a} (zero, low, normal).{RESET}")
                sys.exit(1)
        elif a_lower.startswith("--verbosity="):
            verbosity = a.split("=", 1)[1].lower()
            i += 1
        elif a_lower.startswith("-v="):
            verbosity = a.split("=", 1)[1].lower()
            i += 1
        elif a_lower in ("--no-cache", "--fresh", "--refresh"):
            no_cache = True
            i += 1
        elif a_lower in ("--retention", "--cache-retention"):
            if i + 1 < len(raw_args):
                custom_retention = raw_args[i + 1]
                i += 2
            else:
                print(f"{RED}✗ Podaj czas retencji po fladze {a} (np. 30m, 3h, 7d, 1mo).{RESET}")
                sys.exit(1)
        elif a_lower.startswith("--retention="):
            custom_retention = a.split("=", 1)[1]
            i += 1
        elif a_lower.startswith("--cache-retention="):
            custom_retention = a.split("=", 1)[1]
            i += 1
        else:
            args.extend(raw_args[i:])
            break

    if not args:
        print_help()
        sys.exit(0)

    first = args[0].lower()

    # Podkomendy 'cache'
    if first == "cache":
        if len(args) == 1:
            cache_status()
            sys.exit(0)
        sub = args[1].lower()
        if sub in ("clear", "clean", "purge", "flush", "reset") and len(args) == 2:
            cache_clear()
            sys.exit(0)
        elif sub in ("status", "info") and len(args) == 2:
            cache_status()
            sys.exit(0)
        elif sub in ("off", "disable", "wyłącz", "wylacz") and len(args) == 2:
            cache_set_retention("0")
            sys.exit(0)
        elif sub in ("on", "enable", "włącz", "wlacz") and len(args) == 2:
            cache_set_retention("3h")
            sys.exit(0)
        elif sub in ("retention", "set"):
            if len(args) > 2:
                cache_set_retention(" ".join(args[2:]))
            else:
                cache_set_retention(None)
            sys.exit(0)
        else:
            cand_time = " ".join(args[1:])
            try:
                # Jeśli sparsuje się poprawnie jako czas, traktujemy jako ustawienie retencji
                parse_retention(cand_time)
                cache_set_retention(cand_time)
                sys.exit(0)
            except ValueError:
                # To zapytanie użytkownika (np. 'how cache works on linux')
                pass

    # Uproszczone podkomendy 'auth': login, status, logout
    if first == "auth":
        if len(args) == 1:
            auth_status()
            sys.exit(0)
        sub = args[1].lower()
        if sub in ("login", "in") and len(args) == 2:
            auth_login()
            sys.exit(0)
        elif sub in ("logout", "out") and len(args) == 2:
            auth_logout()
            sys.exit(0)
        elif sub == "status" and len(args) == 2:
            auth_status()
            sys.exit(0)
        # W przeciwnym razie to zapytanie użytkownika (np. 'how auth works on omarchy?')

    # Skróty historii
    if first in ("history", "commands"):
        filter_t = args[1] if len(args) > 1 else None
        show_command_history(filter_term=filter_t)
        sys.exit(0)

    # Administracyjne podkomendy 'model':
    if first in ("model", "models"):
        if len(args) == 1:
            select_model_interactive()
            sys.exit(0)
        elif len(args) == 2:
            sub = args[1].lower()
            if sub == "check":
                check_all_models()
                sys.exit(0)
            elif sub.isdigit() or "/" in sub:
                select_model_interactive(args[1])
                sys.exit(0)

    # Cała reszta to zapytanie do asystenta
    query = " ".join(args)
    ask_groq(query, copy_only=copy_only, verbosity=verbosity, no_cache=no_cache, custom_retention=custom_retention)

if __name__ == "__main__":
    main()
