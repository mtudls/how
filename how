def get_api_key():
    """Returns API key from GROQ_API_KEY environment variable or config.json."""
    env_k = os.environ.get("GROQ_API_KEY", "").strip()
    if env_k:
        return env_k
    cfg = load_config()
    return cfg.get("api_key", "").strip() or None


def require_api_key(message="! Please log in first."):
    """Ensures an API key is available. Prompts for login if missing."""
    key = get_api_key()
    if not key:
        print(f"{YELLOW}{message}{RESET}")
        auth_login()
        key = get_api_key()
    return key


def fetch_available_models(api_key):
    """Fetches active chat models directly from the Groq API."""
    import json
    import urllib.error
    import urllib.request

    headers = {**COMMON_HEADERS, "Authorization": f"Bearer {api_key}"}
    req = urllib.request.Request(GROQ_MODELS_URL, headers=headers)
    try:
        with urllib.request.urlopen(req, timeout=10) as res:
            if res.status == 200:
                data = json.loads(res.read().decode("utf-8"))
                models = data.get("data", [])
                exclude_keywords = ["whisper", "guard", "safeguard", "orpheus-arabic"]
                chat_models = [
                    m.get("id", "")
                    for m in models
                    if m.get("id") and not any(k in m.get("id", "").lower() for k in exclude_keywords)
                ]
                chat_models.sort(key=lambda x: (0 if "120b" in x else 1, x))
                return chat_models, None
    except urllib.error.HTTPError as e:
        return [], f"Error {e.code}: {e.reason}"
    except Exception as e:
        return [], str(e)
    return [], "Unknown error"


def auth_login():
    """Interactive login flow with Groq API key verification."""
    print(f"\n{BOLD}{MAGENTA}◆ Groq API Authentication (Omarchy Helper){RESET}\n")
    print("Get your free API key at:")
    print(f"  {CYAN}{GROQ_KEYS_URL}{RESET}\n")

