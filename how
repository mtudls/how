DEEP_QUERY_INDICATORS = (
    "debug", "troubleshoot", "why is", "why does", "black screen", "boot loop",
    "kernel panic", "secure boot", "deadlock", "race condition", "memory leak",
    "segfault", "corrupted", "complex", "regex", "awk", "architecture",
    "optimize", "refactor", "systemd service", "udev rule", "iptables", "nftables",
)


def heuristic_needs_deep_thinking(query: str) -> bool:
    """Fast local pre-check for queries that strongly benefit from deep reasoning."""
    q_low = query.lower().strip()
    if len(q_low.split()) >= 16:
        return True
    return any(ind in q_low for ind in DEEP_QUERY_INDICATORS)


def triage_query_with_groq(query: str, env_context: str = "", api_key: str = None, cfg: dict = None) -> dict:
    """
    Uses Groq's ultra-fast model to triage a user question into:
      {"route": "fast" | "deep", "reason": "..."}
    """
    import json
    import urllib.request

    if cfg is None:
        cfg = load_config()
    if not api_key:
        api_key = get_api_key()

    # Short simple commands (< 6 words, no troubleshooting keywords) take the 0ms fast path
    words = query.strip().split()
    if len(words) <= 5 and not heuristic_needs_deep_thinking(query):
        return {"route": "fast", "reason": "direct short command query", "source": "fast-path"}

    if not api_key:
        route = "deep" if heuristic_needs_deep_thinking(query) else "fast"
        return {"route": route, "reason": "local heuristic (no Groq key)", "source": "heuristic"}

    triage_model = cfg.get("triage_model", DEFAULT_TRIAGE_MODEL)
    sys_msg = (
        "You are a fast query router for a Linux/Omarchy CLI assistant. "
        "Classify the user's query as either FAST (standard command lookup, flags, simple how-to) "
        "or DEEP (complex debugging, multi-step system troubleshooting, bootloader/kernel/hardware failure, "
        "intricate scripting/regex, or subtle architectural problem). "
        "Reply ONLY with valid JSON: {\"route\": \"fast\" or \"deep\", \"reason\": \"<5 words>\"}"
    )
    user_msg = f"Query: {query}"
    if env_context:
        user_msg += f"\nContext: {env_context}"

    payload = {
        "model": triage_model,
        "messages": [
            {"role": "system", "content": sys_msg},
            {"role": "user", "content": user_msg},
        ],
        "temperature": 0.0,
        "max_tokens": 35,
    }
    headers = {
        **COMMON_HEADERS,
        "Authorization": f"Bearer {api_key}",
        "Content-Type": "application/json",
    }
    req = urllib.request.Request(
        GROQ_API_URL,
        data=json.dumps(payload).encode("utf-8"),
        headers=headers,
    )
    try:
        with urllib.request.urlopen(req, timeout=3) as resp:
            if resp.status == 200:
                data = json.loads(resp.read().decode("utf-8"))
                content = data["choices"][0]["message"].get("content", "").strip()
                # Extract JSON object if wrapped
                start = content.find("{")
                end = content.rfind("}")
                if start != -1 and end != -1 and end > start:
                    parsed = json.loads(content[start : end + 1])
                    route = str(parsed.get("route", "fast")).lower()
                    if route in ("fast", "deep"):
                        return {
                            "route": route,
                            "reason": str(parsed.get("reason", "groq triage")),
                            "source": f"groq:{triage_model}",
                        }
                if "deep" in content.lower():
                    return {"route": "deep", "reason": "groq triage classification", "source": f"groq:{triage_model}"}
                return {"route": "fast", "reason": "groq triage classification", "source": f"groq:{triage_model}"}
    except Exception:
        pass

    route = "deep" if heuristic_needs_deep_thinking(query) else "fast"
    return {"route": route, "reason": "heuristic fallback", "source": "heuristic"}


def resolve_deep_provider(cfg=None) -> tuple[str, str, str]:
    """
    Resolves the best available Deep Thinking provider and model:
    Returns (provider, model_name, api_key_or_cmd).
    Priority:
    1. Explicit `think_model` in config or `HOW_THINK_MODEL` env var (e.g. `gemini:gemini-2.5-pro`, `anthropic:claude-3-7-sonnet-latest`, `openai:o3-mini`, `groq:deepseek-r1-distill-llama-70b`, `cli:claude`).
    2. External reasoning API keys if present in environment (`GEMINI_API_KEY`, `ANTHROPIC_API_KEY`, `OPENAI_API_KEY`, `OPENROUTER_API_KEY`).
    3. Default Groq reasoning model (`deepseek-r1-distill-llama-70b` / `qwen-qwq-32b` / `openai/gpt-oss-120b`).
    """
    if cfg is None:
        cfg = load_config()

    configured = os.environ.get("HOW_THINK_MODEL") or cfg.get("think_model") or ""
    if configured:
        if ":" in configured:
            prov, mod = configured.split(":", 1)
            prov = prov.lower().strip()
            mod = mod.strip()
            if prov == "gemini":
                return "gemini", mod, os.environ.get("GEMINI_API_KEY") or cfg.get("gemini_api_key", "")
            if prov == "anthropic":
                return "anthropic", mod, os.environ.get("ANTHROPIC_API_KEY") or cfg.get("anthropic_api_key", "")
            if prov == "openai":
                return "openai", mod, os.environ.get("OPENAI_API_KEY") or cfg.get("openai_api_key", "")
            if prov == "openrouter":
                return "openrouter", mod, os.environ.get("OPENROUTER_API_KEY") or cfg.get("openrouter_api_key", "")
            if prov == "cli":
                return "cli", mod, mod
            if prov == "groq":
                return "groq", mod, get_api_key() or ""
        return "groq", configured, get_api_key() or ""

    gemini_key = os.environ.get("GEMINI_API_KEY", "").strip() or cfg.get("gemini_api_key", "").strip()
    if gemini_key:
        return "gemini", "gemini-2.5-flash", gemini_key

    anthropic_key = os.environ.get("ANTHROPIC_API_KEY", "").strip() or cfg.get("anthropic_api_key", "").strip()
    if anthropic_key:
        return "anthropic", "claude-3-7-sonnet-latest", anthropic_key

    openai_key = os.environ.get("OPENAI_API_KEY", "").strip() or cfg.get("openai_api_key", "").strip()
    if openai_key:
        return "openai", "o3-mini", openai_key

    openrouter_key = os.environ.get("OPENROUTER_API_KEY", "").strip() or cfg.get("openrouter_api_key", "").strip()
    if openrouter_key:
        return "openrouter", "deepseek/deepseek-r1", openrouter_key

    return "groq", DEFAULT_THINK_MODEL, get_api_key() or ""


def ask_deep_model(sys_prompt: str, user_prompt: str, verbosity: str = "normal", cfg: dict = None) -> tuple[str, str]:
    """
    Executes query using the Deep Thinking tier (external provider, CLI agent, or Groq reasoning model).
    Returns (cleaned_response_text, model_label).
    """
    import json
    import urllib.request

    if cfg is None:
        cfg = load_config()

    provider, model_name, credential = resolve_deep_provider(cfg)

    if provider == "gemini" and credential:
        url = f"https://generativelanguage.googleapis.com/v1beta/models/{model_name}:generateContent?key={credential}"
        payload = {
            "contents": [
                {"role": "user", "parts": [{"text": sys_prompt + "\n\nUser request:\n" + user_prompt}]}
            ],
            "generationConfig": {"temperature": 0.1},
        }
        req = urllib.request.Request(
            url,
            data=json.dumps(payload).encode("utf-8"),
            headers={**COMMON_HEADERS, "Content-Type": "application/json"},
        )
        try:
            with urllib.request.urlopen(req, timeout=45) as resp:
                data = json.loads(resp.read().decode("utf-8"))
                raw = data["candidates"][0]["content"]["parts"][0]["text"]
                clean = strip_think_blocks(strip_control_sequences(raw))
                if verbosity != "zero":
                    print(clean + f"{RESET}\n")
                return clean, f"gemini:{model_name}"
        except Exception:
            pass

    if provider == "anthropic" and credential:
        url = "https://api.anthropic.com/v1/messages"
        payload = {
            "model": model_name,
            "max_tokens": 1024,
            "system": sys_prompt,
            "messages": [{"role": "user", "content": user_prompt}],
        }
        req = urllib.request.Request(
            url,
            data=json.dumps(payload).encode("utf-8"),
            headers={
                **COMMON_HEADERS,
                "x-api-key": credential,
                "anthropic-version": "2023-06-01",
                "Content-Type": "application/json",
            },
        )
        try:
            with urllib.request.urlopen(req, timeout=45) as resp:
                data = json.loads(resp.read().decode("utf-8"))
                blocks = data.get("content", [])
                texts = [b.get("text", "") for b in blocks if b.get("type") == "text"]
                clean = strip_think_blocks(strip_control_sequences("\n".join(texts)))
                if verbosity != "zero":
                    print(clean + f"{RESET}\n")
                return clean, f"anthropic:{model_name}"
        except Exception:
            pass

    if provider in ("openai", "openrouter") and credential:
        url = (
            "https://api.openai.com/v1/chat/completions"
            if provider == "openai"
            else "https://openrouter.ai/api/v1/chat/completions"
        )
        payload = {
            "model": model_name,
            "messages": [
                {"role": "system", "content": sys_prompt},
                {"role": "user", "content": user_prompt},
            ],
        }
        req = urllib.request.Request(
            url,
            data=json.dumps(payload).encode("utf-8"),
            headers={
                **COMMON_HEADERS,
                "Authorization": f"Bearer {credential}",
                "Content-Type": "application/json",
            },
        )
        try:
            with urllib.request.urlopen(req, timeout=45) as resp:
                data = json.loads(resp.read().decode("utf-8"))
                raw = data["choices"][0]["message"].get("content", "")
                clean = strip_think_blocks(strip_control_sequences(raw))
                if verbosity != "zero":
                    print(clean + f"{RESET}\n")
                return clean, f"{provider}:{model_name}"
        except Exception:
            pass

    if provider == "cli" and credential:
        import shutil
        import subprocess
        bin_name = credential.split()[0]
        if shutil.which(bin_name):
            try:
                proc = subprocess.run(
                    [bin_name, "-p", f"{sys_prompt}\n\n{user_prompt}"],
                    stdin=subprocess.DEVNULL,
                    stdout=subprocess.PIPE,
                    stderr=subprocess.PIPE,
                    text=True,
                    timeout=45,
                )
                if proc.returncode == 0 and proc.stdout.strip():
                    clean = strip_think_blocks(strip_control_sequences(proc.stdout.strip()))
                    if verbosity != "zero":
                        print(clean + f"{RESET}\n")
                    return clean, f"cli:{bin_name}"
            except Exception:
                pass

    # Default / Fallback: Groq Deep Reasoning Pool
    groq_key = get_api_key()
    if not groq_key:
        return "", "none"

    deep_pool = []
    if provider == "groq" and model_name:
        deep_pool.append(model_name)
    for m in (DEFAULT_THINK_MODEL, "qwen-qwq-32b", "openai/gpt-oss-120b"):
        if m not in deep_pool:
            deep_pool.append(m)

    for cand_model in deep_pool:
        payload = {
            "model": cand_model,
            "messages": [
                {"role": "system", "content": sys_prompt},
                {"role": "user", "content": user_prompt},
            ],
            "stream": False,
            "temperature": 0.1,
        }
        req = urllib.request.Request(
            GROQ_API_URL,
            data=json.dumps(payload).encode("utf-8"),
            headers={
                **COMMON_HEADERS,
                "Authorization": f"Bearer {groq_key}",
                "Content-Type": "application/json",
            },
        )
        try:
            with urllib.request.urlopen(req, timeout=40) as resp:
                if resp.status == 200:
                    data = json.loads(resp.read().decode("utf-8"))
                    raw = data["choices"][0]["message"].get("content", "")
                    clean = strip_think_blocks(strip_control_sequences(raw))
                    if verbosity != "zero":
                        print(clean + f"{RESET}\n")
                    return clean, cand_model
        except Exception:
            continue

    return "", "none"


def manage_triage_command(args):
    """Handles `how triage [on|off|status|<query...>]` subcommand."""
    cfg = load_config()
    if not args:
        sub = "status"
    else:
        sub = args[0].lower()

    if sub in ("on", "enable", "1", "true") and len(args) == 1:
        cfg["triage"] = True
        save_config(cfg)
        print(f"\n{GREEN}✓ Automatic Groq question triage ENABLED.{RESET}\n")
        return

    if sub in ("off", "disable", "0", "false") and len(args) == 1:
        cfg["triage"] = False
        save_config(cfg)
        print(f"\n{YELLOW}✓ Automatic Groq question triage DISABLED (all queries use default fast tier unless -t/--think is passed).{RESET}\n")
        return

    if sub in ("status", "info") and len(args) == 1:
        enabled = cfg.get("triage", True)
        status_str = f"{GREEN}enabled{RESET}" if enabled else f"{YELLOW}disabled{RESET}"
        t_model = cfg.get("triage_model", DEFAULT_TRIAGE_MODEL)
        prov, d_model, _ = resolve_deep_provider(cfg)
        print(f"\n{BOLD}{MAGENTA}◆ Groq Question Triage & Deep Thinking Status{RESET}\n")
        print(f"  Auto-Triage:  {status_str}")
        print(f"  Triage Model: {BOLD}{t_model}{RESET} (Groq fast classifier)")
        print(f"  Fast Model:   {BOLD}{cfg.get('model', DEFAULT_MODEL)}{RESET}")
        print(f"  Deep Model:   {BOLD}{CYAN}{prov}:{d_model}{RESET}\n")
        print(f"{BOLD}Triage & Thinking commands:{RESET}")
        print(f"  {CYAN}how triage on / off{RESET}          Enable or disable auto-triage")
        print(f"  {CYAN}how triage <query...>{RESET}        Test how Groq triages a specific question")
        print(f"  {CYAN}how -t / --think <query>{RESET}     Force deep thinking mode")
        print(f"  {CYAN}how --fast <query>{RESET}           Force fast Groq mode")
        print(f"  {CYAN}how model think <model>{RESET}      Set deep thinking model (e.g. gemini:gemini-2.5-pro)\n")
