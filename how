def rewrite_query_with_llm(raw_query: str, api_key: str = None, cfg: dict = None) -> str:
    """Optionally asks the fast triage model to reformulate an ambiguous CLI question into a clear technical request."""
    if not api_key:
        return ""
    if os.environ.get("HOW_LLM_REWRITE") not in ("1", "true", "yes") and not (cfg and cfg.get("llm_query_rewrite")):
        return ""
    import json
    import urllib.request

    triage_model = (cfg or {}).get("triage_model", DEFAULT_TRIAGE_MODEL)
    payload = {
        "model": triage_model,
        "messages": [
            {
                "role": "system",
                "content": (
                    "Rewrite the user's unclear or typo-ridden Linux/Omarchy CLI question into a single clear, "
                    "unambiguous 1-line technical question. Fix typos and name the standard Linux/Arch/Git tool "
                    "if obvious. Output ONLY the rewritten question."
                ),
            },
            {"role": "user", "content": raw_query},
        ],
        "temperature": 0.0,
        "max_tokens": 45,
    }
    req = urllib.request.Request(
        GROQ_API_URL,
        data=json.dumps(payload).encode("utf-8"),
        headers={**COMMON_HEADERS, "Authorization": f"Bearer {api_key}", "Content-Type": "application/json"},
    )
    try:
        with urllib.request.urlopen(req, timeout=3) as resp:
            if resp.status == 200:
                data = json.loads(resp.read().decode("utf-8"))
                rewritten = data["choices"][0]["message"].get("content", "").strip().strip('"')
                if rewritten and len(rewritten) < 160:
                    return rewritten
    except Exception:
        pass
    return ""


def improve_question_for_retry(raw_query: str, env_context: str = "", api_key: str = None, cfg: dict = None) -> tuple[str, str, list[str]]:
    """
    Intermediate Step 1 before 'I don't know':
    Improves the question (fixing typos, expanding shorthand, attaching domain grounding and newly discovered local CLI docs).
    Returns (improved_query, refined_user_prompt, notes).
    """
    improved_q, notes = improve_query_locally(raw_query)
    llm_rewritten = rewrite_query_with_llm(improved_q, api_key=api_key, cfg=cfg)
    if llm_rewritten and llm_rewritten.lower() != improved_q.lower():
        improved_q = llm_rewritten
        notes.append("LLM query reformulation")

    domain_hint = get_domain_grounding_hint(improved_q)
    if domain_hint:
        notes.append("attached Linux/Omarchy domain hint")

    refined_prompt = format_query(improved_q)
    refined_prompt += (
        "\n\nClarification: Omarchy is an Arch Linux + Hyprland system. "
        "If no dedicated `omarchy` subcommand exists for this request, provide the standard Arch Linux, "
        "systemd, Hyprland, Git, or POSIX CLI command."
    )
    if domain_hint:
        refined_prompt += f"\n\nDomain Hint:\n{domain_hint}"
    if env_context:
        refined_prompt += f"\n\nEnvironment & Project Stack:\n{env_context}"

    extra_docs = get_system_docs_context(improved_q)
    if extra_docs:
        refined_prompt += f"\n\nContext from local system documentation:\n{extra_docs}"
        notes.append("attached local CLI docs for refined terms")

    if not notes:
        notes.append("added Arch Linux / Hyprland / POSIX CLI disambiguation")

    return improved_q, refined_prompt, notes


