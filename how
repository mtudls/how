def ask_groq(
    raw_query,
    verbosity=None,
    no_cache=False,
    custom_retention=None,
    think_mode=None,
    no_context=False,
    force_context=False,
    context_mode_override=None,
    dry_run=False,
    no_escalate=False,
    offline=False,
    reflex_first=False,
):
    import hashlib
    import json
    import time

    cfg = load_config()
    model = cfg.get("model", DEFAULT_MODEL)
    if model == "groq/compound":
        model = DEFAULT_MODEL
        cfg["model"] = model
        save_config(cfg)

    if verbosity is None:
        verbosity = cfg.get("verbosity", DEFAULT_VERBOSITY)
    if verbosity not in ("zero", "low", "normal"):
        verbosity = "normal"

    is_offline = (
        offline
        or os.environ.get("HOW_OFFLINE") in ("1", "true", "yes")
        or bool(cfg.get("offline", False))
    )
    if is_offline:
        run_offline_reflex(raw_query, verbosity=verbosity)
        return

    if dry_run:
        print_context_dry_run_plan(query=raw_query)
        t_res = triage_query_with_groq(raw_query, env_context="", api_key=None, cfg=cfg)
        route = t_res.get("route", "fast")
        badge = f"{MAGENTA}{BOLD}DEEP THINKING{RESET}" if route == "deep" else f"{GREEN}{BOLD}FAST DIRECT{RESET}"
        print(f"  {BOLD}[Triage Preview]{RESET} Route: {badge} {DIM}({t_res.get('reason', '-')}, model: {model}){RESET}\n")
        return

    use_reflex_first = (
        reflex_first
        or os.environ.get("HOW_REFLEX") in ("1", "true", "yes")
        or bool(cfg.get("reflex_first", False))
    )
    if use_reflex_first and think_mode != "deep":
        if lookup_system1_reflex(raw_query) is not None:
            run_offline_reflex(raw_query, verbosity=verbosity)
            return

    env_context, _, os_prof, stack_info = get_active_environment_context(
        cfg,
        no_context=no_context,
        force_context=force_context,
        context_mode_override=context_mode_override,
        return_receipt=True,
    )
    is_yolo = (context_mode_override == "yolo") or (cfg.get("context_mode") == "yolo")
    sys_prompt = get_system_prompt(verbosity, deep_mode=(think_mode == "deep"), env_context=env_context)
    prompt_hash = hashlib.sha256(sys_prompt.encode("utf-8")).hexdigest()[:16]
    docs_hash = docs_fingerprint(raw_query)

    retention_sec = get_effective_retention(custom_retention)
    env_no_cache = os.environ.get("HOW_NO_CACHE") in ("1", "true", "yes")
    bypass_cache = no_cache or env_no_cache or (retention_sec <= 0)

    cache_model_key = f"deep:{model}" if think_mode == "deep" else model

    if not bypass_cache:
        cached = get_cached_response(
            raw_query, cache_model_key, verbosity, retention_sec,
            prompt_hash=prompt_hash, docs_hash=docs_hash,
            return_hits=True,
        )
        if cached:
            cached_text, cached_at, hit_count, seconds_since_prev = cached
            cached_text = strip_control_sequences(cached_text)
            age_sec = max(0, int(time.time() - cached_at))
            age_str = format_retention_short(age_sec) + " ago" if age_sec > 0 else "just now"

            # Interactive Repeat-Question Memory (roadmap): offer deep/fix when re-asked soon
            if verbosity == "normal":
                repeat_choice = prompt_repeat_question_memory(
                    raw_query, hit_count, seconds_since_prev
                )
                if repeat_choice == "y":
                    print(
                        f"  {MAGENTA}↻ Fresh Deep Thinking{RESET} "
                        f"{DIM}(bypassing cache for this ask){RESET}\n"
                    )
                    return ask_groq(
                        raw_query,
                        verbosity=verbosity,
                        no_cache=True,
                        custom_retention=custom_retention,
                        think_mode="deep",
                        no_context=no_context,
                        force_context=force_context,
                        context_mode_override=context_mode_override,
                        dry_run=False,
                        no_escalate=no_escalate,
                    )
                if repeat_choice == "e":
                    print(f"  {CYAN}→{RESET} Opening local repair flow ({CYAN}how fix{RESET})...\n")
                    return run_fix_command([], {
                        "verbosity": verbosity,
                        "no_cache": True,
                        "think_mode": "deep",
                        "no_context": no_context,
                        "force_context": force_context,
                        "context_mode_override": context_mode_override,
                    })

            if verbosity != "zero":
                v_info = f", {verbosity}" if verbosity != "normal" else ""
                hit_tag = f", hit #{hit_count}" if hit_count >= 2 else ""
                print(f"\n{CYAN}{BOLD}how ❯{RESET} {YELLOW}[cache]{RESET} {DIM}(model: {cache_model_key}{v_info}, {age_str}{hit_tag}){RESET}")
                if is_yolo or env_context:
                    receipt = format_context_read_receipt(os_prof=os_prof, stack_info=stack_info)
                    print(f"  {CYAN}🔎 Read:{RESET} {DIM}{receipt}{RESET}")
                if verbosity == "normal":
                    if hit_count >= 2:
                        print(
                            f"  {YELLOW}🔁 Asked {hit_count}x:{RESET} {DIM}Dissect flags with {CYAN}how explain{RESET}"
                            f"{DIM}, repair with {CYAN}how fix{RESET}{DIM}, or try deep mode: {CYAN}how -t --no-cache {raw_query}{RESET}"
                        )
                    else:
                        print(f"  {DIM}💡 Didn't work? Re-run fresh with deep thinking: {CYAN}how -t --no-cache {raw_query}{RESET}")
                print("\n" + cached_text.strip() + f"{RESET}\n")

            cmd = extract_executable_command(cached_text)
            emit_command(cmd, query=raw_query, verbosity=verbosity, is_cached=True, raw_text=cached_text)
            return

    import urllib.error
    import urllib.request

    docs_context, docs_read = get_system_docs_context(raw_query, return_sources=True)
    full_receipt = format_context_read_receipt(os_prof=os_prof, stack_info=stack_info, docs_read=docs_read)
    optimized_prompt = format_query(raw_query)
    if env_context:
        optimized_prompt += f"\n\nEnvironment & Project Stack:\n{env_context}"
    if docs_context:
        optimized_prompt += f"\n\nContext from local system documentation:\n{docs_context}"

    # Golden Alternative (GA) Zero-Setup Cascade when no Groq API key is configured:
    # 1. Layer 1: Tier-0 Local Cascade (Episodic History + System-1 Reflex + Slot Filling + Local tldr/omarchy-*)
    # 2. Layer 2: Zero-Setup Cloud Auto-Discovery (GitHub Models via `gh` token, Cerebras, Gemini + Search, OpenRouter)
    if not get_api_key():
        if lookup_system1_reflex(raw_query) is not None:
            run_offline_reflex(raw_query, verbosity=verbosity)
            return
        zs_prov = discover_zero_setup_provider(cfg, include_groq=False)
        if zs_prov:
            if verbosity != "zero":
                v_info = f", {verbosity}" if verbosity != "normal" else ""
                print(
                    f"\n{CYAN}{BOLD}how ❯{RESET} {GREEN}[zero-setup: {zs_prov['label']}]{RESET} "
                    f"{DIM}(via {zs_prov['source']}{v_info}){RESET}"
                )
                if is_yolo or env_context or docs_read:
                    print(f"  {CYAN}🔎 Read:{RESET} {DIM}{full_receipt}{RESET}")
                print()
            zs_text = query_zero_setup_provider(
                zs_prov,
                sys_prompt,
                optimized_prompt,
                enable_search=(zs_prov.get("provider") == "gemini"),
            )
            if zs_text:
                if verbosity != "zero":
                    print(zs_text + f"{RESET}\n")
                if not bypass_cache and not is_uncertain_response(zs_text):
                    save_cached_response(
                        raw_query, cache_model_key, verbosity, zs_text, retention_sec,
                        prompt_hash=prompt_hash, docs_hash=docs_hash,
                    )
                cmd = extract_executable_command(zs_text)
                emit_command(cmd, query=raw_query, verbosity=verbosity, is_cached=False, raw_text=zs_text)
                return

    api_key = require_api_key(message="! Groq API key required.")
    if not api_key:
        return

    # Determine Fast vs Deep Thinking route via explicit flag or Groq Triage
    use_deep = False
    triage_reason = ""
    if think_mode == "deep":
        use_deep = True
        triage_reason = "explicit --think flag"
    elif think_mode == "fast":
        use_deep = False
    elif cfg.get("triage", False) or os.environ.get("HOW_TRIAGE") in ("1", "true", "yes"):
        t_res = triage_query_with_groq(raw_query, env_context=env_context, api_key=api_key, cfg=cfg)
        if t_res.get("route") == "deep":
            use_deep = True
            triage_reason = t_res.get("reason", "complex query")

    if use_deep:
        deep_sys = get_system_prompt(verbosity, deep_mode=True, env_context=env_context)
        prov, d_mod, _ = resolve_deep_provider(cfg)
        if verbosity != "zero":
            reason_tag = f" • {triage_reason}" if triage_reason else ""
            print(f"\n{CYAN}{BOLD}how ❯{RESET} {MAGENTA}[deep: {prov}:{d_mod}{reason_tag}]{RESET}")
            if is_yolo or env_context or docs_read:
                print(f"  {CYAN}🔎 Read:{RESET} {DIM}{full_receipt}{RESET}")
            print()
        deep_text, used_label = ask_deep_model(deep_sys, optimized_prompt, verbosity=verbosity, cfg=cfg)
        if deep_text.strip():
            if not bypass_cache and not is_uncertain_response(deep_text):
                save_cached_response(
                    raw_query, cache_model_key, verbosity, deep_text, retention_sec,
                    prompt_hash=prompt_hash, docs_hash=docs_hash,
                )
            cmd = extract_executable_command(deep_text)
            emit_command(cmd, query=raw_query, verbosity=verbosity, is_cached=False, raw_text=deep_text)
            return

    tried_models = set()
    initial_model = model
    current_model = model
    fallback_pool = ["openai/gpt-oss-120b", "openai/gpt-oss-20b"]
    disable_escalation = (
        no_escalate
        or os.environ.get("HOW_NO_ESCALATE") in ("1", "true", "yes")
        or bool(cfg.get("no_escalate", False))
    )

    while True:
        tried_models.add(current_model)
        payload = {
            "model": current_model,
            "messages": [
                {"role": "system", "content": sys_prompt},
                {"role": "user", "content": optimized_prompt},
            ],
            "stream": True,
            "temperature": 0.1,
        }

        headers = {
            **COMMON_HEADERS,
            "Authorization": f"Bearer {api_key}",
            "Content-Type": "application/json",
        }

        req = urllib.request.Request(
            GROQ_API_URL,
            data=json.dumps(payload).encode("utf-8"),
            headers=headers,
        )

        if verbosity != "zero":
            v_info = f", {verbosity}" if verbosity != "normal" else ""
            print(f"\n{CYAN}{BOLD}how ❯{RESET} {DIM}(model: {current_model}{v_info}){RESET}")
            if is_yolo or env_context or docs_read:
                print(f"  {CYAN}🔎 Read:{RESET} {DIM}{full_receipt}{RESET}")
            print()

        try:
            full_text = stream_groq_response(req, verbosity=verbosity, defer_uncertain=not disable_escalation)

            # Intermediate Steps before returning "I don't know"
            if is_uncertain_response(full_text) and not disable_escalation:
                # Step 1: Improve question (typo repair, shorthand expansion, domain hints, refined local docs) & retry
                improved_q, refined_prompt, notes = improve_question_for_retry(
                    raw_query, env_context=env_context, api_key=api_key, cfg=cfg
                )
                if verbosity != "zero":
                    note_str = ", ".join(notes[:2])
                    q_diff = f' -> "{improved_q}"' if improved_q.lower() != raw_query.strip().lower() else ""
                    print(f"  {YELLOW}🔄 Step 1/2 (Question Refinement):{RESET} {DIM}{note_str}{q_diff}{RESET}")

                retry_payload = {
                    "model": current_model,
                    "messages": [
                        {"role": "system", "content": sys_prompt},
                        {"role": "user", "content": refined_prompt},
                    ],
                    "stream": True,
                    "temperature": 0.1,
                }
                retry_req = urllib.request.Request(
                    GROQ_API_URL,
                    data=json.dumps(retry_payload).encode("utf-8"),
                    headers=headers,
                )
                try:
                    retry_text = stream_groq_response(retry_req, verbosity=verbosity, defer_uncertain=True)
                    if retry_text.strip() and not is_uncertain_response(retry_text):
                        full_text = retry_text
                except Exception:
                    pass

                # Step 2: Reach out to a smarter reasoning model (on configured platform or Groq deep pool)
                if is_uncertain_response(full_text):
                    prov, d_mod, _ = resolve_deep_provider(cfg)
                    if verbosity != "zero":
                        print(f"  {MAGENTA}🧠 Step 2/2 (Smarter Model Escalation):{RESET} {DIM}consulting {prov}:{d_mod}...{RESET}\n")
                    deep_sys = get_system_prompt(verbosity, deep_mode=True, env_context=env_context)
                    deep_text, _ = ask_deep_model(
                        deep_sys,
                        refined_prompt,
                        verbosity=verbosity,
                        cfg=cfg,
                        exclude_models=tried_models,
                        defer_uncertain=True,
                    )
                    if deep_text.strip() and not is_uncertain_response(deep_text):
                        full_text = deep_text
                    elif verbosity != "zero":
                        # All intermediate steps still uncertain -> print honest "I don't know"
                        final_uncertain = (deep_text or full_text or "I don't know").strip()
                        print(final_uncertain + f"{RESET}\n")

            if not bypass_cache and full_text.strip() and not is_uncertain_response(full_text):
                save_cached_response(
                    raw_query, current_model, verbosity, full_text, retention_sec,
                    prompt_hash=prompt_hash, docs_hash=docs_hash,
                )

            if current_model != initial_model:
                cfg["model"] = current_model
                save_config(cfg)

            cmd = extract_executable_command(full_text)
            emit_command(cmd, query=raw_query, verbosity=verbosity, is_cached=False, raw_text=full_text)
            return

        except urllib.error.HTTPError as e:
            try:
                err_msg = e.read().decode("utf-8")
                try:
                    err_json = json.loads(err_msg)
                    msg = err_json.get("error", {}).get("message", err_msg)
                except Exception:
                    msg = err_msg
            finally:
                try:
                    e.close()
                except Exception:
                    pass

            if e.code == 429:
                if lookup_system1_reflex(raw_query) is not None:
                    run_offline_reflex(raw_query, verbosity=verbosity)
                    return
                print(f"\n{YELLOW}⚡ Groq API rate limit reached (429 Rate Limit). Try again in a moment.{RESET}\n")
                return
            if e.code in (404, 503):
                candidates = [m for m in fallback_pool if m not in tried_models]
                if candidates:
                    next_model = candidates[0]
                    print(f"\n{YELLOW}! Model '{current_model}' unavailable ({e.code}).{RESET}")
                    print(f"{CYAN}➜ Automatic fallback to model: '{next_model}'...{RESET}\n")
                    current_model = next_model
                    continue
                if lookup_system1_reflex(raw_query) is not None:
                    run_offline_reflex(raw_query, verbosity=verbosity)
                    return
                print(f"\n{RED}✗ Groq API error ({e.code}): {msg}{RESET}\n")
                return
            print(f"\n{RED}✗ Groq API error ({e.code}): {msg}{RESET}\n")
            return
        except KeyboardInterrupt:
            print(f"\n{YELLOW}Interrupted by user.{RESET}\n")
            return
        except Exception as e:
            if lookup_system1_reflex(raw_query) is not None:
                run_offline_reflex(raw_query, verbosity=verbosity)
                return
            print(f"\n{RED}✗ Connection error: {e}{RESET}\n")
            return


