def save_to_bash_history(cmd, query=""):
    """Appends command to ~/.bash_history with an unverified AI suggestion header if opted in."""
    if not is_bash_history_enabled():
        return
    try:
        hist_path = os.path.expanduser("~/.bash_history")
        with open(hist_path, "a", encoding="utf-8") as f:
            clean_query = query.strip() if query else ""
            if clean_query:
                f.write(f"# how: unverified AI suggestion for: {clean_query}\n")
            else:
                f.write("# how: unverified AI suggestion\n")
            f.write(cmd.strip() + "\n")
    except Exception:
        pass


def extract_executable_command(text):
    """Extracts the executable command from a ```bash or ```sh code block."""
    clean_text = text.strip().lower().rstrip(".!?:")
    if clean_text in ("i don't know", "i dont know", "idk"):
        return None

    import re
    m = re.search(r"```(?:bash|sh)?\s*\n(.*?)\n```", text, re.DOTALL)
    if not m:
        return None

    code = m.group(1).strip()
    lines = [line.strip() for line in code.splitlines() if line.strip() and not line.strip().startswith("#")]
    if not lines:
        return None

    if len(lines) == 1:
        return lines[0]

    if len(lines) <= 3:
        control_keywords = ("if", "then", "else", "fi", "for", "while", "do", "done", "case", "esac")
        if not any(lines[0].startswith(kw) for kw in control_keywords):
            return " && ".join(lines)

    return lines[0]


def display_suggested_command(command, query="", is_cached=False):
    """Displays suggested command, copies to clipboard, and records in history logs."""
    cmd = command.strip()
    if not cmd:
        return

    save_to_bash_history(cmd, query=query)
    log_command_proposal(query, cmd, executed=False)
    copied = copy_to_clipboard(cmd)
    clip_hint = f" {GREEN}[copied to clipboard: paste Ctrl+Shift+V]{RESET}" if copied else ""
    cache_tag = f" {YELLOW}[cache]{RESET}" if is_cached else ""

    print(f"{BOLD}{CYAN}Suggested command:{RESET}{cache_tag}{clip_hint}")
    print(f"  {BOLD}{GREEN}{cmd}{RESET}\n")


def emit_command(cmd, query="", verbosity="normal", is_cached=False, raw_text=""):
    """Unified output handler for zero and non-zero verbosity across cache and live paths."""
    if cmd:
        if verbosity == "zero":
            save_to_bash_history(cmd, query=query)
            log_command_proposal(query, cmd, executed=False)
            copied = copy_to_clipboard(cmd)
            clip_hint = f" {GREEN}[copied: Ctrl+Shift+V]{RESET}" if copied else ""
            cache_tag = f" {YELLOW}[cache]{RESET}" if is_cached else ""
            print(f"{BOLD}{GREEN}{cmd}{RESET}{clip_hint}{cache_tag}\n")
        else:
            display_suggested_command(cmd, query=query, is_cached=is_cached)
    elif verbosity == "zero":
        cache_tag = f" {YELLOW}[cache]{RESET}" if is_cached else ""
        text = (raw_text or "").strip()
        if cache_tag:
            print(f"{text} {YELLOW}[cache]{RESET}\n")
        else:
            print(text + "\n")


def stream_groq_response(req, verbosity="normal"):
    """Streams SSE chunks from Groq API, stripping control sequences on the fly."""
    import json
    import urllib.request

    full_response = []
    with urllib.request.urlopen(req, timeout=30) as response:
        for line in response:
            line = line.decode("utf-8").strip()
            if line.startswith("data: "):
                data_str = line[6:]
                if data_str == "[DONE]":
                    break
                try:
                    chunk = json.loads(data_str)
                    raw_delta = chunk["choices"][0]["delta"].get("content", "")
                    clean_delta = strip_control_sequences(raw_delta)
                    full_response.append(clean_delta)
                    if verbosity != "zero":
                        sys.stdout.write(clean_delta)
                        sys.stdout.flush()
                except Exception:
                    pass
    if verbosity != "zero":
        print(f"{RESET}\n")
    return strip_control_sequences("".join(full_response))


