# Główne zapytanie do Groq API
# -----------------------------------------------------------------------------

def ask_groq(raw_query, copy_only=False, verbosity=None):
    import urllib.request
    import urllib.error
    api_key = get_api_key()
    if not api_key:
        print(f"{YELLOW}! Wymagany klucz Groq API.{RESET}")
        auth_login()
        api_key = get_api_key()
        if not api_key:
            return

    cfg = load_config()
    model = cfg.get("model", DEFAULT_MODEL)
    if model == "groq/compound":
        model = DEFAULT_MODEL
        cfg["model"] = model
        save_config(cfg)

    if verbosity is None:
        verbosity = cfg.get("verbosity", DEFAULT_VERBOSITY)
    if verbosity not in ("zero", "low", "normal"):
        verbosity = "normal"

    optimized_prompt = format_query(raw_query)
    docs_context = get_system_docs_context(raw_query)
    if docs_context:
        optimized_prompt += f"\n\nContext from local system documentation:\n{docs_context}"

    sys_prompt = get_system_prompt(verbosity)

    payload = {
        "model": model,
        "messages": [
            {"role": "system", "content": sys_prompt},
            {"role": "user", "content": optimized_prompt}
        ],
        "stream": True,
        "temperature": 0.1
    }

    headers = {
        **COMMON_HEADERS,
        "Authorization": f"Bearer {api_key}",
        "Content-Type": "application/json"
    }

    req = urllib.request.Request(
        GROQ_API_URL,
        data=json.dumps(payload).encode("utf-8"),
        headers=headers
    )

    if verbosity != "zero":
        v_info = f", {verbosity}" if verbosity != "normal" else ""
        print(f"\n{CYAN}{BOLD}how ❯{RESET} {DIM}(model: {model}{v_info}){RESET}\n")

    full_response = []
    try:
        with urllib.request.urlopen(req, timeout=30) as response:
            for line in response:
                line = line.decode("utf-8").strip()
                if line.startswith("data: "):
                    data_str = line[6:]
                    if data_str == "[DONE]":
                        break
                    try:
                        chunk = json.loads(data_str)
                        delta = chunk["choices"][0]["delta"].get("content", "")
                        full_response.append(delta)
                        if verbosity != "zero":
                            sys.stdout.write(delta)
                            sys.stdout.flush()
                    except Exception:
                        pass
        if verbosity != "zero":
            print(f"{RESET}\n")

        full_text = "".join(full_response)
        cmd = extract_executable_command(full_text)
        if cmd:
            if verbosity == "zero":
                save_to_bash_history(cmd)
                log_command_proposal(raw_query, cmd, executed=False)
                copied = copy_to_clipboard(cmd)
                clip_hint = f" {GREEN}[skopiowano: Ctrl+Shift+V]{RESET}" if copied else ""
                print(f"{BOLD}{GREEN}{cmd}{RESET}{clip_hint}\n")
            else:
                display_suggested_command(cmd, query=raw_query)
        else:
            if verbosity == "zero":
                print(full_text.strip() + "\n")

    except urllib.error.HTTPError as e:
        err_msg = e.read().decode("utf-8")
        try:
            err_json = json.loads(err_msg)
            msg = err_json.get("error", {}).get("message", err_msg)
        except Exception:
            msg = err_msg

        if e.code == 429:
            print(f"\n{YELLOW}⚡ Limit Groq API osiągnięty (429 Rate Limit). Spróbuj ponownie za chwilę.{RESET}\n")
        elif e.code in (404, 503):
            fallback_models = ["openai/gpt-oss-120b", "openai/gpt-oss-20b", "qwen/qwen3.8-27b"]
            untried = [m for m in fallback_models if m != model]
            if untried:
                next_model = untried[0]
                print(f"\n{YELLOW}! Model '{model}' niedostępny ({e.code}).{RESET}")
                print(f"{CYAN}➜ Automatyczny fallback na model: '{next_model}'...{RESET}\n")
                cfg["model"] = next_model
                save_config(cfg)
                ask_groq(raw_query, copy_only=copy_only, verbosity=verbosity)
                return
            else:
                print(f"\n{RED}✗ Błąd Groq API ({e.code}): {msg}{RESET}\n")
        else:
            print(f"\n{RED}✗ Błąd Groq API ({e.code}): {msg}{RESET}\n")
    except KeyboardInterrupt:
        print(f"\n{YELLOW}Przerwano przez użytkownika.{RESET}\n")
    except Exception as e:
        print(f"\n{RED}✗ Błąd połączenia: {e}{RESET}\n")

