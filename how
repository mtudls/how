def copy_to_clipboard(text):
    """Copies text to Wayland (wl-copy) or X11 (xclip/xsel) clipboard if available."""
    import subprocess
    for cmd in (["wl-copy"], ["xclip", "-selection", "clipboard"], ["xsel", "--clipboard"]):
        try:
            p = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            p.communicate(input=text.encode("utf-8"), timeout=1)
            if p.returncode == 0:
                return True
        except Exception:
            continue
    return False


