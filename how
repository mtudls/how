def install_method(path: Optional[str] = None) -> tuple[str, str]:
    """("package" | "plugin" | "script", resolved path) from where this file really lives."""
    real = os.path.realpath(path or __file__)
    if real.startswith("/usr/bin/"):
        return "package", real
    if "/omarchy/plugins/" in real:
        return "plugin", real
    return "script", real


# The published installer pins its own release and verifies `how` against SHA256SUMS.txt before installing.
SCRIPT_UPDATE = f"curl -fsSL {RELEASE_URL}/install.sh | bash"

CHANNELS = {
    "package": f"package {PACKAGE}: updates arrive with `omarchy update` (or `yay -Syu`)",
    "plugin": f"Omarchy plugin: update with `omarchy plugin update {PLUGIN_ID}` (`omarchy update` does not update plugins)",
    "script": "install script: `how update` re-runs the installer for the latest release after you confirm",
}


def cmd_doctor() -> int:
    method, path = install_method()
    key, source = api_key()
    reachable, detail = check_api(key)
    tool = clipboard_tool()
    log_ok = os.access(log_file() if log_file().exists() else nearest_existing(state_dir()), os.W_OK)
    checks = [
        (True, "version", f"how {__version__}, Python {sys.version.split()[0]}"),
        (True, "install", f"{method} ({path})"),
        (bool(key), "API key", f"{masked(key)} from {source}" if key else "missing: run how key"),
        (reachable, "API", detail),
        (bool(tool), "clipboard", tool[0] if tool else "none: install wl-clipboard (or xclip / xsel)"),
        (log_ok, "log", f"{log_file()}" + ("" if log_ok else " (not writable)")),
        (True, "updates", CHANNELS[method]),
    ]
    for ok, label, value in checks:
        mark = paint("✓", "green") if ok else paint("✗", "red")
        print(f"  {mark} {label:<10} {value}")
    return 0 if all(ok for ok, _, _ in checks) else 1


def nearest_existing(path: Path) -> Path:
    while not path.exists() and path != path.parent:
        path = path.parent
    return path


def check_api(key: str) -> tuple[bool, str]:
    """GETs the models list (sends only the key) to see whether the API answers."""
    url = api_url()
    probe = url[: -len("/chat/completions")] + "/models" if url.endswith("/chat/completions") else url
    headers = {"User-Agent": f"how/{__version__}", **({"Authorization": f"Bearer {key}"} if key else {})}
    host = urllib.parse.urlsplit(url).hostname
    try:
        with urllib.request.urlopen(urllib.request.Request(probe, headers=headers), timeout=5):  # nosec B310
            return True, f"{host} reachable" + (", key accepted" if key else "")
    except urllib.error.HTTPError as e:
        if e.code in (401, 403):
            return (False, f"{host} rejected the key: run how key") if key else (True, f"{host} reachable")
        return True, f"{host} reachable (HTTP {e.code})"
    except (urllib.error.URLError, OSError) as e:
        return False, f"cannot reach {host} ({getattr(e, 'reason', e)})"


def cmd_update() -> int:
    method, path = install_method()
    print(f"Installed as: {method} ({path})")
    print(CHANNELS[method])
    if method != "script":
        return 0
    print(paint("\nThis re-runs the latest release's installer, which verifies the download against\n"
                "its SHA256SUMS.txt before replacing this file:\n", "dim") + f"  {SCRIPT_UPDATE}")
    if not interactive():
        print(paint("\nRun it yourself, or run how update in a terminal to confirm.", "dim"))
        return 0
    if not confirm("\nRun it now?"):
        return 0
    return execute("", SCRIPT_UPDATE, classify(SCRIPT_UPDATE)[0], "script", event="update")


def cmd_uninstall() -> int:
    method, path = install_method()
    steps = {
        "package": [f"yay -Rns {PACKAGE}"],
        "plugin": [f"omarchy plugin remove {PLUGIN_ID}", "rm -f ~/.local/bin/how"],
        "script": [f"rm -f {shlex.quote(path)}"],
    }[method]
    print(f"how is installed as: {method} ({path}). To remove it, run:\n")
