def classify_query_intent(query: str) -> str:
    """
    Classifies a natural-language query into one of:
    - 'where': spatial location of files, configs, logs, binaries, systemd units, or ports
    - 'fix': diagnostic or repair request for a failed command or error symptom
    - 'explain': request to dissect or explain a shell command or pipeline
    - 'how': procedural 'how to do X' command synthesis
    """
    import re
    q = (query or "").strip()
    if not q:
        return "how"
    q_low = q.lower()

    if q_low.startswith(("explain ", "dissect ", "anatomy ")) or re.match(
        r"^what\s+does\s+[a-z0-9_\-\./]+\s+-", q_low
    ):
        return "explain"

    if q_low in ("fix", "repair", "diagnose") or q_low.startswith(("fix ", "repair ", "diagnose ")):
        return "fix"
    if any(
        err_k in q_low
        for err_k in (
            "permission denied",
            "db.lck",
            "unable to lock database",
            "has no upstream branch",
            "address already in use",
            "command not found",
        )
    ) and not q_low.startswith(("how ", "to ")):
        return "fix"

    if q_low.startswith(("where ", "where's ", "locate ", "path to ", "location of ")):
        return "where"
    if re.search(
        r"\b(?:where\s+is|where\s+are|config\s+path|config\s+location|file\s+location|which\s+file\s+is)\b",
        q_low,
    ) and not q_low.startswith(("how to ", "how do i ")):
        return "where"

    return "how"


