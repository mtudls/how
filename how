def check_all_models():
    """Tests availability of all models with a micro-query."""
    import urllib.request
    import urllib.error
    api_key = get_api_key()
    if not api_key:
        print(f"{YELLOW}! Please log in first.{RESET}")
        auth_login()
        api_key = get_api_key()
        if not api_key:
            return

    print(f"\n{BOLD}{MAGENTA}◆ Testing model availability in your Groq account...{RESET}\n")
    print(f"{DIM}Fetching model list...{RESET}", end="", flush=True)
    models, err = fetch_available_models(api_key)
    print("\r" + " " * 35 + "\r", end="")

    if err or not models:
        print(f"{RED}✗ Failed to fetch models: {err}{RESET}")
        return

    cfg = load_config()
    tested = cfg.get("tested_models", {})
    headers = {
        **COMMON_HEADERS,
        "Authorization": f"Bearer {api_key}",
        "Content-Type": "application/json"
    }

    for m in models:
        print(f"  {CYAN}➜{RESET} {BOLD}{m:<35}{RESET} ", end="", flush=True)
        payload = json.dumps({
            "model": m,
            "messages": [{"role": "user", "content": "hi"}],
            "max_tokens": 1
        }).encode("utf-8")
        req = urllib.request.Request(GROQ_API_URL, data=payload, headers=headers)
        t0 = time.time()
        try:
            with urllib.request.urlopen(req, timeout=8) as res:
                if res.status == 200:
                    dt = int((time.time() - t0) * 1000)
                    print(f"{GREEN}✓ works{RESET} {DIM}({dt}ms){RESET}")
                    tested[m] = {"ok": True, "latency_ms": dt}
                else:
                    print(f"{RED}✗ error ({res.status}){RESET}")
                    tested[m] = {"ok": False, "error": f"HTTP {res.status}"}
        except urllib.error.HTTPError as e:
            try:
                err_data = json.loads(e.read().decode("utf-8"))
                msg = err_data.get("error", {}).get("message", e.reason)
            except Exception:
                msg = e.reason
            short_msg = f"{e.code}: {msg}"
            if len(short_msg) > 45:
                short_msg = short_msg[:42] + "..."
            print(f"{RED}✗ {short_msg}{RESET}")
            tested[m] = {"ok": False, "error": short_msg}
        except Exception as e:
            print(f"{RED}✗ {e}{RESET}")
            tested[m] = {"ok": False, "error": str(e)}

    cfg["tested_models"] = tested
    save_config(cfg)
    print(f"\n{GREEN}✓ Model check completed.{RESET}\n")

def select_model_interactive(direct_choice=None):
    """Selects active Groq model."""
    api_key = get_api_key()
    if not api_key:
        print(f"{YELLOW}! Please log in first.{RESET}")
        auth_login()
        api_key = get_api_key()
        if not api_key:
            return

    cfg = load_config()
    current_model = cfg.get("model", DEFAULT_MODEL)

    print(f"\n{DIM}Fetching models from Groq API...{RESET}", end="", flush=True)
    models, err = fetch_available_models(api_key)
    print("\r" + " " * 45 + "\r", end="")

    if err or not models:
        print(f"{RED}✗ Failed to fetch models: {err}{RESET}")
        return

    if direct_choice:
        if direct_choice.lower() == "check":
            check_all_models()
            return

        if direct_choice.isdigit():
            idx = int(direct_choice) - 1
            if 0 <= idx < len(models):
                chosen = models[idx]
            else:
                print(f"{RED}✗ Invalid model index.{RESET}")
                return
        else:
            chosen = direct_choice

        cfg["model"] = chosen
        save_config(cfg)
        print(f"{GREEN}✓ Model set to:{RESET} {CYAN}{chosen}{RESET}\n")
        return

    tested = cfg.get("tested_models", {})

    print(f"\n{BOLD}{MAGENTA}◆ Available models in your Groq account:{RESET}\n")
    for i, m in enumerate(models, 1):
        is_active = (m == current_model)
        star = f"{GREEN}* {RESET}" if is_active else "  "
        m_name = f"{BOLD}{CYAN}{m:<35}{RESET}" if is_active else f"{m:<35}"

        status_str = ""
        if m in tested:
            if tested[m].get("ok"):
                ms = tested[m].get("latency_ms", "-")
                status_str = f" {GREEN}✓{RESET} {DIM}({ms}ms){RESET}"
            else:
                status_str = f" {RED}✗{RESET} {DIM}(unavailable){RESET}"

        print(f"{star}[{i:2d}] {m_name}{status_str}")

    print(f"\n{DIM}[Enter number 1-{len(models)}, type 'check' to test, or Ctrl+C to cancel]{RESET}")
    try:
        choice = input(f"{BOLD}Select [{current_model}]: {RESET}").strip()
    except (KeyboardInterrupt, EOFError):
        print("\nCancelled.")
        return

    if choice.lower() == "check":
        check_all_models()
        return

    if choice.isdigit():
        idx = int(choice) - 1
        if 0 <= idx < len(models):
            chosen = models[idx]
            cfg["model"] = chosen
            save_config(cfg)
            print(f"\n{GREEN}✓ Changed model to:{RESET} {CYAN}{chosen}{RESET}\n")
        else:
            print(f"\n{RED}✗ Invalid number.{RESET}\n")
    elif choice:
        cfg["model"] = choice
        save_config(cfg)
        print(f"\n{GREEN}✓ Changed model to:{RESET} {CYAN}{choice}{RESET}\n")
    else:
        print(f"\n{DIM}Kept current model: {current_model}{RESET}\n")

def set_verbosity_interactive(new_level=None):
    """Sets default verbosity mode (zero, low, normal)."""
    cfg = load_config()
    current = cfg.get("verbosity", DEFAULT_VERBOSITY)

    if new_level:
        lvl = new_level.lower().strip()
        if lvl in ("0", "zero", "none", "quiet"):
            lvl = "zero"
        elif lvl in ("1", "low", "minimal", "min"):
            lvl = "low"
        elif lvl in ("2", "normal", "default", "standard"):
            lvl = "normal"
        else:
            print(f"{RED}✗ Invalid verbosity level: '{new_level}'{RESET}")
            print(f"{DIM}Allowed: zero (command only), low (minimal description), normal (standard){RESET}\n")
            return
        cfg["verbosity"] = lvl
        save_config(cfg)
        print(f"\n{GREEN}✓ Verbosity set to: {BOLD}{lvl}{RESET}\n")
        return

    print(f"\n{BOLD}{MAGENTA}◆ Select default verbosity level{RESET}\n")
    print(f"  Current mode: {BOLD}{CYAN}{current}{RESET}\n")
    print(f"  {BOLD}1{RESET}) {BOLD}zero{RESET}   - Command suggestion only (clean output, no extra text)")
    print(f"  {BOLD}2{RESET}) {BOLD}low{RESET}    - Minimal description (1 short sentence + command)")
    print(f"  {BOLD}3{RESET}) {BOLD}normal{RESET} - Standard level (concise explanation + command)\n")

    try:
        ans = input(f"{CYAN}Select mode [1-3 / zero / low / normal] (default: {current}):{RESET} ").strip().lower()
    except (KeyboardInterrupt, EOFError):
        print()
        return

    mapping = {
        "1": "zero", "zero": "zero", "0": "zero",
        "2": "low", "low": "low",
        "3": "normal", "normal": "normal"
    }
    chosen = mapping.get(ans)
    if chosen:
        cfg["verbosity"] = chosen
        save_config(cfg)
        print(f"\n{GREEN}✓ Verbosity saved: {BOLD}{chosen}{RESET}\n")
    elif not ans:
        print(f"\n{DIM}Kept mode: {current}{RESET}\n")
    else:
        print(f"\n{RED}✗ Invalid choice.{RESET}\n")

