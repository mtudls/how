def get_tldr_content(cmd):
    """Reads a local tldr page directly from markdown cache if present."""
    tldr_dirs = (
        os.path.expanduser("~/.cache/tldr/pages"),
        os.path.expanduser("~/.local/share/tldr/pages"),
        "/usr/share/tldr/pages",
    )
    for base in tldr_dirs:
        if not os.path.isdir(base):
            continue
        for platform in ("linux", "common", "osx"):
            target = os.path.join(base, platform, f"{cmd}.md")
            if os.path.isfile(target):
                try:
                    with open(target, "r", encoding="utf-8", errors="ignore") as f:
                        lines = [line for line in f.read().splitlines() if not line.startswith("Found ")]
                        return "\n".join(lines[:35]).strip()
                except Exception:
                    pass
    return None


def get_man_summary(cmd):
    """Retrieves the top lines of a system man page."""
    import subprocess
    try:
        env = os.environ.copy()
        env["MANPAGER"] = "cat"
        env["PAGER"] = "cat"
        proc = subprocess.run(
            ["man", "-P", "cat", cmd],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=1,
            env=env,
        )
        if proc.returncode == 0 and proc.stdout:
            lines = [line.strip() for line in proc.stdout.splitlines() if line.strip()]
            return "\n".join(lines[:25]).strip()
    except Exception:
        pass
    return None


def parse_omarchy_header(file_path):
    """
    Reads (# omarchy:*) documentation headers from an Omarchy script on disk.
    Inspects only the initial comment block (up to 40 lines / 16KB) and rejects binaries.
    """
    try:
        with open(file_path, "rb") as f:
            data = f.read(16384)
        if b"\x00" in data:
            return None
        text = data.decode("utf-8", errors="ignore")
        lines = text.splitlines()[:40]
        summary = None
        args = None
        examples = None
        aliases = None
        for line in lines:
            stripped = line.strip()
            if not stripped.startswith("#"):
                if stripped and not stripped.startswith("#!"):
                    break
                continue
            comment_content = stripped.lstrip("#").strip()
            if comment_content.startswith("omarchy:summary="):
                summary = comment_content.split("=", 1)[1].strip()
            elif comment_content.startswith("omarchy:args="):
                args = comment_content.split("=", 1)[1].strip()
            elif comment_content.startswith("omarchy:examples="):
                examples = comment_content.split("=", 1)[1].strip()
            elif comment_content.startswith("omarchy:aliases="):
                aliases = comment_content.split("=", 1)[1].strip()

        fields = []
        if summary:
            fields.append(f"Summary: {summary}")
        if args:
            fields.append(f"Arguments: {args}")
        if examples:
            fields.append(f"Examples: {examples}")
        if aliases:
            fields.append(f"Aliases: {aliases}")

        if fields:
            return "\n".join(fields)
    except Exception:
        pass
    return None


def build_sandbox_argv(cmd_path, args=None):
    """Builds bubblewrap (bwrap) command-line arguments for isolated execution."""
    home_dir = os.environ.get("HOME") or os.path.expanduser("~")
    argv = [
        "bwrap",
        "--ro-bind", "/", "/",
        "--dev", "/dev",
        "--proc", "/proc",
        "--tmpfs", "/run",
        "--tmpfs", "/tmp",
        "--tmpfs", home_dir,
        "--tmpfs", "/var/tmp",
        "--unshare-all",
        "--new-session",
        "--die-with-parent",
        "--cap-drop", "ALL",
        "--clearenv",
        "--setenv", "PATH", "/usr/local/bin:/usr/bin:/bin",
        "--setenv", "HOME", home_dir,
        "--setenv", "LANG", "C.UTF-8",
        "--chdir", "/tmp",
        "--",
        "timeout", "-k", "1", "2",
        cmd_path,
    ]
    if args:
        argv.extend(args)
    return argv


def run_sandboxed_help(cmd_path):
    """Safely executes `<cmd_path> --help` inside a read-only bubblewrap sandbox."""
    if os.environ.get("HOW_NO_SANDBOX_HELP") == "1":
        return None
    import shutil
    if not shutil.which("bwrap") or not shutil.which("timeout"):
        return None

    import subprocess
    argv = build_sandbox_argv(cmd_path, ["--help"])
    try:
        proc = subprocess.run(
            argv,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=3,
        )
        combined = (proc.stdout or b"") + (b"\n" if proc.stdout and proc.stderr else b"") + (proc.stderr or b"")
        combined = combined[:4096]
        text = combined.decode("utf-8", errors="replace").strip()
        if not text:
            return None
        lines = [line.strip() for line in text.splitlines() if line.strip()]
        if not lines:
            return None
        return "\n".join(lines[:25]).strip()
    except Exception:
        pass
    return None


def get_cli_help(cmd):
    """
    Retrieves CLI documentation in strict safety order:
    1. Static on-disk Omarchy header (never executes omarchy/omarchy-* scripts)
    2. Local tldr page
    3. System man page
    4. Bubblewrap sandboxed `--help`
    """
    import shutil
    cmd_path = shutil.which(cmd)
    if not cmd_path:
        return None

    if cmd == "omarchy" or cmd.startswith("omarchy-"):
        header = parse_omarchy_header(cmd_path)
        if header:
            return f"=== Documentation header for Omarchy command '{cmd}' ===\n{header}"
        return f"=== '{cmd}' exists on this system (Omarchy script, no documentation header) ==="

    t = get_tldr_content(cmd)
    if t:
        return f"=== Official TLDR documentation for '{cmd}' ===\n{t}"

    m = get_man_summary(cmd)
    if m:
        return f"=== System manual (man) for '{cmd}' ===\n{m}"

    h = run_sandboxed_help(cmd_path)
    if h:
        return f"=== CLI help output for '{cmd}' ===\n{h}"

    return None


def extract_candidate_commands(query):
    """Extracts candidate CLI binary names from a natural language query."""
    import re
    tokens = re.findall(r"[a-zA-Z0-9_\-\.]+", query.lower())
    candidates = []
    for t in tokens:
        t_clean = t.strip(".-_")
        if len(t_clean) < 2 or t_clean in COMMON_STOPWORDS:
            continue
        if t_clean not in candidates:
            candidates.append(t_clean)
    return candidates


def docs_fingerprint(query):
    """Computes a fast stat-only fingerprint of candidate commands without spawning subprocesses."""
    import hashlib
    import shutil
    candidates = extract_candidate_commands(query)
    entries = []
    for cmd in candidates:
        cmd_path = shutil.which(cmd)
        if cmd_path:
            try:
                st = os.stat(cmd_path)
                entries.append((cmd, os.path.realpath(cmd_path), st.st_mtime_ns, st.st_size))
            except Exception:
                pass
    return hashlib.sha256(repr(entries).encode("utf-8")).hexdigest()[:16]


def get_system_docs_context(query):
    """Attaches up to 2 local CLI documentation snippets for commands mentioned in query."""
    import shutil
    candidates = extract_candidate_commands(query)
    found_docs = []
    for cmd in candidates:
        if not shutil.which(cmd):
            continue
        doc = get_cli_help(cmd)
        if doc:
            found_docs.append(doc)
            if len(found_docs) >= 2:
                break
    if not found_docs:
        return ""
    return "\n\n" + "\n\n".join(found_docs)


