def check_feedback_safety(message: str) -> tuple[bool, str]:
    """Validates feedback content against payload size limits and prompt-injection patterns."""
    if len(message) > 1000:
        return False, "Feedback message exceeds maximum allowed length (1000 chars)."

    import re
    injection_patterns = [
        r"ignore\s+(previous|all)\s+instructions",
        r"disregard\s+(previous|all)\s+instructions",
        r"system\s*:\s*",
        r"assistant\s*:\s*",
        r"you\s+are\s+now\s+a",
        r"jailbreak",
        r"dan\s+mode",
        r"<\|im_start\|>",
        r"<\|im_end\|>",
        r"\[INST\]",
        r"\[/INST\]",
        r"===\s*system",
        r"base64\s*decode",
        r"eval\s*\(",
        r"exec\s*\(",
        r"DROP\s+TABLE",
        r"--\s*$",
        r"union\s+select",
        r"<script",
        r"javascript:",
    ]
    for pat in injection_patterns:
        if re.search(pat, message, re.IGNORECASE):
            return False, "Potentially unsafe pattern or prompt-injection attempt detected."

    return True, ""


def send_terminal_feedback(message="", auto_yes=False):
    """Submits lightweight feedback from the terminal with rate-limiting, safety checks, and consent."""
    import json
    import time

    if not message:
        print(f"\n{BOLD}{MAGENTA}◆ Quick Terminal Feedback{RESET}")
        print(f"{DIM}Share a quick thought, broken command, or suggestion directly from terminal.{RESET}\n")
        try:
            message = input(f"{CYAN}Feedback:{RESET} ").strip()
        except (KeyboardInterrupt, EOFError):
            print()
            return
        if not message:
            print(f"{DIM}Feedback cancelled.{RESET}")
            return

    cfg = load_config()
    last_sent = cfg.get("last_feedback_time", 0)
    now = time.time()
    if now - last_sent < 10:
        print(f"\n{YELLOW}! Please wait {int(10 - (now - last_sent))}s before sending another feedback.{RESET}\n")
        return

    is_safe, reason = check_feedback_safety(message)
    if not is_safe:
        print(f"\n{YELLOW}Sorry, this feedback could not be accepted automatically ({reason}).{RESET}")
        print(f"{BOLD}Please share your feedback or problem directly via X (Twitter) with {CYAN}@mtulds{RESET}.\n")
        return

    repo_target = "mdsyseng/how"
    issue_title = f"Quick Feedback: {message[:60]}"
    print(f"\n{BOLD}{MAGENTA}◆ Feedback Preview{RESET}")
    print(f"  Target: {CYAN}{repo_target}{RESET}")
    print(f"  Title:  {BOLD}{issue_title}{RESET}")
    print(f"  Body:   {DIM}{message}{RESET}\n")

    if not auto_yes:
        if not sys.stdin.isatty() or os.environ.get("HOW_NO_BROWSER") == "1":
            print(f"{YELLOW}! Non-interactive shell detected. Feedback not sent.{RESET}")
            print(f'{DIM}To send non-interactively, run:{RESET} {CYAN}how feedback --yes "{message}"{RESET}\n')
            return
        try:
            ans = input(f"{CYAN}Send this issue? [y/N]:{RESET} ").strip().lower()
            if ans not in ("y", "yes"):
                print(f"{DIM}Feedback cancelled.{RESET}\n")
                return
        except (KeyboardInterrupt, EOFError):
            print(f"\n{DIM}Feedback cancelled.{RESET}\n")
            return

    cfg["last_feedback_time"] = now
    save_config(cfg)

    webhook_url = os.environ.get("HOW_FEEDBACK_WEBHOOK") or cfg.get("feedback_webhook")
    if webhook_url:
        import urllib.request
        payload = json.dumps({
            "feedback": message,
            "timestamp": now,
            "version": __version__,
            "os": sys.platform,
        }).encode("utf-8")
        req = urllib.request.Request(
            webhook_url,
            data=payload,
            headers={**COMMON_HEADERS, "Content-Type": "application/json"},
        )
        print(f"{DIM}Sending feedback...{RESET} ", end="", flush=True)
        try:
            with urllib.request.urlopen(req, timeout=4) as resp:
                if resp.status in (200, 201, 204):
                    print(f"{GREEN}✓ Sent! Thank you.{RESET}\n")
                    return
        except Exception:
            print(f"{YELLOW}(webhook unavailable){RESET}")

    import subprocess
    try:
        proc = subprocess.run(
            ["gh", "issue", "create", "--repo", repo_target, "--title", issue_title, "--body", message, "--label", "feedback"],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=5,
        )
        if proc.returncode == 0:
            issue_url = proc.stdout.strip()
            print(f"{GREEN}✓ Issue created directly from terminal:{RESET} {issue_url}\n")
            return
    except Exception:
        pass

    open_feedback_url(message)


