# ----------------------------------------------------------------------------- terminal

STYLES = {"bold": "1", "dim": "2", "red": "31", "green": "32", "yellow": "33", "cyan": "36"}


def paint(text: str, *styles: str, stream=None) -> str:
    stream = stream or sys.stdout
    if os.environ.get("NO_COLOR") or os.environ.get("TERM") == "dumb" or not stream.isatty():
        return text
    codes = ";".join(STYLES[s] for s in styles)
    return f"\033[{codes}m{text}\033[0m"


def err(message: str) -> None:
    print(message, file=sys.stderr)


def debug(message: str) -> None:
    if DEBUG:
        err(paint(f"how[debug] {message}", "dim", stream=sys.stderr))


def interactive() -> bool:
    return sys.stdin.isatty() and sys.stdout.isatty()


@contextlib.contextmanager
def spinner(label: str):
    """A small spinner on stderr while waiting for the network; silent when stderr is not a terminal."""
    if not sys.stderr.isatty():
        yield
        return
    stop = threading.Event()

    def spin():
        for frame in itertools.cycle("⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"):
            sys.stderr.write(f"\r{paint(frame + ' ' + label, 'dim', stream=sys.stderr)}")
            sys.stderr.flush()
            if stop.wait(0.08):
                break
        sys.stderr.write("\r\033[K")
        sys.stderr.flush()

    thread = threading.Thread(target=spin, daemon=True)
    thread.start()
    try:
        yield
    finally:
        stop.set()
        thread.join()


def read_key(prompt: str) -> str:
    """Reads one keypress (no Enter needed). Falls back to a line of input when raw mode is unavailable.

    Returns "\\n" for Enter, "" for end of input, otherwise the lower-cased character.
    Ctrl-C still raises KeyboardInterrupt because cbreak mode keeps signals on.
    """
    sys.stdout.write(prompt)
    sys.stdout.flush()
    try:
        import termios
        import tty
        fd = sys.stdin.fileno()
        saved = termios.tcgetattr(fd)
    except (ImportError, OSError, ValueError):
        line = sys.stdin.readline()
        return (line.strip()[:1].lower() or "\n") if line else ""
    try:
        tty.setcbreak(fd, termios.TCSANOW)  # TCSANOW: keep keys typed before the prompt appeared
        data = os.read(fd, 8)
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, saved)
    sys.stdout.write("\n")
    if not data or data == b"\x04":
        return ""
    char = data[:1].decode("utf-8", "replace").lower()
    return "\n" if char in "\r\n" else char


def ask_line(prompt: str) -> str:
    """Reads a line; end of input counts as an empty answer."""
    try:
        return input(prompt).strip()
    except EOFError:
        print()
        return ""


def confirm(prompt: str) -> bool:
    return ask_line(f"{prompt} [y/N] ").lower() in ("y", "yes")


def copy_to_clipboard(text: str) -> bool:
    tool = clipboard_tool()
    if not tool:
        return False
    try:
        return subprocess.run(tool, input=text.encode(), capture_output=True, timeout=3).returncode == 0
    except (OSError, subprocess.SubprocessError) as e:
        debug(f"clipboard failed: {e}")
        return False


def clipboard_tool() -> Optional[list[str]]:
    for cmd in (["wl-copy"], ["xclip", "-selection", "clipboard"], ["xsel", "--clipboard", "--input"]):
        if shutil.which(cmd[0]):
            return cmd
    return None


