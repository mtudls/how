# `how good is my wifi` is a question; `how good` / `how bad wrong flag` are ratings.
QUESTION_WORDS = {"is", "are", "was", "were", "does", "do", "did", "to", "at", "for", "in", "way", "ways",
                  "practice", "practices", "idea", "ideas", "can", "should", "would"}


def cmd_rate(rating: str, note: str) -> int:
    """Logs the rating locally. Sharing it is a separate, explicit step: we show the exact issue text,
    and only after `y` open a pre-filled GitHub issue that you still submit yourself."""
    last = load_last()
    log_event("rate", question=last["question"], command=last.get("command"), action=rating)
    title = f"{'👍' if rating == 'good' else '👎'} how {last['question']}"[:80]
    body = (f"Asked: how {last['question']}\nAnswer: {last.get('command') or last.get('note') or ''}\n"
            + (f"Note: {note}\n" if note else "") + f"Version: how {__version__}")
    url = f"https://github.com/{REPO}/issues/new?" + urllib.parse.urlencode({"title": title, "body": body})
    print(f"Thanks, noted in your local log ({'👍' if rating == 'good' else '👎'}).")
    print(paint(f"\nTo share it, this exact text would become a public issue on github.com/{REPO}:\n", "dim"))
    print("  " + title)
    print("\n".join("  " + line for line in body.splitlines()))
    if not interactive():
        print(f"\nOpen this link to submit it yourself:\n{url}")
        return 0
    if confirm("\nOpen it in your browser to review and submit?"):
        open_url(url)
    return 0


def open_url(url: str) -> None:
    opener = shutil.which("xdg-open") or shutil.which("open")
    if opener:
        try:
            subprocess.Popen([opener, url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)  # nosec B603
            return
        except OSError as e:
            debug(f"{opener} failed: {e}")
    print(url)


def cmd_key() -> int:
    print(f"Get a free key at {paint(KEYS_URL, 'cyan')}")
    if sys.stdin.isatty():
        key = getpass.getpass("Paste key (input hidden): ").strip()
    else:
        key = sys.stdin.readline().strip()
    if not key or not key.isprintable() or any(c.isspace() for c in key):
        raise HowError("bad_input", "that does not look like a key; nothing saved", "run: how key")
    config = read_json(config_file())
    config["api_key"] = key
    try:
        write_private(config_file(), json.dumps(config, indent=2))
    except OSError as e:
        raise HowError("config_write", f"cannot write {config_file()}: {e.strerror}",
                       "check the directory permissions, or set GROQ_API_KEY instead") from None
    log_event("key", action="saved")
    print(paint("✓ saved", "green") + paint(f" {masked(key)} to {config_file()} (0600). Try: how to check disk space", "dim"))
    return 0


def cmd_log(args: list[str]) -> int:
    if args == ["--path"]:
        print(log_file())
        return 0
    count = int(args[0]) if args else 20
    try:
        lines = log_file().read_text(encoding="utf-8").splitlines()[-count:] if count > 0 else []
    except FileNotFoundError:
        lines = []
    if not lines:
        print(paint(f"log is empty ({log_file()})", "dim"))
    for line in lines:
        print(format_log_line(line))
    return 0


def format_log_line(line: str) -> str:
    try:
        e = json.loads(line)
    except ValueError:
        return line
    when = str(e.get("ts", ""))[:19].replace("T", " ")
    icon = BADGES[e["safety"]][0] if e.get("safety") in BADGES else " "
    what = e.get("command") or e.get("question") or ""
    tail = " ".join(str(x) for x in (e.get("action"), f"exit {e['exit_code']}" if e.get("exit_code") else None) if x)
    return f"{paint(when, 'dim')}  {e.get('event', '?'):<6} {icon} {what}" + (paint(f"  [{tail}]", "dim") if tail else "")


