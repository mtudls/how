def split_shell_pipeline(command: str) -> list[tuple[str, str]]:
    """
    Splits a shell command string into [(stage_cmd, operator_after), ...]
    respecting single/double quotes and subshell $(...) nesting.
    """
    stages = []
    buf = []
    in_single = False
    in_double = False
    paren_depth = 0
    i = 0
    n = len(command)

    while i < n:
        ch = command[i]
        if ch == "\\" and not in_single and i + 1 < n:
            buf.append(ch)
            buf.append(command[i + 1])
            i += 2
            continue
        if ch == "'" and not in_double:
            in_single = not in_single
            buf.append(ch)
            i += 1
            continue
        if ch == '"' and not in_single:
            in_double = not in_double
            buf.append(ch)
            i += 1
            continue
        if not in_single and not in_double:
            if ch == "(":
                paren_depth += 1
            elif ch == ")" and paren_depth > 0:
                paren_depth -= 1
            elif paren_depth == 0:
                if command[i : i + 2] in ("&&", "||"):
                    op = command[i : i + 2]
                    seg = "".join(buf).strip()
                    if seg:
                        stages.append((seg, op))
                    buf = []
                    i += 2
                    continue
                if ch in ("|", ";"):
                    seg = "".join(buf).strip()
                    if seg:
                        stages.append((seg, ch))
                    buf = []
                    i += 1
                    continue
        buf.append(ch)
        i += 1

    tail = "".join(buf).strip()
    if tail:
        stages.append((tail, ""))
    return stages


def explain_command_anatomy(command: str) -> dict:
    """
    Builds a complete offline <1ms breakdown of a command:
    - safety classification (level, badge, reason)
    - pipeline/chain stages with operator semantics and per-token/flag explanations
    """
    import shlex
    cmd = (command or "").strip()
    safety = classify_command_safety(cmd)
    raw_stages = split_shell_pipeline(cmd)

    op_descriptions = {
        "|": "pipes stdout into next stage's stdin",
        "&&": "runs next stage only if this stage succeeds (exit 0)",
        "||": "runs next stage only if this stage fails (non-zero exit)",
        ";": "runs next stage sequentially regardless of exit status",
    }

    parsed_stages = []
    for stage_str, op_after in raw_stages:
        try:
            tokens = shlex.split(stage_str)
        except Exception:
            tokens = stage_str.split()

        if not tokens:
            continue

        idx = 0
        elevated = False
        if tokens[0] in ("sudo", "pkexec", "doas") and len(tokens) > 1:
            elevated = True
            idx = 1

        binary = tokens[idx] if idx < len(tokens) else tokens[0]
        base_bin = os.path.basename(binary)
        purpose = COMMAND_PURPOSE_DB.get(base_bin, f"execute '{base_bin}' command")
        if elevated:
            purpose = f"[sudo: elevated root privileges] {purpose}"

        token_notes = []
        j = idx + 1
        while j < len(tokens):
            tok = tokens[j]
            if tok in FLAG_PURPOSE_DB:
                note = FLAG_PURPOSE_DB[tok]
                # Contextual disambiguation for common overloaded flags
                if base_bin == "sort" and tok == "-r":
                    note = "reverse sort order (highest/largest first)"
                elif base_bin in ("pacman", "yay") and tok == "-R":
                    note = "remove installed package"
                elif base_bin == "ln" and tok == "-s":
                    note = "create symbolic (soft) link instead of hard link"
                elif base_bin == "du" and tok == "-s":
                    note = "display only a total summary for each argument"
                if tok in ("-type", "-name", "-iname", "-mtime", "-size") and j + 1 < len(tokens):
                    arg_val = tokens[j + 1]
                    token_notes.append((f"{tok} {arg_val}", note))
                    j += 2
                    continue
                token_notes.append((tok, note))
            elif tok.startswith("-") and len(tok) > 2 and not tok.startswith("--"):
                # Combined short flags (e.g. -la, -rf)
                sub_meanings = []
                for ch in tok[1:]:
                    f_key = f"-{ch}"
                    if f_key in FLAG_PURPOSE_DB:
                        sub_meanings.append(f"-{ch}: {FLAG_PURPOSE_DB[f_key]}")
                if sub_meanings:
                    token_notes.append((tok, "; ".join(sub_meanings)))
                else:
                    token_notes.append((tok, "option flag"))
            elif tok.startswith("-"):
                token_notes.append((tok, "option flag"))
            elif j == idx + 1 and base_bin in ("git", "gh", "docker", "systemctl", "omarchy", "nmcli", "ip", "wpctl", "hyprctl", "xdg-settings"):
                token_notes.append((tok, f"'{base_bin}' subcommand"))
            else:
                token_notes.append((tok, "target argument / parameter"))
            j += 1

        parsed_stages.append({
            "raw": stage_str,
            "binary": base_bin,
            "elevated": elevated,
            "purpose": purpose,
            "tokens": token_notes,
            "operator_after": op_after,
            "operator_meaning": op_descriptions.get(op_after, ""),
        })

    return {
        "command": cmd,
        "safety": safety,
        "stages": parsed_stages,
    }


def get_last_suggested_command() -> tuple[str, str]:
    """Returns (last_command, last_query) from ~/.config/how/commands.log, or ('', '') if none."""
    if not os.path.exists(COMMANDS_LOG):
        return "", ""
    try:
        with open(COMMANDS_LOG, "r", encoding="utf-8") as f:
            lines = [line.strip() for line in f if line.strip()]
        for line in reversed(lines):
            if " | Command: " in line:
                parts = line.split(" | Command: ", 1)
                last_cmd = parts[1].strip()
                last_query = ""
                if 'Query: "' in parts[0]:
                    last_query = parts[0].split('Query: "', 1)[1].rsplit('"', 1)[0]
                elif 'Pytanie: "' in parts[0]:
                    last_query = parts[0].split('Pytanie: "', 1)[1].rsplit('"', 1)[0]
                if last_cmd:
                    return last_cmd, last_query
    except Exception:
        pass
    return "", ""


