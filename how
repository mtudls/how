def strip_control_sequences(text: str) -> str:
    """
    Strips ANSI / terminal control escape sequences and C0 control characters
    from text, preserving newlines (\\n) and tabs (\\t).
    """
    if not text:
        return ""
    import re
    text = re.sub(r"\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)", "", text)
    text = re.sub(r"\x1b\[[0-9:;<=>?]*[ -/]*[@-~]", "", text)
    text = re.sub(r"\x1b[@-Z\\-_]", "", text)
    text = text.replace("\x1b", "")
    text = re.sub(r"[\x00-\x08\x0b-\x1f\x7f]", "", text)
    return text


def strip_think_blocks(text: str) -> str:
    """Removes internal chain-of-thought <think>...</think> blocks emitted by reasoning models."""
    if not text or "<think>" not in text:
        return text
    import re
    cleaned = re.sub(r"<think>.*?</think>", "", text, flags=re.DOTALL).strip()
    if "<think>" in cleaned:
        cleaned = cleaned.split("</think>")[-1].strip()
    return cleaned or text.strip()


def is_uncertain_response(text: str) -> bool:
    """Returns True if the model response is empty or indicates 'I don't know' / uncertainty."""
    if not text:
        return True
    cleaned = strip_think_blocks(strip_control_sequences(text)).strip()
    if not cleaned:
        return True
    low = cleaned.lower().rstrip(".!?:;\"'")
    if low in ("i don't know", "i dont know", "idk", "not sure", "i am not sure", "i'm not sure"):
        return True
    if "```" not in cleaned and (low.startswith("i don't know") or low.startswith("i dont know")):
        return True
    return False


