def get_system_prompt(verbosity="normal"):
    """Zwraca dedykowany prompt systemowy w zależności od trybu verbosity (zero, low, normal)."""
    base = """You are an ultra-fast, direct CLI 'how-to' assistant for Omarchy (an opinionated developer Linux distribution built on Arch Linux and Hyprland by DHH/Omacom).
Take advantage of Omarchy-specific conventions: 'omarchy' CLI, 'yay' / 'pacman', Hyprland configs (~/.config/hypr, 'hyprctl'), Quickshell, systemctl, and standard modern developer tools (e.g. GitHub CLI 'gh auth switch' to switch accounts without logging out).
Answer in the same language as the question (if asked in Polish, answer in Polish; if asked in English, answer in English).

CRITICAL RULE ON UNCERTAINTY:
If you are not confident or not sure about the answer, command, or how to accomplish the task, do NOT invent or guess. You MUST answer strictly with: "nie wiem" (or "nie wiem" if asked in Polish, "I don't know" if in English)."""

    if verbosity == "zero":
        return base + """

Response Rules (STRICT ZERO VERBOSITY):
1. Provide ONLY the exact executable bash/terminal command inside a single ```bash code block.
2. Absolutely NO explanatory sentences, comments, headers, or concluding remarks. Only the code block.
3. If the user's question is purely conceptual or not an actionable command, answer in 1 very short direct sentence without extra text.
4. If not sure: output only "nie wiem"."""

    elif verbosity == "low":
        return base + """

Response Rules (LOW VERBOSITY):
1. Provide the exact executable bash/terminal command FIRST in a ```bash code block if the question is an actionable task.
2. Provide a single ultra-short sentence (maximum 10 words) right after the code block stating what it does.
3. If the user's question is purely conceptual, answer in 1 concise sentence.
4. If not sure: answer "nie wiem"."""

    else:  # normal
        return base + """

Response Rules (NORMAL VERBOSITY):
1. Provide the exact executable bash/terminal command(s) FIRST in a ```bash code block if the question is an actionable task.
2. Provide a 1-2 sentence concise explanation right after the code block.
3. If the user's question is purely conceptual, explanatory, or general (not an actionable command request), do not output a bash code block; answer directly and concisely.
4. Be direct and avoid fluff (no 'Sure!', no 'Here is how to do it').
5. If not sure: answer "nie wiem"."""

def open_url_in_browser(url):
    """Automatycznie otwiera przeglądarkę użytkownika w tle."""
    import subprocess
    try:
        subprocess.Popen(["xdg-open", url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return True
    except Exception:
        pass
    try:
        import webbrowser
        webbrowser.open(url)
        return True
    except Exception:
        return False

def load_config():
    if os.path.exists(CONFIG_FILE):
        try:
            with open(CONFIG_FILE, "r") as f:
                return json.load(f)
        except Exception:
            return {}
    return {}

def save_config(data):
    try:
        os.makedirs(CONFIG_DIR, exist_ok=True)
        with open(CONFIG_FILE, "w") as f:
            json.dump(data, f, indent=2)
        try:
            os.chmod(CONFIG_FILE, 0o600)
        except Exception:
            pass
    except Exception as e:
        print(f"{YELLOW}! Nie można zapisać konfiguracji do {CONFIG_FILE}: {e}{RESET}")

def get_api_key():
    """Zwraca klucz API ze zmiennej środowiskowej GROQ_API_KEY lub z config.json."""
    env_k = os.environ.get("GROQ_API_KEY", "").strip()
    if env_k:
        return env_k
    cfg = load_config()
    return cfg.get("api_key", "").strip() or None

def fetch_available_models(api_key):
    """Pobiera listę aktywnych modeli czatowych bezpośrednio z API Groq."""
    import urllib.request
    import urllib.error
    headers = {
        **COMMON_HEADERS,
        "Authorization": f"Bearer {api_key}"
    }
    req = urllib.request.Request(GROQ_MODELS_URL, headers=headers)
    try:
        with urllib.request.urlopen(req, timeout=10) as res:
            if res.status == 200:
                data = json.loads(res.read().decode("utf-8"))
                models = data.get("data", [])
                
                # Filtrujemy modele nie-tekstowe (np. whisper, guard rails)
                exclude_keywords = ["whisper", "guard", "safeguard", "orpheus-arabic"]
                chat_models = []
                for m in models:
                    mid = m.get("id", "")
                    if not any(k in mid.lower() for k in exclude_keywords):
                        chat_models.append(mid)
                
                # Sortowanie: 120b na początku, potem alfabetycznie
                chat_models.sort(key=lambda x: (0 if "120b" in x else 1, x))
                return chat_models, None
    except urllib.error.HTTPError as e:
        return [], f"Błąd {e.code}: {e.reason}"
    except Exception as e:
        return [], str(e)
    return [], "Nieznany błąd"

