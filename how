    cfg["cache_retention_seconds"] = sec
    cfg["cache_retention"] = str(val).strip()
    save_config(cfg)

    formatted = format_retention(sec)
    if sec == 0:
        print(f"\n{YELLOW}✓ Response cache has been disabled (retention: 0s).{RESET}\n")
    else:
        print(f"\n{GREEN}✓ Cache retention updated to:{RESET} {BOLD}{CYAN}{formatted}{RESET} {DIM}({sec}s){RESET}\n")

