        print(f"    {YELLOW}[dry-run]{RESET} {CYAN}$ {step['dry_run']}{RESET}")
        print(f"    {DIM}inspects: {step['target']}{RESET}")
    print()


def detect_os_profile(allowed_steps=None) -> dict:
    """
    Discovers OS name, version, kernel, desktop/WM, shell, and package managers
    using fast, read-only local checks without spawning subprocesses.
    Respects per-step permissions in `allowed_steps` if provided and records `sources_read`.
    """
    import shutil
    profile = {
        "os_name": sys.platform,
        "os_version": "",
        "omarchy": False,
        "kernel": "",
        "desktop": "",
        "shell": "",
        "pkg_managers": [],
        "sources_read": [],
    }

    def step_ok(step_id: str) -> bool:
        if allowed_steps is None:
            return True
        return bool(allowed_steps.get(step_id, True))

    if step_ok("os_release"):
        os_release_paths = ("/etc/os-release", "/usr/lib/os-release")
        for p in os_release_paths:
            if os.path.isfile(p):
                try:
                    with open(p, "r", encoding="utf-8", errors="ignore") as f:
                        data = {}
                        for line in f:
                            line = line.strip()
                            if "=" in line and not line.startswith("#"):
                                k, v = line.split("=", 1)
                                data[k] = v.strip().strip('"').strip("'")
                        profile["os_name"] = data.get("PRETTY_NAME") or data.get("NAME") or profile["os_name"]
                        profile["os_version"] = data.get("VERSION_ID") or data.get("BUILD_ID") or ""
                    profile["sources_read"].append(p)
                    break
                except Exception:
                    pass

        if shutil.which("omarchy") or os.path.isdir("/usr/share/omarchy"):
            profile["omarchy"] = True
            profile["sources_read"].append("/usr/share/omarchy")

    if step_ok("kernel"):
        try:
            u = os.uname()
            profile["kernel"] = u.release
            profile["sources_read"].append("uname")
        except Exception:
            pass

    if step_ok("desktop"):
        desktop_parts = []
        xdg_desktop = os.environ.get("XDG_CURRENT_DESKTOP") or os.environ.get("DESKTOP_SESSION") or ""
        if xdg_desktop:
            desktop_parts.append(xdg_desktop)
        elif os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
            desktop_parts.append("Hyprland")
        session_type = os.environ.get("XDG_SESSION_TYPE") or ("wayland" if os.environ.get("WAYLAND_DISPLAY") else "")
        if session_type and session_type.lower() not in " ".join(desktop_parts).lower():
            desktop_parts.append(session_type)
        profile["desktop"] = " / ".join(desktop_parts)
        if profile["desktop"]:
            profile["sources_read"].append("env:XDG_DESKTOP")

    if step_ok("shell_pkg"):
        shell_env = os.environ.get("SHELL") or ""
        if shell_env:
            profile["shell"] = os.path.basename(shell_env)
            profile["sources_read"].append("env:SHELL")

        pkgs = []
        for pm in ("pacman", "yay", "paru", "apt", "dnf", "apk", "zypper", "brew", "nix"):
            if shutil.which(pm):
                pkgs.append(pm)
        profile["pkg_managers"] = pkgs
        if pkgs:
            profile["sources_read"].append(f"PATH:{','.join(pkgs)}")

    parts = []
    if step_ok("os_release"):
        os_label = profile["os_name"]
        if profile["os_version"] and profile["os_version"] not in os_label:
            os_label += f" {profile['os_version']}"
        if profile["omarchy"] and "omarchy" not in os_label.lower():
            os_label += " (Omarchy)"
        parts.append(f"OS: {os_label}")
    if profile["kernel"]:
        parts.append(f"Kernel: {profile['kernel']}")
    if profile["desktop"]:
        parts.append(f"Desktop: {profile['desktop']}")
    if profile["shell"]:
        parts.append(f"Shell: {profile['shell']}")
    if profile["pkg_managers"]:
        parts.append(f"Pkg: {', '.join(profile['pkg_managers'])}")

    profile["summary"] = " | ".join(parts)
    return profile


def detect_local_stack(cwd=None) -> dict:
    """
    Detects the software stack and tools used in the given directory (default: os.getcwd()).
    Inspects only safe project manifest filenames and lightweight metadata (never .env or secrets).
    Records exact manifest filenames inspected in `files_read`.
    """
    import json
    target_dir = os.path.abspath(cwd or os.getcwd())
    try:
        entries = set(os.listdir(target_dir))
    except Exception:
        return {"dir": os.path.basename(target_dir), "tools": [], "details": [], "files_read": [], "summary": ""}

    tools = []
    details = []
    files_read = []

    def mark_file(*names):
        for n in names:
            if n in entries and n not in files_read:
                files_read.append(n)

    def match_first(group):
        for files, label in group:
            if any(f in entries for f in files):
                tools.append(label)
                mark_file(*files)
                return

    match_first((
        (("uv.lock",), "Python (uv)"),
        (("poetry.lock",), "Python (poetry)"),
        (("Pipfile",), "Python (pipenv)"),
        (("pyproject.toml", "requirements.txt", "setup.py"), "Python"),
    ))
    match_first((
        (("bun.lockb", "bun.lock"), "Bun"),
        (("pnpm-lock.yaml",), "Node.js (pnpm)"),
        (("yarn.lock",), "Node.js (yarn)"),
        (("package-lock.json",), "Node.js (npm)"),
        (("package.json",), "Node.js"),
    ))

    for files, label in (
        (("deno.json", "deno.jsonc"), "Deno"),
        (("Cargo.toml",), "Rust (cargo)"),
        (("go.mod",), "Go (go)"),
        (("mix.exs",), "Elixir (mix)"),
        (("build.zig",), "Zig"),
        (("CMakeLists.txt",), "CMake"),
        (("flake.nix", "shell.nix"), "Nix"),
        (("PKGBUILD",), "Arch PKGBUILD (makepkg)"),
    ):
        if any(f in entries for f in files):
            tools.append(label)
            mark_file(*files)

    if "Gemfile" in entries:
        mark_file("Gemfile")
        tools.append("Ruby on Rails (bundle exec rails)" if os.path.exists(os.path.join(target_dir, "bin", "rails")) else "Ruby (bundler)")

    match_first((
        (("compose.yaml", "compose.yml", "docker-compose.yml", "docker-compose.yaml"), "Docker Compose"),
        (("Dockerfile", "Containerfile"), "Docker"),
    ))

    for files, label in (
        (("manage.py",), "Django"),
        ((".ruff.toml", "ruff.toml"), "ruff"),
        (("pytest.ini", "conftest.py"), "pytest"),
        (("tsconfig.json",), "TypeScript"),
        (("justfile", "Justfile"), "just"),
        (("Makefile", "makefile"), "make"),
        (("Taskfile.yml", "Taskfile.yaml"), "task"),
    ):
        if any(f in entries for f in files):
            details.append(label)
            mark_file(*files)

    if "package.json" in entries:
        pkg_path = os.path.join(target_dir, "package.json")
        try:
            if os.path.getsize(pkg_path) <= 65536:
                with open(pkg_path, "r", encoding="utf-8", errors="ignore") as f:
                    pkg = json.load(f)
                mark_file("package.json")
                deps = {**(pkg.get("dependencies") or {}), **(pkg.get("devDependencies") or {})}
                for fw, label in (
                    ("next", "Next.js"), ("vite", "Vite"), ("astro", "Astro"),
                    ("svelte", "Svelte"), ("react", "React"), ("vue", "Vue"), ("tailwindcss", "Tailwind"),
                ):
                    if fw in deps and label not in details:
                        details.append(label)
                scripts = list((pkg.get("scripts") or {}).keys())[:6]
                if scripts:
                    details.append(f"scripts: {','.join(scripts)}")
        except Exception:
            pass

    if ".git" in entries or os.path.isdir(os.path.join(target_dir, ".git")):
        details.append("git")
        mark_file(".git")
    if "manifest.json" in entries:
        mark_file("manifest.json")
        if "qml" in entries:
            details.append("Omarchy QML Plugin")

    dir_name = os.path.basename(target_dir) or target_dir
    if not tools and not details:
        return {"dir": dir_name, "tools": [], "details": [], "files_read": files_read, "summary": ""}

    summary_items = tools + [d for d in details if d not in tools]
    return {
        "dir": dir_name,
        "tools": tools,
        "details": details,
        "files_read": files_read,
        "summary": f"Project ({dir_name}): {', '.join(summary_items)}",
    }


def format_context_read_receipt(os_prof=None, stack_info=None, docs_read=None) -> str:
    """
    Formats a concise, transparent 1-line summary of what local files/sources were read
    (used automatically in `yolo` mode and step-by-step `careful` mode).
    """
    items = []
    if isinstance(os_prof, dict):
        srcs = os_prof.get("sources_read") or []
        if srcs:
            os_short = os_prof.get("os_name", "OS")
            items.append(f"OS[{', '.join(srcs)} → {os_short}]")
        elif os_prof.get("summary"):
            items.append(f"OS[{os_prof.get('os_name', 'cached')}]")
    if isinstance(stack_info, dict):
        f_read = stack_info.get("files_read") or []
        d_name = stack_info.get("dir") or "."
        if f_read:
            items.append(f"Stack[{d_name}: {', '.join(f_read)}]")
        elif stack_info.get("summary"):
            items.append(f"Stack[{d_name}]")
    if docs_read:
        items.append(f"Docs[{', '.join(docs_read)}]")
    if not items:
        return "none (no local files read)"
    return " • ".join(items)


def run_step_by_step_context_approval(cfg=None, cwd=None, dry_run_only=False, input_fn=None) -> dict:
    """
    Graduated, user-approved step-by-step context discovery (default `careful` mode).
    Displays the exact `[dry-run]` command for each step before reading anything.
    Supports answers per step:
      - y / Enter : approve and run this step now (prints what was read)
      - n         : skip/deny this step
      - yolo / a  : switch to YOLO mode (auto-run all remaining steps and report what was read)
      - dry / d   : print dry-run commands for remaining steps without reading
      - off / q   : disable all context discovery
    """
    if cfg is None:
        cfg = load_config()
    if input_fn is None:
        input_fn = input

    steps = get_context_dry_run_steps(cwd=cwd)
    if dry_run_only:
        print_context_dry_run_plan(cwd=cwd)
        return cfg

    print(f"\n{BOLD}{MAGENTA}◆ Graduated Context Discovery — Step-by-Step Approval (careful mode){RESET}")
    print(f"{DIM}Approve each read-only check step-by-step, or type '{CYAN}yolo{RESET}{DIM}' to auto-read all & show what was read.{RESET}\n")

    approved_steps = dict(cfg.get("context_steps") or {})
    mode = "careful"
    yolo_activated = False

    for idx, step in enumerate(steps, 1):
        sid = step["id"]
        print(f"  {BOLD}[Step {idx}/{len(steps)}] {step['title']}{RESET}")
        print(f"    {YELLOW}[dry-run]{RESET} {CYAN}$ {step['dry_run']}{RESET}")

        if not yolo_activated:
            try:
                ans = input_fn(
                    f"    {CYAN}Approve step {idx}/{len(steps)}? [Y/n/yolo/dry/off]:{RESET} "
                ).strip().lower()
            except (KeyboardInterrupt, EOFError):
                print()
                ans = "off"
        else:
            ans = "y"

        if ans in ("off", "q", "quit", "0"):
            for rem in steps[idx - 1 :]:
                approved_steps[rem["id"]] = False
            mode = "off"
            print(f"    {YELLOW}✗ Context discovery disabled.{RESET}\n")
            break

        if ans in ("dry", "d", "dry-run"):
            approved_steps[sid] = False
            print(f"    {DIM}(dry-run only — skipped reading {step['target']}){RESET}\n")
            continue

        if ans in ("yolo", "a", "all"):
            yolo_activated = True
            mode = "yolo"
            ans = "y"
            print(f"    {MAGENTA}⚡ YOLO mode enabled — auto-running remaining steps and reporting what was read:{RESET}")

        if ans in ("", "y", "yes", "1"):
            approved_steps[sid] = True
            # Immediately execute just this step to show the user what was read
            if step["category"] == "os":
                single_mask = {k["id"]: (k["id"] == sid) for k in CONTEXT_DISCOVERY_STEPS if k["category"] == "os"}
                part_prof = detect_os_profile(allowed_steps=single_mask)
                srcs = ", ".join(part_prof.get("sources_read") or [step["target"]])
                val = part_prof.get("summary") or "checked"
                print(f"    {GREEN}✓ Read{RESET} {DIM}[{srcs}]{RESET} → {val}\n")
            elif step["category"] == "stack":
                st_info = detect_local_stack(cwd=cwd)
                f_read = ", ".join(st_info.get("files_read") or ["directory listing"])
                val = st_info.get("summary") or "no stack manifests in current directory"
                print(f"    {GREEN}✓ Read{RESET} {DIM}[{f_read}]{RESET} → {val}\n")
        else:
            approved_steps[sid] = False
            print(f"    {DIM}✗ Skipped {step['title']}.{RESET}\n")

    os_step_ids = [s["id"] for s in CONTEXT_DISCOVERY_STEPS if s["category"] == "os"]
    allow_os = any(approved_steps.get(k, False) for k in os_step_ids)
    allow_stack = bool(approved_steps.get("stack", False))

    cfg["context_mode"] = mode if (allow_os or allow_stack) else "off"
    cfg["context_steps"] = approved_steps
    cfg["discover_os"] = allow_os
    cfg["discover_stack"] = allow_stack
    cfg["context_prompted"] = True
    if allow_os:
        cfg["os_profile"] = detect_os_profile(allowed_steps=approved_steps)
    save_config(cfg)

    print(
        f"  {GREEN}✓ Saved context settings{RESET} "
        f"(mode: {BOLD}{cfg['context_mode']}{RESET}, OS: {GREEN if allow_os else DIM}{'on' if allow_os else 'off'}{RESET}, "
        f"Stack: {GREEN if allow_stack else DIM}{'on' if allow_stack else 'off'}{RESET} — manage via `{CYAN}how context{RESET}`).\n"
    )
    return cfg


def ensure_context_permissions(cfg=None, interactive_allowed=True, context_mode_override=None) -> dict:
    """
    Ensures user permission settings for OS/version discovery and local stack discovery exist.
    Defaults to graduated `careful` step-by-step approval on first interactive run,
    or `yolo` auto-discovery when requested via `--yolo` / `HOW_CONTEXT=yolo`.
    """
    if cfg is None:
        cfg = load_config()

    env_ctx = (context_mode_override or os.environ.get("HOW_CONTEXT", "")).strip().lower()
    if env_ctx in ("0", "off", "false", "none", "no"):
        cfg["context_mode"] = "off"
        cfg["discover_os"] = False
        cfg["discover_stack"] = False
        return cfg
    if env_ctx in ("yolo", "1", "on", "true", "yes", "all"):
        cfg["context_mode"] = "yolo" if env_ctx == "yolo" else cfg.get("context_mode", "yolo")
        cfg["discover_os"] = True
        cfg["discover_stack"] = True
        if not cfg.get("os_profile"):
            cfg["os_profile"] = detect_os_profile()
        return cfg

    if env_ctx != "careful" and "discover_os" in cfg and "discover_stack" in cfg:
        return cfg

    is_tty = (
        interactive_allowed
        and sys.stdin.isatty()
        and sys.stdout.isatty()
        and not os.environ.get("CI")
        and not os.environ.get("TESTING")
        and not os.environ.get("HOW_NO_BROWSER")
        and not os.environ.get("HOW_NO_PROMPT")
    )

    if not is_tty or (cfg.get("context_prompted") and env_ctx != "careful"):
        cfg.setdefault("context_mode", "careful")
        cfg.setdefault("discover_os", False)
        cfg.setdefault("discover_stack", False)
        return cfg

    return run_step_by_step_context_approval(cfg=cfg)


def get_active_environment_context(
    cfg=None,
    no_context=False,
    force_context=False,
    cwd=None,
    context_mode_override=None,
    return_receipt=False,
):
    """
    Returns formatted OS + local stack context string according to granted user permissions.
    Never reads or returns environment data without explicit permission or --context/--yolo override.
    If `return_receipt=True`, returns `(context_str, receipt_str, os_prof, stack_info)`.
    """
    if no_context or os.environ.get("HOW_NO_CONTEXT") in ("1", "true", "yes"):
        return ("", "", None, None) if return_receipt else ""

    if cfg is None:
        cfg = load_config()

    effective_mode = (context_mode_override or cfg.get("context_mode") or "careful").lower()
    if effective_mode == "yolo":
        force_context = True

    if not force_context:
        cfg = ensure_context_permissions(cfg, context_mode_override=context_mode_override)

    use_os = force_context or bool(cfg.get("discover_os", False))
    use_stack = force_context or bool(cfg.get("discover_stack", False))
    allowed_steps = None if force_context else cfg.get("context_steps")

    lines = []
    os_prof = None
    stack_info = None

    if use_os:
        os_prof = cfg.get("os_profile")
        if not isinstance(os_prof, dict) or not os_prof.get("summary") or "sources_read" not in os_prof:
            os_prof = detect_os_profile(allowed_steps=allowed_steps)
            if cfg.get("discover_os"):
                cfg["os_profile"] = os_prof
                save_config(cfg)
        if os_prof.get("summary"):
            lines.append(os_prof["summary"])

    if use_stack:
        stack_info = detect_local_stack(cwd=cwd)
        if stack_info.get("summary"):
            lines.append(stack_info["summary"])

    ctx_str = "\n".join(lines)
    if return_receipt:
        receipt = format_context_read_receipt(os_prof=os_prof, stack_info=stack_info)
        return ctx_str, receipt, os_prof, stack_info
    return ctx_str


def manage_context_command(args):
    """Handles `how context [status|careful|yolo|dry-run|on|off|os|stack|refresh]` subcommand."""
    cfg = load_config()
    sub = args[0].lower() if args else "status"

    if sub in ("dry-run", "dry", "--dry-run", "plan"):
        query_tail = " ".join(args[1:]) if len(args) > 1 else ""
        print_context_dry_run_plan(query=query_tail)
        return

    if sub in ("careful", "step", "step-by-step", "interactive"):
        dry_flag = any(a.lower() in ("--dry-run", "dry-run", "dry") for a in args[1:])
        if dry_flag or not (sys.stdin.isatty() and sys.stdout.isatty()):
            cfg["context_mode"] = "careful"
            save_config(cfg)
            print_context_dry_run_plan()
            print(f"{GREEN}✓ Context mode set to CAREFUL (step-by-step user approval with dry-run commands).{RESET}\n")
        else:
            run_step_by_step_context_approval(cfg=cfg)
        return

    if sub == "yolo":
        cfg["context_mode"] = "yolo"
        cfg["discover_os"] = True
        cfg["discover_stack"] = True
        cfg["context_prompted"] = True
        cfg["context_steps"] = {s["id"]: True for s in CONTEXT_DISCOVERY_STEPS}
        os_prof = detect_os_profile()
        cfg["os_profile"] = os_prof
        save_config(cfg)
        st_info = detect_local_stack()
        receipt = format_context_read_receipt(os_prof=os_prof, stack_info=st_info)
        print(f"\n{GREEN}✓ Context mode set to {BOLD}YOLO{RESET}{GREEN} (go ahead & report what was read).{RESET}")
        print(f"  {CYAN}🔎 Read:{RESET}  {DIM}{receipt}{RESET}")
        print(f"  {CYAN}OS:{RESET}       {DIM}{os_prof.get('summary', '')}{RESET}")
        if st_info.get("summary"):
            print(f"  {CYAN}Stack:{RESET}    {DIM}{st_info['summary']}{RESET}")
        print()
        return

    if sub in ("on", "enable", "1", "true"):
        cfg["context_mode"] = cfg.get("context_mode") if cfg.get("context_mode") in ("careful", "yolo") else "careful"
        cfg["discover_os"] = True
        cfg["discover_stack"] = True
        cfg["context_prompted"] = True
        cfg["context_steps"] = {s["id"]: True for s in CONTEXT_DISCOVERY_STEPS}
        cfg["os_profile"] = detect_os_profile()
        save_config(cfg)
        st_info = detect_local_stack()
        receipt = format_context_read_receipt(os_prof=cfg["os_profile"], stack_info=st_info)
        print(f"\n{GREEN}✓ Environment & stack discovery ENABLED.{RESET}")
        print(f"  {CYAN}🔎 Read:{RESET} {DIM}{receipt}{RESET}")
        print(f"  {DIM}{cfg['os_profile'].get('summary', '')}{RESET}\n")
        return

    if sub in ("off", "disable", "0", "false"):
        cfg["context_mode"] = "off"
        cfg["discover_os"] = False
        cfg["discover_stack"] = False
        cfg["context_prompted"] = True
        save_config(cfg)
        print(f"\n{YELLOW}✓ Environment & stack discovery DISABLED (0 local files read).{RESET}\n")
        return

    if sub == "refresh":
        cfg["os_profile"] = detect_os_profile(allowed_steps=cfg.get("context_steps"))
        save_config(cfg)
        st_info = detect_local_stack()
        receipt = format_context_read_receipt(os_prof=cfg["os_profile"], stack_info=st_info)
        print(f"\n{GREEN}✓ Refreshed OS profile:{RESET} {cfg['os_profile'].get('summary', '')}")
        print(f"  {CYAN}🔎 Read:{RESET} {DIM}{receipt}{RESET}\n")
        return

    if sub == "os":
        action = args[1].lower() if len(args) > 1 else "status"
        if action in ("on", "enable", "1", "true"):
            cfg["discover_os"] = True
            cfg["context_prompted"] = True
            cfg["os_profile"] = detect_os_profile()
            save_config(cfg)
            print(f"\n{GREEN}✓ OS discovery ENABLED:{RESET} {cfg['os_profile'].get('summary', '')}\n")
        elif action in ("off", "disable", "0", "false"):
            cfg["discover_os"] = False
            cfg["context_prompted"] = True
            save_config(cfg)
            print(f"\n{YELLOW}✓ OS discovery DISABLED.{RESET}\n")
        else:
            st = f"{GREEN}enabled{RESET}" if cfg.get("discover_os") else f"{DIM}disabled{RESET}"
            print(f"\n{BOLD}OS Discovery:{RESET} {st}\n")
        return

    if sub == "stack":
        action = args[1].lower() if len(args) > 1 else "status"
        if action in ("on", "enable", "1", "true"):
            cfg["discover_stack"] = True
            cfg["context_prompted"] = True
            save_config(cfg)
            st_info = detect_local_stack()
            print(f"\n{GREEN}✓ Local stack discovery ENABLED.{RESET}")
            if st_info.get("summary"):
                print(f"  {DIM}{st_info['summary']}{RESET}")
            print()
        elif action in ("off", "disable", "0", "false"):
            cfg["discover_stack"] = False
            cfg["context_prompted"] = True
            save_config(cfg)
            print(f"\n{YELLOW}✓ Local stack discovery DISABLED.{RESET}\n")
        else:
            st = f"{GREEN}enabled{RESET}" if cfg.get("discover_stack") else f"{DIM}disabled{RESET}"
            print(f"\n{BOLD}Stack Discovery:{RESET} {st}\n")
        return

    # Default: status
    mode = cfg.get("context_mode", "careful")
    os_on = bool(cfg.get("discover_os", False))
    stack_on = bool(cfg.get("discover_stack", False))
    mode_badge = (
        f"{MAGENTA}{BOLD}yolo{RESET} {DIM}(auto-read & state what was read){RESET}"
        if mode == "yolo"
        else f"{CYAN}{BOLD}careful{RESET} {DIM}(step-by-step approval with dry-run commands){RESET}"
        if mode != "off"
        else f"{YELLOW}{BOLD}off{RESET} {DIM}(disabled){RESET}"
    )
    os_badge = f"{GREEN}enabled{RESET}" if os_on else f"{YELLOW}disabled{RESET}"
    stack_badge = f"{GREEN}enabled{RESET}" if stack_on else f"{YELLOW}disabled{RESET}"

    os_prof = cfg.get("os_profile") if os_on else None
    if os_on and (not isinstance(os_prof, dict) or not os_prof.get("summary")):
        os_prof = detect_os_profile(allowed_steps=cfg.get("context_steps"))
    os_preview = os_prof.get("summary") if isinstance(os_prof, dict) else "(not active — run `how context careful` or `how context yolo`)"

    st_info = detect_local_stack() if stack_on else None
    stack_preview = (
        (st_info.get("summary") or "No specific stack markers in current directory")
        if isinstance(st_info, dict)
        else "(not active — run `how context careful` or `how context stack on`)"
    )

    print(f"\n{BOLD}{MAGENTA}◆ Graduated Environment & Stack Discovery Status{RESET}\n")
    print(f"  Mode:            {mode_badge}")
    print(f"  OS Discovery:    {os_badge}")
    print(f"    Profile:       {DIM}{os_preview}{RESET}")
    print(f"  Stack Discovery: {stack_badge}")
    print(f"    Current Dir:   {DIM}{stack_preview}{RESET}")
    if os_on or stack_on:
        receipt = format_context_read_receipt(os_prof=os_prof, stack_info=st_info)
        print(f"  Read Receipt:    {DIM}{receipt}{RESET}")
    print(f"\n{BOLD}Graduated Context Commands:{RESET}")
    print(f"  {CYAN}how context careful{RESET}         Step-by-step approval with dry-run commands (default)")
    print(f"  {CYAN}how context dry-run{RESET}         Show exact dry-run inspection commands without reading")
    print(f"  {CYAN}how context yolo{RESET}            Just go ahead, read context & state what was read")
    print(f"  {CYAN}how context on / off{RESET}        Enable or disable all context discovery")
    print(f"  {CYAN}how context os|stack on|off{RESET} Toggle OS or current directory stack discovery")
    print(f"  {CYAN}how context refresh{RESET}         Re-scan OS & desktop profile\n")


