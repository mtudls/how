def get_context_dry_run_steps(cwd=None, query="") -> list:
    """
    Returns the ordered list of graduated context discovery steps with exact dry-run commands.
    If a query is provided, also includes candidate CLI documentation inspection dry-run commands.
    """
    import shutil
    target_dir = os.path.abspath(cwd or os.getcwd())
    steps = []
    for s in CONTEXT_DISCOVERY_STEPS:
        entry = dict(s)
        entry["dry_run"] = entry["dry_run"].replace("<cwd>", target_dir)
        entry["target"] = entry["target"].replace("<cwd>", target_dir)
        steps.append(entry)

    if query:
        for cmd in extract_candidate_commands(query)[:2]:
            cmd_path = shutil.which(cmd)
            if not cmd_path:
                continue
            if cmd == "omarchy" or cmd.startswith("omarchy-"):
                dr = f"head -n 40 {cmd_path}  # parse # omarchy:* header (never executes script)"
            else:
                dr = f"tldr {cmd} || man -P cat {cmd} | head -n 25 || bwrap --ro-bind / / --unshare-all --cap-drop ALL -- timeout -k 1 2 {cmd_path} --help"
            steps.append({
                "id": f"doc:{cmd}",
                "category": "docs",
                "title": f"Local CLI Docs ({cmd})",
                "dry_run": dr,
                "target": cmd_path,
            })
    return steps


def print_context_dry_run_plan(cwd=None, query=""):
    """Prints the step-by-step dry-run inspection commands without reading or executing anything."""
    steps = get_context_dry_run_steps(cwd=cwd, query=query)
    print(f"\n{BOLD}{MAGENTA}◆ Context Discovery Dry-Run Plan (careful mode){RESET}")
    print(f"{DIM}Exact read-only checks that `how` performs when approved (nothing executed in dry-run):{RESET}\n")
