def format_query(raw_query):
    """Optymalizuje prompt w kontekście konsoli Omarchy."""
    q = raw_query.strip()
    if "in omarchy" in q.lower():
        return q

    # Usuń ewentualny zbędny przedrostek 'to' jeśli podano 'how to ...'
    if q.lower().startswith("to "):
        return f"In Omarchy console how {q}"
    else:
        if any(q.lower().startswith(prefix) for prefix in ("auth ", "model ", "display ", "audio ", "network ")):
            return f"In Omarchy console: how {q}"
        return f"In Omarchy console: {q}"

def log_command_proposal(query, command, executed=False):
    """Zapisuje propozycję komendy do lokalnego logu ~/.config/how/commands.log"""
    try:
        os.makedirs(CONFIG_DIR, exist_ok=True)
        with open(COMMANDS_LOG, "a", encoding="utf-8") as f:
            status = "WYKONANO" if executed else "ZAPROPONOWANO"
            ts = time.strftime("%Y-%m-%d %H:%M:%S")
            q_clean = query.strip() if query else "-"
            f.write(f"[{ts}] [{status}] Pytanie: \"{q_clean}\" | Komenda: {command.strip()}\n")
    except Exception:
        pass

def copy_to_clipboard(text):
    """Kopiuje tekst do schowka Wayland (wl-copy) lub X11 (xclip), jeśli dostępne."""
    import subprocess
    for cmd in (["wl-copy"], ["xclip", "-selection", "clipboard"], ["xsel", "--clipboard"]):
        try:
            p = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            p.communicate(input=text.encode("utf-8"), timeout=1)
            if p.returncode == 0:
                return True
        except Exception:
            continue
    return False

def print_shell_init(shell="bash"):
    """Generuje kod integracji powłoki dla synchronizacji historii."""
    print(f"# how - asystent CLI dla Omarchy (integracja z historią {shell})")
    print(f"# Dodaj do pliku konfiguracyjnego powłoki lub uruchom: eval \"$(how init)\"")
    print("how() {")
    print('    command how "$@"')
    print('    local exit_code=$?')
    print('    if [ -f ~/.bash_history ]; then')
    print('        history -r ~/.bash_history 2>/dev/null')
