def open_url_in_browser(url):
    """Opens a URL in the user's browser in the background unless suppressed by test/CI env vars."""
    if os.environ.get("HOW_NO_BROWSER") or os.environ.get("CI") or os.environ.get("TESTING"):
        return True
    import subprocess
    try:
        subprocess.Popen(["xdg-open", url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return True
    except Exception:
        pass
    try:
        import webbrowser
        webbrowser.open(url)
        return True
    except Exception:
        return False


