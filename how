def open_url_in_browser(url):
    """Opens a URL in the user's browser in the background unless suppressed by test/CI env vars."""
    if os.environ.get("HOW_NO_BROWSER") or os.environ.get("CI") or os.environ.get("TESTING"):
        return True
    import subprocess
    try:
        subprocess.Popen(["xdg-open", url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return True
    except Exception:
        pass
    try:
        import webbrowser
        webbrowser.open(url)
        return True
    except Exception:
        return False


def load_config():
    if os.path.exists(CONFIG_FILE):
        import json
        try:
            with open(CONFIG_FILE, "r", encoding="utf-8") as f:
                return json.load(f)
        except Exception:
            return {}
    return {}


def save_config(data):
    import json
    try:
        os.makedirs(CONFIG_DIR, exist_ok=True)
        with open(CONFIG_FILE, "w", encoding="utf-8") as f:
            json.dump(data, f, indent=2)
        try:
            os.chmod(CONFIG_FILE, 0o600)
        except Exception:
            pass
    except Exception as e:
        print(f"{YELLOW}! Could not save configuration to {CONFIG_FILE}: {e}{RESET}")


