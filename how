def diagnose_command_locally(command: str, error_hint: str = "") -> dict:
    """
    Inspects a failed or problematic command + optional error message offline (<1ms)
    and returns {'matched': bool, 'diagnosis': str, 'fixed_command': str}.
    """
    cmd = (command or "").strip()
    combined = f"{cmd} {error_hint}".lower()

    if any(k in combined for k in ("db.lck", "unable to lock database", "failed to init transaction")):
        fixed = f"sudo rm -f /var/lib/pacman/db.lck && {cmd}" if cmd else "sudo rm -f /var/lib/pacman/db.lck"
        return {
            "matched": True,
            "diagnosis": "Stale Pacman database lock file (/var/lib/pacman/db.lck) is blocking package operations.",
            "fixed_command": fixed,
        }

    if any(k in combined for k in ("permission denied", "operation not permitted", "must be root", "are you root")):
        if cmd and not cmd.startswith("sudo "):
            return {
                "matched": True,
                "diagnosis": "Command requires administrator (root) privileges.",
                "fixed_command": f"sudo {cmd}",
            }

    if ("git push" in combined or "upstream" in combined) and any(
        k in combined for k in ("no upstream", "has no upstream", "set-upstream", "git push")
    ):
        return {
            "matched": True,
            "diagnosis": "Current local Git branch has no upstream tracking branch configured on origin.",
            "fixed_command": "git push --set-upstream origin $(git branch --show-current)",
        }

    if any(k in combined for k in ("address already in use", "eaddrinuse", "port is already allocated")):
        import re
        port_m = re.search(r"(?:port|:)\s*(\d{2,5})\b", combined)
        port = port_m.group(1) if port_m else "8080"
        return {
            "matched": True,
            "diagnosis": f"TCP port {port} is already bound by another process.",
            "fixed_command": f"ss -tulpn | grep :{port}",
        }

    if "limine" in combined or ("secure boot" in combined and "sbctl" in combined):
        return {
            "matched": True,
            "diagnosis": "On Omarchy with Limine + Secure Boot, always enroll Limine config before signing EFI binaries.",
            "fixed_command": "sudo limine enroll-config && sudo sbctl sign-all",
        }

    if cmd:
        imp_cmd, notes = improve_query_locally(cmd)
        if imp_cmd != cmd and notes:
            return {
                "matched": True,
                "diagnosis": f"Repaired typo in command ({', '.join(notes)}).",
                "fixed_command": imp_cmd,
            }

    return {"matched": False, "diagnosis": "", "fixed_command": ""}


def run_fix_command(args, opts):
    """Handles `how fix [error or command...]` — diagnoses & repairs the last command."""
    hint = " ".join(args).strip()
    last_cmd, last_query = get_last_suggested_command()

    target_cmd = last_cmd or hint
    if not target_cmd:
        print(f"\n{YELLOW}! No recent command in {COMMANDS_LOG} and no error context provided.{RESET}")
        print(f"{DIM}Usage: {CYAN}how fix{RESET} {DIM}or{RESET} {CYAN}how fix \"permission denied\"{RESET}\n")
        return

    diag = diagnose_command_locally(last_cmd or hint, error_hint=hint)
    if diag["matched"]:
        fixed = diag["fixed_command"]
        safety = classify_command_safety(fixed)
        print(f"\n{BOLD}{MAGENTA}◆ Instant Command Diagnosis & Repair{RESET}")
        if last_cmd:
            print(f"  {BOLD}Previous:{RESET}  {DIM}{last_cmd}{RESET}")
        if hint and hint != last_cmd:
            print(f"  {BOLD}Symptom:{RESET}   {DIM}{hint}{RESET}")
        print(f"  {BOLD}Diagnosis:{RESET} {diag['diagnosis']}")
        print(f"  {BOLD}Safety:{RESET}    {safety['badge']} {DIM}— {safety['reason']}{RESET}\n")
        display_suggested_command(fixed, query=f"fix: {last_query or target_cmd}", is_cached=False)
        return

    if opts.get("dry_run"):
        print(f"\n{BOLD}{MAGENTA}◆ Command Repair Dry-Run{RESET}")
        print(f"  {BOLD}Target:{RESET} {DIM}{target_cmd}{RESET}")
        print(f"  {YELLOW}[dry-run]{RESET} Would escalate repair query to `how -t` for deep troubleshooting.\n")
        return

    fix_query = f"to fix command `{last_cmd}`" + (f" failing with: {hint}" if hint else "") if last_cmd else f"to fix: {hint}"
    ask_groq(
        fix_query,
        verbosity=opts.get("verbosity"),
        no_cache=True,
        think_mode="deep",
        no_context=opts.get("no_context", False),
        force_context=opts.get("force_context", False),
        context_mode_override=opts.get("context_mode_override"),
        dry_run=False,
    )


