# ----------------------------------------------------------------------------- command line

HELP = """how: ask in plain words, get one terminal command with a safety badge

  how <question>          e.g. how to find largest files here
  how run                 run the last suggested command
  how explain [command]   break down the last (or given) command
  how good | how bad [note]   rate the last answer
  how key                 set your API key (free at console.groq.com/keys)
  how log [N] | --path    show the last N log entries (default 20)
  how privacy             what is sent, where, and which files are touched
  how doctor              health check
  how update | uninstall  how updates arrive / how to remove how
  how --version | --help

Flags before the question:
  -y, --yes      run without asking, but only when the badge is 🟢 safe
  -n, --no-run   just print (and copy) the command
  --json         print one JSON object; never prompts or runs
  --debug        diagnostics on stderr

Badges: 🟢 safe (Enter runs) · 🟡 modifies (press y) · 🔴 dangerous (type run)"""

FLAGS = {"-y": "yes", "--yes": "yes", "-n": "no_run", "--no-run": "no_run", "--json": "json", "--debug": "debug"}
SINGLE_WORD = {"run", "key", "privacy", "doctor", "update", "uninstall", "version", "help"}


def parse_flags(argv: list[str]) -> tuple[dict, list[str]]:
    opts = {name: False for name in FLAGS.values()}
    words = list(argv)
    while words and words[0].startswith("-"):
        flag = words.pop(0)
        if flag == "--":
            break
        if flag in ("-h", "--help"):
            return opts, ["help"]
        if flag in ("-V", "--version"):
            return opts, ["version"]
        if flag not in FLAGS:
            raise HowError("usage", f"unknown option {flag}", "see: how --help", exit_code=2)
        opts[FLAGS[flag]] = True
    return opts, words


def route(words: list[str]) -> tuple[str, list[str]]:
    """Decides whether the words are a subcommand or a question (`how update my mirrors` is a question)."""
    head, rest = words[0].lower(), words[1:]
    if head == "explain" and not (rest and rest[0].lower() in {"to", "how", "what", "why", "the", "me"}):
        return "explain", rest
    if head in ("good", "bad") and not (rest and rest[0].lower() in QUESTION_WORDS):
        return head, rest
    if head == "log" and (not rest or (len(rest) == 1 and (rest[0].isdigit() or rest[0] == "--path"))):
        return "log", rest
    if head in SINGLE_WORD and not rest:
        return head, []
    return "ask", words


def main(argv: list[str]) -> int:
    global DEBUG
    if not argv:
        return cmd_help()
    opts, words = parse_flags(argv)
    DEBUG = opts["debug"]
    if not words:
        raise HowError("usage", "what do you want to do?", "e.g. how to find largest files here", exit_code=2)
    name, args = route(words)
    question = " ".join(words)
    try:
        return dispatch(name, args, question, opts)
    except HowError as e:
        if opts["json"] and name == "ask":
            print(json.dumps(json_result(question, None, None, "", e), ensure_ascii=False))
            return e.exit_code
        raise


def cmd_help() -> int:
    print(HELP)
    return 0


def cmd_version() -> int:
    print(f"how {__version__}")
    return 0


def dispatch(name: str, args: list[str], question: str, opts: dict) -> int:
    simple = {"help": cmd_help, "version": cmd_version, "key": cmd_key, "privacy": cmd_privacy,
              "doctor": cmd_doctor, "update": cmd_update, "uninstall": cmd_uninstall}
    if name in simple:
        return simple[name]()
    if name == "run":
        return cmd_run(opts)
    if name == "explain":
        return cmd_explain(args)
    if name in ("good", "bad"):
        return cmd_rate(name, " ".join(args))
    if name == "log":
        return cmd_log(args)
    return cmd_ask(question, opts)


def entry() -> int:
    """Runs main() and turns every expected failure into a short message and an exit code."""
    try:
        return main(sys.argv[1:])
    except HowError as e:
        err(paint(f"how: {e.message}", "red", stream=sys.stderr))
        if e.hint:
            err(paint(f"     {e.hint}", "dim", stream=sys.stderr))
        return e.exit_code
    except KeyboardInterrupt:
        if sys.stderr.isatty():
            err("")
        return 130
    except BrokenPipeError:
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        return 1


if __name__ == "__main__":
    sys.exit(entry())
