    print("Darmowy klucz API uzyskasz na:")
    print(f"  {CYAN}{GROQ_KEYS_URL}{RESET}\n")

    try:
        ans = input(f"{DIM}Czy otworzyć stronę w przeglądarce? [T/n]: {RESET}").strip().lower()
        if ans in ("", "t", "y", "tak", "yes"):
            open_url_in_browser(GROQ_KEYS_URL)
    except (KeyboardInterrupt, EOFError):
        print(f"\n{YELLOW}Anulowano.{RESET}\n")
        return

    try:
        key = input(f"\n{BOLD}Wklej Groq API Key (gsk_...): {RESET}").strip()
    except (KeyboardInterrupt, EOFError):
        print(f"\n{YELLOW}Anulowano.{RESET}\n")
        return

    if not key:
        print(f"{RED}✗ Nie podano klucza.{RESET}\n")
        return

    print(f"{DIM}Weryfikacja klucza API...{RESET}", end="", flush=True)
    models, err = fetch_available_models(key)
    print("\r" + " " * 35 + "\r", end="")

    if err:
        print(f"{RED}✗ Błąd weryfikacji: {err}{RESET}")
        print(f"{DIM}Sprawdź czy klucz jest poprawny.{RESET}\n")
        return

    cfg = load_config()
    cfg["api_key"] = key
    save_config(cfg)
    print(f"{GREEN}✓ Zalogowano pomyślnie!{RESET} Klucz zapisano w: {DIM}{CONFIG_FILE}{RESET}\n")

