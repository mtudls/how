  {CYAN}how{RESET} [-0|--low] [--no-cache] <query...>
  {CYAN}how{RESET} <command> [args...]

Commands:
  {CYAN}auth{RESET} [login|status|logout]   Manage Groq API key
  {CYAN}model{RESET} [check]                Select and test models
  {CYAN}cache{RESET} [retention|clear]      Response cache and retention (m, h, D, M)
  {CYAN}verbosity{RESET} [zero|low|normal]  Default output verbosity
  {CYAN}history{RESET} [filter]              Recent command suggestions
  {CYAN}feedback{RESET} [text...]            Send quick feedback directly from terminal

Options:
  {GREEN}-0, --zero{RESET}                   Command only (no explanation)
  {GREEN}--low{RESET}                        Minimal 1-sentence explanation
  {GREEN}--no-cache{RESET}                   Bypass response cache
  {GREEN}--retention <time>{RESET}           Temporary cache retention (e.g. 30m, 3h, 7D, 1M)
  {GREEN}--feedback, --bug{RESET}            Quick feedback link for the current query
""")

def main():
    if len(sys.argv) < 2:
        print_help()
        sys.exit(0)

    raw_args = sys.argv[1:]

    if len(raw_args) == 1 and raw_args[0].lower() in ("--help", "-h", "help"):
        print_help()
        sys.exit(0)

    # Podkomenda 'verbosity': how verbosity [poziom]
    if raw_args[0].lower() in ("verbosity", "verbose"):
        target_v = raw_args[1] if len(raw_args) > 1 else None
        set_verbosity_interactive(target_v)
        sys.exit(0)

    # Parsowanie flag (verbosity, clip, cache, feedback)
    verbosity = None
    copy_only = False
    no_cache = False
    custom_retention = None
    feedback_mode = False
    args = []
    i = 0
    while i < len(raw_args):
        a = raw_args[i]
        a_lower = a.lower()
        if a_lower in ("--feedback", "--bug", "--issue", "--report"):
            feedback_mode = True
            i += 1
        elif a_lower in ("-c", "--clip", "--copy"):
            copy_only = True
            i += 1
        elif a_lower in ("-0", "--zero", "-q", "--quiet"):
            verbosity = "zero"
            i += 1
        elif a_lower == "--low":
            verbosity = "low"
            i += 1
        elif a_lower == "--normal":
            verbosity = "normal"
            i += 1
        elif a_lower in ("-v", "--verbosity"):
            if i + 1 < len(raw_args):
                verbosity = raw_args[i + 1].lower()
                i += 2
            else:
                print(f"{RED}✗ Provide verbosity level after {a} (zero, low, normal).{RESET}")
                sys.exit(1)
        elif a_lower.startswith("--verbosity="):
            verbosity = a.split("=", 1)[1].lower()
            i += 1
        elif a_lower.startswith("-v="):
            verbosity = a.split("=", 1)[1].lower()
            i += 1
        elif a_lower in ("--no-cache", "--fresh", "--refresh"):
            no_cache = True
            i += 1
        elif a_lower in ("--retention", "--cache-retention"):
            if i + 1 < len(raw_args):
                custom_retention = raw_args[i + 1]
                i += 2
            else:
                print(f"{RED}✗ Provide retention time after {a} (e.g. 30m, 3h, 7D, 1M).{RESET}")
                sys.exit(1)
        elif a_lower.startswith("--retention="):
            custom_retention = a.split("=", 1)[1]
            i += 1
        elif a_lower.startswith("--cache-retention="):
            custom_retention = a.split("=", 1)[1]
            i += 1
        else:
            args.extend(raw_args[i:])
            break

    if not args:
        print_help()
        sys.exit(0)

    first = args[0].lower()

    # Podkomenda feedback: how feedback [opcjonalny opis/zapytanie]
    if first in ("feedback", "bug", "report", "issue"):
        msg = " ".join(args[1:]) if len(args) > 1 else ""
        send_terminal_feedback(msg)
        sys.exit(0)

    if feedback_mode:
        send_terminal_feedback(" ".join(args))
        sys.exit(0)

    # Podkomendy 'cache'
    if first == "cache":
        if len(args) == 1:
            cache_status()
            sys.exit(0)
        sub = args[1].lower()
        if sub in ("clear", "clean", "purge", "flush", "reset") and len(args) == 2:
            cache_clear()
            sys.exit(0)
        elif sub in ("status", "info") and len(args) == 2:
            cache_status()
            sys.exit(0)
        elif sub in ("off", "disable", "wyłącz", "wylacz") and len(args) == 2:
            cache_set_retention("0")
            sys.exit(0)
        elif sub in ("on", "enable", "włącz", "wlacz") and len(args) == 2:
            cache_set_retention("3h")
            sys.exit(0)
        elif sub in ("retention", "set"):
            if len(args) > 2:
                cache_set_retention(" ".join(args[2:]))
            else:
                cache_set_retention(None)
            sys.exit(0)
        else:
            cand_time = " ".join(args[1:])
            try:
                # Jeśli sparsuje się poprawnie jako czas, traktujemy jako ustawienie retencji
                parse_retention(cand_time)
                cache_set_retention(cand_time)
                sys.exit(0)
            except ValueError:
                # To zapytanie użytkownika (np. 'how cache works on linux')
                pass

    # Uproszczone podkomendy 'auth': login, status, logout
    if first == "auth":
        if len(args) == 1:
            auth_status()
            sys.exit(0)
        sub = args[1].lower()
        if sub in ("login", "in") and len(args) == 2:
            auth_login()
            sys.exit(0)
        elif sub in ("logout", "out") and len(args) == 2:
            auth_logout()
            sys.exit(0)
        elif sub == "status" and len(args) == 2:
            auth_status()
            sys.exit(0)
        # W przeciwnym razie to zapytanie użytkownika (np. 'how auth works on omarchy?')

    # Skróty historii
    if first in ("history", "commands"):
        filter_t = args[1] if len(args) > 1 else None
        show_command_history(filter_term=filter_t)
        sys.exit(0)

    # Administracyjne podkomendy 'model':
    if first in ("model", "models"):
        if len(args) == 1:
            select_model_interactive()
            sys.exit(0)
        elif len(args) == 2:
            sub = args[1].lower()
            if sub == "check":
                check_all_models()
                sys.exit(0)
            elif sub.isdigit() or "/" in sub:
                select_model_interactive(args[1])
                sys.exit(0)

    # Cała reszta to zapytanie do asystenta
    query = " ".join(args)
    ask_groq(query, copy_only=copy_only, verbosity=verbosity, no_cache=no_cache, custom_retention=custom_retention)

if __name__ == "__main__":
    main()
