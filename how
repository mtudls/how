def format_relative_age(seconds: int) -> str:
    """Formats a short human age string (e.g. 2m, 15m, 1h) for repeat-memory prompts."""
    sec = max(0, int(seconds or 0))
    if sec < 60:
        return "just now" if sec < 5 else f"{sec}s ago"
    if sec < 3600:
        return f"{sec // 60}m ago"
    if sec < 86400:
        hours = sec // 3600
        mins = (sec % 3600) // 60
        return f"{hours}h ago" if mins == 0 else f"{hours}h{mins}m ago"
    days = sec // 86400
    return f"{days}D ago"


def prompt_repeat_question_memory(raw_query: str, hit_count: int, seconds_since_prev: int, input_fn=None) -> str:
    """
    Interactive Repeat-Question Memory (requirements Prompt 30 / roadmap v0.5).
    When the same query is asked again within REPEAT_MEMORY_WINDOW_SEC in a TTY,
    ask whether the previous cached answer failed.

    Returns one of: 'n' (show cache), 'y' (fresh deep thinking), 'e' (how fix).
    Non-interactive / disabled environments always return 'n'.
    """
    if os.environ.get("HOW_NO_REPEAT_PROMPT") in ("1", "true", "yes"):
        return "n"
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        return "n"
    if seconds_since_prev > REPEAT_MEMORY_WINDOW_SEC:
        return "n"

    ask_fn = input_fn or input
    age = format_relative_age(seconds_since_prev)
    times = f"{hit_count}x" if hit_count >= 2 else "before"
    print(f"  {YELLOW}?{RESET} You asked this {BOLD}{age}{RESET} ({times}). Did the previous command not work?")
    print(f"    {CYAN}[Y]{RESET} Try a fresh Deep Thinking solution (-t --no-cache)")
    print(f"    {CYAN}[e]{RESET} Attach last terminal error / exit code and fix it ({CYAN}how fix{RESET})")
    print(f"    {CYAN}[n]{RESET} Show the cached command again")
    try:
        ans = ask_fn(f"  {CYAN}Choice [Y/e/n]:{RESET} ").strip().lower()
    except (KeyboardInterrupt, EOFError):
        print()
        return "n"
    if ans in ("y", "yes"):
        return "y"
    if ans in ("e", "fix", "error"):
        return "e"
    return "n"


