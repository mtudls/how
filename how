def main():
    if len(sys.argv) < 2:
        print_help()
        sys.exit(0)

    raw_args = sys.argv[1:]

    if len(raw_args) == 1 and raw_args[0].lower() in ("--help", "-h", "help"):
        print_help()
        sys.exit(0)

    # Shell init integration: how init [bash|zsh]
    if raw_args[0].lower() == "init":
        shell = raw_args[1] if len(raw_args) > 1 else "bash"
        print_shell_init(shell)
        sys.exit(0)

    # Podkomenda 'verbosity': how verbosity [poziom]
    if raw_args[0].lower() in ("verbosity", "verbose"):
        target_v = raw_args[1] if len(raw_args) > 1 else None
        set_verbosity_interactive(target_v)
        sys.exit(0)

    # Parsowanie flag (verbosity, clip)
    verbosity = None
    copy_only = False
    args = []
    i = 0
    while i < len(raw_args):
        a = raw_args[i]
        a_lower = a.lower()
        if a_lower in ("-c", "--clip", "--copy"):
            copy_only = True
            i += 1
        elif a_lower in ("-0", "--zero", "-q", "--quiet"):
            verbosity = "zero"
            i += 1
        elif a_lower == "--low":
            verbosity = "low"
            i += 1
        elif a_lower == "--normal":
            verbosity = "normal"
            i += 1
        elif a_lower in ("-v", "--verbosity"):
            if i + 1 < len(raw_args):
                verbosity = raw_args[i + 1].lower()
                i += 2
            else:
                print(f"{RED}✗ Podaj poziom verbosity po fladze {a} (zero, low, normal).{RESET}")
                sys.exit(1)
        elif a_lower.startswith("--verbosity="):
            verbosity = a.split("=", 1)[1].lower()
            i += 1
        elif a_lower.startswith("-v="):
            verbosity = a.split("=", 1)[1].lower()
            i += 1
        else:
            args.extend(raw_args[i:])
            break

    if not args:
        print_help()
        sys.exit(0)

    first = args[0].lower()

    # Uproszczone podkomendy 'auth': login, status, logout
    if first == "auth":
        if len(args) == 1:
            auth_status()
            sys.exit(0)
        sub = args[1].lower()
        if sub in ("login", "in") and len(args) == 2:
            auth_login()
            sys.exit(0)
        elif sub in ("logout", "out") and len(args) == 2:
            auth_logout()
            sys.exit(0)
        elif sub == "status" and len(args) == 2:
            auth_status()
            sys.exit(0)
        # W przeciwnym razie to zapytanie użytkownika (np. 'how auth works on omarchy?')

    # Skróty historii
    if first in ("history", "commands"):
        filter_t = args[1] if len(args) > 1 else None
        show_command_history(filter_term=filter_t)
        sys.exit(0)

    # Administracyjne podkomendy 'model':
    if first in ("model", "models"):
        if len(args) == 1:
            select_model_interactive()
            sys.exit(0)
        elif len(args) == 2:
            sub = args[1].lower()
            if sub == "check":
                check_all_models()
                sys.exit(0)
            elif sub.isdigit() or "/" in sub:
                select_model_interactive(args[1])
                sys.exit(0)

    # Cała reszta to zapytanie do asystenta
    query = " ".join(args)
    ask_groq(query, copy_only=copy_only, verbosity=verbosity)

if __name__ == "__main__":
    main()
