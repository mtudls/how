def apply_reflex_slot_filling(cmd: str, raw_query: str) -> str:
    """
    Golden Alternative (GA) Dynamic Slot Filler:
    Substitutes literal parameters from the user's natural query (port numbers, PIDs, size thresholds,
    tmux session names, systemd unit names, workspace numbers) into the matched System-1 reflex command.
    """
    import re
    out = cmd
    q = (raw_query or "").strip()

    # 1. Port number slot (e.g. "kill process on port 3000" -> replace 8080 with 3000)
    port_m = re.search(r"\bport\s+(\d{2,5})\b", q, re.IGNORECASE)
    if port_m and "8080" in out:
        out = out.replace("8080", port_m.group(1))

    # 2. PID slot (e.g. "open files for pid 4242" -> replace <PID> with 4242)
    pid_m = re.search(r"\bpid\s+(\d+)\b", q, re.IGNORECASE)
    if pid_m and "<PID>" in out:
        out = out.replace("<PID>", pid_m.group(1))

    # 3. File size threshold slot (e.g. "find large files over 500M" -> replace +1G with +500M)
    size_m = re.search(r"\b(?:over|larger\s+than|above)\s+(\d+\s*[KMGTP]B?)\b", q, re.IGNORECASE)
    if size_m and "+1G" in out:
        raw_sz = size_m.group(1).upper().replace(" ", "").rstrip("B")
        out = out.replace("+1G", f"+{raw_sz}")

    # 4. Tmux session name slot (e.g. "tmux session named dev" -> replace work with dev)
    tmux_m = re.search(r"\btmux\s+session\s+(?:named|called)\s+([a-zA-Z0-9_\-]+)\b", q, re.IGNORECASE)
    if tmux_m and "tmux new -s work" in out:
        out = out.replace("tmux new -s work", f"tmux new -s {tmux_m.group(1)}")

    # 5. Systemd service name slot (e.g. "follow journalctl logs for nginx" -> replace <service> with nginx)
    svc_m = re.search(r"\b(?:for|service)\s+([a-zA-Z0-9_\-@\.]+?)(?:\s+service)?\s*[?.!]*$", q, re.IGNORECASE)
    if svc_m and "<service>" in out:
        cand_svc = svc_m.group(1).strip()
        if cand_svc.lower() not in ("a", "the", "my", "some", "any", "systemd", "service"):
            out = out.replace("<service>", cand_svc)

    # 6. Hyprland workspace number slot (e.g. "move window to workspace 5" -> replace workspace 3 with 5)
    ws_m = re.search(r"\bworkspace\s+(\d{1,2})\b", q, re.IGNORECASE)
    if ws_m and "movetoworkspace 3" in out:
        out = out.replace("movetoworkspace 3", f"movetoworkspace {ws_m.group(1)}")

    return out


def lookup_episodic_history(query: str) -> dict | None:
    """
    Golden Alternative (GA) Personal Episodic Memory (<0.5ms, offline):
    Searches `~/.config/how/commands.log` for previously `[EXECUTED]` commands on this machine
    whose query matches the user's current intent.
    """
    import re
    if not query or not os.path.isfile(COMMANDS_LOG):
        return None

    q_norm = re.sub(r"^(?:in omarchy console:? )?(?:how (?:do i |can i |to )?|to )", "", query.strip().lower()).strip(" ?!.")
    q_tokens = {t for t in re.findall(r"[a-z0-9_\-\.]+", q_norm) if t not in REFLEX_FRAMING_STOPWORDS and len(t) > 1}
    if not q_tokens:
        return None

    try:
        with open(COMMANDS_LOG, "r", encoding="utf-8", errors="ignore") as f:
            lines = f.readlines()[-200:]
    except Exception:
        return None

    for line in reversed(lines):
        if "[EXECUTED]" not in line:
            continue
        m = re.search(r'Query:\s*"([^"]+)"\s*\|\s*Command:\s*(.+)$', line.strip())
        if not m:
            continue
        past_q, past_cmd = m.group(1).strip(), m.group(2).strip()
        if not past_cmd or past_q.lower().startswith("where:"):
            continue
        pq_norm = re.sub(r"^(?:in omarchy console:? )?(?:how (?:do i |can i |to )?|to )", "", past_q.lower()).strip(" ?!.")
        if pq_norm == q_norm:
            return {
                "id": "episodic_exact",
                "command": past_cmd,
                "explanation": f"Previously executed command on this machine for '{past_q}'.",
                "category": "episodic",
                "safety": classify_command_safety(past_cmd),
                "score": 9.5,
                "source": "system1:episodic-history",
            }
        pq_tokens = {t for t in re.findall(r"[a-z0-9_\-\.]+", pq_norm) if t not in REFLEX_FRAMING_STOPWORDS and len(t) > 1}
        if pq_tokens and len(q_tokens & pq_tokens) / max(len(q_tokens), len(pq_tokens)) >= 0.85:
            return {
                "id": "episodic_fuzzy",
                "command": past_cmd,
                "explanation": f"Previously executed command on this machine for '{past_q}'.",
                "category": "episodic",
                "safety": classify_command_safety(past_cmd),
                "score": 8.5,
                "source": "system1:episodic-history",
            }
    return None


def lookup_local_tldr_reflex(query: str) -> dict | None:
    """
    Golden Alternative (GA) Local `tldr` Recipe Extractor (<2ms, offline):
    Parses installed local `tldr` markdown pages for candidate commands mentioned in the query
    and returns the highest-scoring `- Description:` + `` `command` `` recipe.
    """
    import re
    q_low = (query or "").lower()
    q_tokens = {t for t in re.findall(r"[a-z0-9_\-]+", q_low) if t not in REFLEX_FRAMING_STOPWORDS and len(t) > 1}
    if not q_tokens:
        return None

    for cand in extract_candidate_commands(q_low)[:3]:
        md = get_tldr_content(cand)
        if not md:
            continue
        desc = ""
        best_pair = None
        best_sc = 0.0
        for ln in md.splitlines():
            s = ln.strip()
            if s.startswith("- "):
                desc = s[2:].strip().rstrip(":")
            elif s.startswith("`") and s.endswith("`") and len(s) > 2 and desc:
                ex_cmd = s[1:-1].strip().replace("{{", "<").replace("}}", ">")
                d_tokens = {t for t in re.findall(r"[a-z0-9_\-]+", desc.lower()) if t not in REFLEX_FRAMING_STOPWORDS}
                overlap = len(q_tokens & d_tokens)
                sc = overlap * 1.5 + (1.0 if cand in q_tokens else 0.0)
                if sc > best_sc and overlap >= 1:
                    best_sc = sc
                    best_pair = (ex_cmd, desc)
        if best_pair and best_sc >= 2.5:
            ex_cmd, desc = best_pair
            return {
                "id": f"tldr:{cand}",
                "command": ex_cmd,
                "explanation": f"{desc} (from local `tldr {cand}`).",
                "category": "tldr",
                "safety": classify_command_safety(ex_cmd),
                "score": round(best_sc, 3),
                "source": f"system1:local-tldr:{cand}",
            }
    return None


def lookup_system1_reflex(query: str) -> dict | None:
    """
    Tier-0 System-1 Offline Reflex Engine (<3ms, zero network calls).
    Uses:
    1. Typo normalization + weighted anchor/BM25-style token scoring over `SYSTEM1_REFLEX_KB` + dynamic slot filling
    2. Personal Episodic History (`~/.config/how/commands.log` `[EXECUTED]` entries)
    3. Local `# omarchy:*` header example extraction and local `tldr` markdown recipe extraction.
    Returns a dict `{"id", "command", "explanation", "category", "safety", "score", "source"}`
    or `None` when uncertain.
    """
    import re
    if not query or not query.strip():
        return None

    improved_q, _ = improve_query_locally(query)
    q_low = improved_q.lower().strip()
    for pfx in ("in omarchy console how ", "in omarchy console: how ", "in omarchy console: ", "how do i ", "how can i ", "how to ", "to "):
        if q_low.startswith(pfx):
            q_low = q_low[len(pfx):].strip()

    raw_tokens = re.findall(r"[a-z0-9_\-\.]+", q_low)
    if not raw_tokens:
        return None

    content_tokens = [
        t for t in raw_tokens
        if t not in REFLEX_FRAMING_STOPWORDS and t not in ("omarchy", "linux", "arch", "console", "terminal", "cli")
    ]
    if not content_tokens:
        content_tokens = [t for t in raw_tokens if t not in REFLEX_FRAMING_STOPWORDS]
    if not content_tokens:
        return None

    token_set = set(raw_tokens)
    best_entry = None
    best_score = 0.0

    for slug, anchors, keywords, cmd, explanation, category in SYSTEM1_REFLEX_KB:
        anchor_bonus = 0.0
        for anc in anchors:
            if anc in q_low:
                anchor_bonus = max(anchor_bonus, 2.5 if " " in anc else 1.5)

        kw_set = set(keywords)
        matched_kws = token_set.intersection(kw_set)
        if not matched_kws and anchor_bonus == 0.0:
            continue

        matched_content = [t for t in content_tokens if t in kw_set or any(t in a for a in anchors)]
        if not matched_content:
            continue

        coverage = len(matched_content) / max(1, len(content_tokens))
        kw_precision = len(matched_kws) / max(1, len(kw_set))
        score = anchor_bonus + (len(matched_kws) * 1.1) + (coverage * 2.2) + (kw_precision * 0.8)

        # Require either a phrase anchor match OR strong content coverage (>= 0.6) with >= 2 matched keywords
        if anchor_bonus == 0.0 and (len(matched_kws) < 2 or coverage < 0.6):
            continue
        if coverage < 0.34 and anchor_bonus < 2.0:
            continue

        if score > best_score:
            best_score = score
            best_entry = (slug, cmd, explanation, category, score)

    if best_entry and best_score >= 3.2:
        slug, cmd, explanation, category, score = best_entry
        filled_cmd = apply_reflex_slot_filling(cmd, query)
        return {
            "id": slug,
            "command": filled_cmd,
            "explanation": explanation,
            "category": category,
            "safety": classify_command_safety(filled_cmd),
            "score": round(score, 3),
            "source": "system1:basal-kb",
        }

    episodic = lookup_episodic_history(query)
    if episodic:
        return episodic

    # Fallback local Tier-0 check: inspect `# omarchy:examples=` header on disk without subprocess
    import shutil
    for cand in extract_candidate_commands(q_low)[:2]:
        if cand == "omarchy" or cand.startswith("omarchy-"):
            c_path = shutil.which(cand)
            if c_path:
                hdr = parse_omarchy_header(c_path)
                if hdr and "Examples:" in hdr:
                    ex_line = [ln.split("Examples:", 1)[1].strip() for ln in hdr.splitlines() if ln.startswith("Examples:")][0]
                    first_ex = ex_line.split("|")[0].strip()
                    if first_ex:
                        return {
                            "id": f"omarchy_hdr:{cand}",
                            "command": first_ex,
                            "explanation": f"Local Omarchy command example from {c_path}.",
                            "category": "omarchy",
                            "safety": classify_command_safety(first_ex),
                            "score": 3.0,
                            "source": f"system1:omarchy-header:{cand}",
                        }

    tldr_res = lookup_local_tldr_reflex(q_low)
    if tldr_res:
        return tldr_res

    return None


def run_offline_reflex(raw_query: str, verbosity: str = None) -> bool:
    """
    Executes Tier-0 System-1 Offline Reflex resolution (<3ms, zero network calls).
    Returns True if a reflex command was found and emitted, or False if uncertain ('I don't know').
    """
    import time
    t0 = time.perf_counter()
    cfg = load_config()
    if verbosity is None:
        verbosity = cfg.get("verbosity", DEFAULT_VERBOSITY)
    if verbosity not in ("zero", "low", "normal"):
        verbosity = "normal"

    res = lookup_system1_reflex(raw_query)
    elapsed_ms = (time.perf_counter() - t0) * 1000

    if not res:
        if verbosity == "zero":
            print("I don't know\n")
        else:
            print(f"\n{CYAN}{BOLD}how ❯{RESET} {GREEN}[reflex • offline {elapsed_ms:.2f}ms]{RESET}\n")
            print(f"I don't know{RESET}\n")
        return False

    cmd = res["command"]
    explanation = res["explanation"]
    formatted_text = f"```bash\n{cmd}\n```\n{explanation}"

    if verbosity != "zero":
        v_info = f", {verbosity}" if verbosity != "normal" else ""
        print(
            f"\n{CYAN}{BOLD}how ❯{RESET} {GREEN}[reflex • offline {elapsed_ms:.2f}ms]{RESET} "
            f"{DIM}({res['source']}{v_info}){RESET}\n"
        )
        print(formatted_text + f"{RESET}\n")

    emit_command(cmd, query=raw_query, verbosity=verbosity, is_cached=False, raw_text=formatted_text)
    return True


