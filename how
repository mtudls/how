def classify(command: str) -> tuple[str, str]:
    """Returns (level, reason), level being "safe", "modifies" or "dangerous". Pure, local, no LLM."""
    cmd = (command or "").strip()
    # `<placeholder>` slots such as `lsof -p <PID>` are not redirections.
    low = re.sub(r"<[a-z0-9_.:@/-]+>", "x", cmd.lower())
    for rules, level in ((DANGEROUS_RULES, "dangerous"), (MODIFIES_RULES, "modifies")):
        for pattern, reason in rules:
            if re.search(pattern, low):
                return level, reason
    if not cmd or not is_read_only(cmd):
        return "modifies", "not a known read-only command, so treat it as changing something"
    return "safe", "reads only"


def is_read_only(command: str) -> bool:
    """True only when every simple command is a known inspector and nothing is redirected to a file."""
    segments = split_segments(command)
    return bool(segments) and all(segment_is_read_only(s) for s in segments)


def split_segments(command: str) -> list[list[str]]:
    """Splits a command line on pipes, &&, ;, subshells and substitutions. Returns [] when unsafe to parse
    or when output is redirected into a file."""
    text = re.sub(r"<[A-Za-z0-9_.:@/-]+>", "PLACEHOLDER", command)
    text = re.sub(r"(?:\\;|';'|\";\")(?=\s|$)", " " + FIND_EXEC_END, text)
    text = text.replace("$(", " ( ").replace("`", " ` ")
    try:
        lexer = shlex.shlex(text, posix=True, punctuation_chars=True)
        lexer.whitespace_split = True
        tokens = list(lexer)
    except ValueError:
        return []
    segments: list[list[str]] = [[]]
    i = 0
    while i < len(tokens):
        tok, nxt = tokens[i], tokens[i + 1] if i + 1 < len(tokens) else ""
        if tok in SEPARATORS or tok == "`":
            segments.append([])
        elif set(tok) <= set("<>&|;()"):
            if ">" in tok:
                if not (nxt == "/dev/null" or (tok in (">&", "<&") and (nxt.isdigit() or nxt == "-"))):
                    return []  # output written to a file
            i += 1  # skip the redirection target
        elif tok.isdigit() and nxt[:1] in (">", "<"):
            pass  # file-descriptor number of a redirection, as in 2>&1
        else:
            segments[-1].append(tok)
        i += 1
    return [s for s in segments if s]


def segment_is_read_only(tokens: list[str]) -> bool:
    """True when one simple command (no pipes or separators) only inspects state."""
    toks = list(tokens)
    while toks and re.match(r"^[A-Za-z_][A-Za-z0-9_]*=", toks[0]):
        toks = toks[1:]  # leading VAR=value assignments
    if not toks:
        return True
    binary, args = os.path.basename(toks[0]), toks[1:]
    if len(args) == 1 and args[0] in ("--version", "-V", "--help", "-h", "version", "help"):
        return True
    if binary in WRAPPERS:
        return wrapped_is_read_only(binary, args)
    if binary == "env":
        return all(a.startswith("-") or "=" in a for a in args) and not {"-S", "--split-string"} & set(args)
    if binary == "find":
        return find_is_read_only(args)
    if binary == "curl":
        return curl_is_read_only(args)
    if binary in ("pacman", "yay", "paru"):
        return pacman_is_read_only(args)
    if binary == "journalctl":
        return not any(a.startswith(("--vacuum", "--rotate", "--flush", "--sync", "--relinquish", "--setup-keys",
                                     "--update-catalog")) for a in args)
    if binary == "ip":
        mutating = {"add", "del", "delete", "set", "flush", "change", "replace", "append", "up", "down",
                    "prepend", "save", "restore", "exec", "attach", "detach", "update"}
        return not mutating & {a.lower() for a in args}
    if binary == "omarchy":
        return bool({"list", "current", "show", "status", "version", "--version", "help", "--help", "info",
                     "ls", "search", "doctor", "which", "commands"} & {a.lower() for a in args})
    if binary == "git":
        return git_is_read_only(args)
    if binary == "crontab":
        return "-l" in args and not {"-r", "-e", "-i"} & set(args)
    if binary in READ_ONLY_BINARIES:
        bad = WRITE_ARGS.get(binary, ())
        if any(a in bad or a.split("=")[0] in bad for a in args):
            return False
        if binary == "sed" and any(re.fullmatch(r"-[a-zA-Z]*i.*|--in-place.*", a) for a in args):
            return False
        return not (binary in ("mount", "swapon") and any(not a.startswith("-") for a in args))
    allowed = READ_ONLY_SUBCOMMANDS.get(binary)
    if not allowed:
        return False
    words = [a for a in args if not a.startswith("-") or a in allowed]
    return " ".join(words[:2]) in allowed or (bool(words) and words[0] in allowed)


def wrapped_is_read_only(binary: str, args: list[str]) -> bool:
    """`time`, `watch`, `xargs` and friends are as safe as the command they run."""
    rest = list(args)
    if binary == "command" and rest[:1] in (["-v"], ["-V"]):
        return True
    while rest and rest[0].startswith("-"):
        if rest.pop(0) in WRAPPER_VALUE_FLAGS and rest:
            rest.pop(0)
    if binary == "timeout" and rest:
        rest = rest[1:]  # the duration
    return segment_is_read_only(rest)


def find_is_read_only(args: list[str]) -> bool:
    if {"-delete", "-fprint", "-fprint0", "-fprintf", "-fls"} & {a.lower() for a in args}:
        return False
    i = 0
    while i < len(args):
        if args[i] in ("-exec", "-execdir", "-ok", "-okdir"):
            j = i + 1
            while j < len(args) and args[j] not in (";", "+", FIND_EXEC_END):
                j += 1
            if not segment_is_read_only([t for t in args[i + 1:j] if t != "{}"]):
                return False
            i = j
        i += 1
    return True


def curl_is_read_only(args: list[str]) -> bool:
    for i, a in enumerate(args):
        short_write = a.startswith("-") and not a.startswith("--") and any(f in a[1:] for f in "oOTdFcKD")
        if a.split("=")[0] in CURL_WRITE_FLAGS or short_write:
            return False
        if a in ("-X", "--request") and i + 1 < len(args) and args[i + 1].upper() not in ("GET", "HEAD"):
            return False
    return True


def pacman_is_read_only(args: list[str]) -> bool:
    if not args:
        return False
    op = args[0]
    if op.startswith("--"):
        return op in ("--query", "--version", "--help")
    return op.startswith("-") and (op[1:2] in ("Q", "V", "h") or re.fullmatch(r"-S[sigl]+", op) is not None
                                   or (op[1:2] == "F" and "y" not in op))


def git_is_read_only(args: list[str]) -> bool:
    rest = list(args)
    while rest and rest[0].startswith("-"):  # global options: git -C dir, git --no-pager
        if rest.pop(0) in ("-C", "-c") and rest:
            rest.pop(0)
    if not rest:
        return False
    sub, sub_args = rest[0], rest[1:]
    if sub in READ_ONLY_SUBCOMMANDS["git"]:
        return not (sub == "reflog" and sub_args[:1] in (["expire"], ["delete"]))
    if sub == "branch":
        bad = {"-d", "-D", "-m", "-M", "-c", "-C", "-f", "--delete", "--move", "--copy", "--force", "-u",
               "--set-upstream-to", "--unset-upstream", "--edit-description"}
        listing = "--list" in sub_args or "-l" in sub_args or all(a.startswith("-") for a in sub_args)
        return listing and not any(a.split("=")[0] in bad for a in sub_args)
    if sub == "tag":
        return not sub_args or "-l" in sub_args or "--list" in sub_args
    if sub == "remote":
        return not sub_args or sub_args[0] in ("-v", "--verbose", "show", "get-url")
    if sub == "stash":
        return sub_args[:1] in (["list"], ["show"])
    if sub == "config":
        return bool({"--get", "--get-all", "--get-regexp", "--list", "-l", "--show-origin"} & set(sub_args))
    return sub in ("worktree", "submodule") and sub_args[:1] in (["list"], ["status"], [])


# ----------------------------------------------------------------------------- the model

def machine() -> str:
    """OS pretty name + shell name: the only context sent along with a question."""
    name = sys.platform
    try:
        text = Path("/etc/os-release").read_text(encoding="utf-8")
        found = re.search(r'^PRETTY_NAME="?([^"\n]*)', text, re.M)
        name = found.group(1) if found else name
    except OSError:
        pass
    if os.path.isdir(os.path.expanduser("~/.local/share/omarchy")) and "omarchy" not in name.lower():
        name += " (Omarchy)"
    return f"{name}, {os.path.basename(os.environ.get('SHELL') or 'sh')}"


def ask_messages(question: str) -> list[dict]:
    return [{"role": "system", "content": PROMPT.format(machine=machine())},
            {"role": "user", "content": f"how {question}"}]


def explain_messages(command: str) -> list[dict]:
    return [{"role": "system", "content": EXPLAIN_PROMPT.format(machine=machine())},
            {"role": "user", "content": command}]


def chat(messages: list[dict]) -> str:
    """One request to the OpenAI-compatible endpoint. Raises HowError with an actionable hint."""
    key, _ = api_key()
    if not key:
        raise HowError("no_key", "no API key yet", f"run: how key   (free key at {KEYS_URL})")
    body: dict = {"model": model(), "messages": messages, "temperature": 0.1}
    if body["model"].startswith("openai/gpt-oss"):
        body["reasoning_effort"] = "low"
    request = urllib.request.Request(api_url(), data=json.dumps(body).encode(), method="POST", headers={
        "Authorization": f"Bearer {key}", "Content-Type": "application/json", "User-Agent": f"how/{__version__}"})
    debug(f"POST {api_url()} model={body['model']}")
    try:
        # The URL is the fixed https API_URL, or the user's own HOW_API_URL.
        with urllib.request.urlopen(request, timeout=TIMEOUT_S) as response:  # nosec B310
            data = json.load(response)
    except urllib.error.HTTPError as e:
        raise http_error(e) from None
    except (TimeoutError, socket.timeout):
        raise HowError("timeout", f"no answer within {TIMEOUT_S}s", "try again in a moment") from None
    except urllib.error.URLError as e:
        if isinstance(e.reason, (TimeoutError, socket.timeout)):
            raise HowError("timeout", f"no answer within {TIMEOUT_S}s", "try again in a moment") from None
        host = urllib.parse.urlsplit(api_url()).hostname
        raise HowError("offline", f"cannot reach {host}", f"check your connection ({e.reason})") from None
    except ValueError:
        raise HowError("bad_response", "the API sent something that is not JSON", "try again") from None
    try:
        return str(data["choices"][0]["message"]["content"] or "").strip()
    except (KeyError, IndexError, TypeError):
        raise HowError("bad_response", "unexpected reply from the API", "try again, or run: how doctor") from None


def http_error(e: urllib.error.HTTPError) -> HowError:
    if e.code in (401, 403):
        return HowError("bad_key", "the API key was rejected", f"run: how key   (new key at {KEYS_URL})")
    if e.code == 429:
        wait = e.headers.get("retry-after") if e.headers else None
        return HowError("rate_limited", "rate limited by the API",
                        f"wait {wait}s and try again" if wait else "wait a moment and try again")
    return HowError("api_error", f"the API answered HTTP {e.code}", "try again; if it persists, run: how doctor")


class Answer(NamedTuple):
    command: Optional[str]
    note: str
    unknown: bool = False


def parse_answer(text: str) -> Answer:
    """Splits a model reply into the command (from the fenced block) and its one-line note."""
    text = text.strip()
    if re.fullmatch(r"i don['’]?t know\.?", text, re.I) or not text:
        return Answer(None, "I don't know", unknown=True)
    block = re.search(r"```[\w+-]*[ \t]*\n(.*?)```", text, re.S)
    if not block:
        return Answer(None, text.splitlines()[0].strip())
    rest = (text[:block.start()] + text[block.end():]).strip().splitlines()
    note = rest[0].strip() if rest else ""
    return Answer(join_lines(block.group(1)), note)


def join_lines(block: str) -> Optional[str]:
    """Turns a code block into one command line: `\\` continuations join with a space, lines with &&."""
    command, pending = [], ""
    for raw in block.splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        line = re.sub(r"^\$\s+", "", line)
        if line.endswith("\\"):
            pending += line[:-1].rstrip() + " "
            continue
        command.append(pending + line)
        pending = ""
    if pending:
        command.append(pending.strip())
    return " && ".join(command) or None


# ----------------------------------------------------------------------------- log & last answer

def log_event(event: str, **fields) -> None:
    """Appends one JSON line to how.log (0600, rotated at 1 MiB). Never raises: logging must not break a query."""
    entry = {"ts": datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds"), "event": event,
             "question": None, "command": None, "safety": None, "action": None, "exit_code": None,
             "latency_ms": None, "model": None, "version": __version__}
    entry.update(fields)
    path = log_file()
    try:
        path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        if path.exists() and path.stat().st_size >= LOG_MAX_BYTES:
            os.replace(path, path.with_name("how.log.1"))
        fd = os.open(path, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
        with os.fdopen(fd, "a", encoding="utf-8") as f:
            f.write(json.dumps(entry, ensure_ascii=False) + "\n")
    except OSError as e:
        debug(f"could not write log {path}: {e}")


def save_last(question: str, answer: Answer) -> None:
    data = {"question": question, "command": answer.command, "note": answer.note, "version": __version__}
    try:
        write_private(last_file(), json.dumps(data, indent=2, ensure_ascii=False))
    except OSError as e:
        debug(f"could not save {last_file()}: {e}")


def load_last() -> dict:
    last = read_json(last_file())
    if not last.get("question"):
        raise HowError("no_last", "nothing asked yet", "ask something first, e.g.: how to check disk space")
    return last


# ----------------------------------------------------------------------------- asking and running

BADGES = {"safe": ("🟢", "green"), "modifies": ("🟡", "yellow"), "dangerous": ("🔴", "red")}


def badge(level: str, reason: str, stream=None) -> str:
    icon, color = BADGES[level]
    return paint(f"{icon} {level}", color, "bold", stream=stream) + paint(f" · {reason}", "dim", stream=stream)


def cmd_ask(question: str, opts: dict) -> int:
    started = time.monotonic()
    try:
        with spinner("thinking"):
            reply = chat(ask_messages(question))
    except HowError as e:
        log_event("error", question=question, action=e.code, model=model())
        raise
    answer = parse_answer(reply)
    level, reason = classify(answer.command) if answer.command else (None, "")
    log_event("answer", question=question, command=answer.command, safety=level, model=model(),
              latency_ms=round((time.monotonic() - started) * 1000))
    save_last(question, answer)
    if opts["json"]:
        print(json.dumps(json_result(question, answer, level, reason), ensure_ascii=False))
        return 2 if answer.unknown else 0
    if answer.unknown:
        raise HowError("dont_know", "I don't know.", "try rephrasing, or name the tool you mean", exit_code=2)
    if not answer.command:
        print(answer.note)
        return 0
    return offer(question, answer.command, answer.note, opts)


def json_result(question: str, answer: Optional[Answer], level: Optional[str], reason: str,
                error: Optional[HowError] = None) -> dict:
    if answer and answer.unknown:
        error = HowError("dont_know", "I don't know.", "try rephrasing, or name the tool you mean")
    return {"schema_version": "1", "ok": error is None, "question": question,
            "command": answer.command if answer else None, "note": answer.note if answer else "",
            "safety": {"level": level, "reason": reason} if level else None,
            "error": {"code": error.code, "message": error.message, "hint": error.hint} if error else None,
            "version": __version__}


def offer(question: str, command: str, note: str, opts: dict) -> int:
    """Shows the command with its badge, then (on a terminal) waits for one keypress to run it."""
    level, reason = classify(command)
    if opts["no_run"] or not interactive():
        print(command)
        err(f"{badge(level, reason, stream=sys.stderr)}" + (paint(f" · {note}", "dim", stream=sys.stderr) if note else ""))
        if opts["no_run"] and copy_to_clipboard(command):
            log_event("copy", question=question, command=command, safety=level, action="copy")
        return 0
    copied = copy_to_clipboard(command)
    print(badge(level, reason))
    print("  " + paint(command, "bold", "cyan"))
    extras = [note] if note else []
    if copied:
        extras.append("copied")
        log_event("copy", question=question, command=command, safety=level, action="copy")
    if extras:
        print(paint("  " + " · ".join(extras), "dim"))
    if opts["yes"] and level == "safe":
        return execute(question, command, level, "auto")
    return prompt_loop(question, command, level)


PROMPTS = {
    "safe": "[Enter] run · [c] copy · [e] explain · [q] quit ",
    "modifies": "[y] run · [c] copy · [e] explain · [q] quit ",
    "dangerous": "type run + Enter to run · c copy · e explain · Enter quits: ",
}

RUN_KEYS = {"safe": ("\n", "y"), "modifies": ("y",), "dangerous": ("run",)}


def prompt_loop(question: str, command: str, level: str) -> int:
    while True:
        prompt = paint(PROMPTS[level], "dim")
        choice = ask_line(prompt).lower() if level == "dangerous" else read_key(prompt)
        if choice in RUN_KEYS[level]:
            return execute(question, command, level, "run")
        if choice == "\n" and level == "modifies":
            print(paint("  this one changes something: press y to run it", "yellow"))
        elif choice == "c":
            print(paint("  copied" if copy_to_clipboard(command) else "  no clipboard tool (install wl-clipboard)", "dim"))
        elif choice == "e":
            try:
                explain_and_print(command)
            except HowError as e:  # a failed explanation should not lose the command
                err(paint(f"  how: {e.message} ({e.hint})", "yellow", stream=sys.stderr))
        elif choice in ("q", "\x1b", "") or level == "dangerous":
            log_event("run", question=question, command=command, safety=level, action="quit")
            return 0


def execute(question: str, command: str, level: str, action: str, event: str = "run") -> int:
    """Runs exactly the shown command through the user's shell, attached to this terminal.

    While it runs, Ctrl-C belongs to the command: how waits instead of dying (a Python handler,
    unlike SIG_IGN, is reset to the default in the child)."""
    shell = os.environ.get("SHELL") or "/bin/sh"
    debug(f"running via {shell} -c")
    previous = signal.signal(signal.SIGINT, lambda *_: None)
    try:
        # The one place a shell runs model output: the user saw this exact command and confirmed it.
        process = subprocess.Popen([shell, "-c", command])  # nosec B603
        code = process.wait()
    finally:
        signal.signal(signal.SIGINT, previous)
    code = 128 - code if code < 0 else code  # killed by signal N -> 128+N, like a shell
    if code:
        err(paint(f"how: command exited with {code}", "yellow", stream=sys.stderr))
    log_event(event, question=question, command=command, safety=level, action=action, exit_code=code)
    return code


def cmd_run(opts: dict) -> int:
    last = load_last()
    if not last.get("command"):
        raise HowError("no_command", "the last answer had no command", "ask something first")
    return offer(last["question"], last["command"], last.get("note", ""), opts)


def explain_and_print(command: str) -> None:
    with spinner("explaining"):
        text = chat(explain_messages(command))
    for line in text.splitlines():
        print(paint("  " + line, "dim") if line.strip() else "")


def cmd_explain(args: list[str]) -> int:
    command = " ".join(args).strip() or str(read_json(last_file()).get("command") or "")
    if not command:
        raise HowError("no_last", "nothing to explain", 'pass a command: how explain "tar -xzvf a.tgz"')
    level, reason = classify(command)
    print(badge(level, reason))
    print("  " + paint(command, "bold", "cyan"))
    if not api_key()[0]:
        raise HowError("no_key", "the badge above is local; the breakdown needs an API key", "run: how key")
    explain_and_print(command)
    return 0


