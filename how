def parse_retention(val) -> int:
    """
    Parses retention duration string into seconds.
    Units: s (seconds), m (minutes), h (hours), D (days), w (weeks), M (months).
    Values '0', 'off', 'disable', 'none' disable caching (0 seconds).
    """
    import re
    if isinstance(val, (int, float)):
        return max(0, int(val))
    text = str(val).strip().replace(",", ".")
    text_lower = text.lower()
    if text_lower in ("0", "off", "disable", "disabled", "none", "false"):
        return 0

    text = re.sub(r"^(?:retention|time)\s*(?:=|:|\s)?\s*", "", text, flags=re.IGNORECASE)
    pattern = r"(\d+(?:\.\d+)?)\s*([a-zA-Z]+)?"

    leftover = re.sub(pattern, "", text).strip()
    if leftover:
        raise ValueError(f'Unrecognized retention time format: "{leftover}"')

    matches = list(re.finditer(pattern, text))
    if not matches:
        raise ValueError(f'Invalid retention time format: "{val}"')

    word_map = {
        "s": 1, "sec": 1, "secs": 1, "second": 1, "seconds": 1,
        "min": 60, "mins": 60, "minute": 60, "minutes": 60,
        "hr": 3600, "hrs": 3600, "hour": 3600, "hours": 3600,
        "day": 86400, "days": 86400,
        "w": 7 * 86400, "wk": 7 * 86400, "week": 7 * 86400, "weeks": 7 * 86400,
        "mo": 30 * 86400, "mon": 30 * 86400, "month": 30 * 86400, "months": 30 * 86400,
    }

    total_seconds = 0
    for m in matches:
        num = float(m.group(1))
        unit = m.group(2)
        if not unit:
            if len(matches) == 1:
                int_n = int(num) if num.is_integer() else num
                raise ValueError(
                    f"Missing time unit for value {int_n} (use: m - minutes, h - hours, D - days, M - months)"
                )
            raise ValueError(f"Missing time unit for value {num}")

        if unit == "m":
            multiplier = 60
        elif unit == "M":
            multiplier = 30 * 86400
        elif unit in ("D", "d"):
            multiplier = 86400
        elif unit in ("h", "H"):
            multiplier = 3600
        elif unit in ("s", "S"):
            multiplier = 1
        elif unit in ("w", "W"):
            multiplier = 7 * 86400
        else:
            u_lower = unit.lower()
            if u_lower in word_map:
                multiplier = word_map[u_lower]
            else:
                raise ValueError(f'Unknown time unit: "{unit}" (use: m - minutes, h - hours, D - days, M - months)')

        total_seconds += int(num * multiplier)
    return total_seconds


def format_retention(sec: int) -> str:
    """Formats retention seconds into human-readable description with unit notation."""
    if sec <= 0:
        return "disabled (0s)"
    parts = []
    mo = sec // (30 * 86400)
    sec_rem = sec % (30 * 86400)
    d = sec_rem // 86400
    sec_rem %= 86400
    h = sec_rem // 3600
    sec_rem %= 3600
    m = sec_rem // 60
    s = sec_rem % 60

    if mo > 0:
        parts.append(f"{mo} month{'s' if mo > 1 else ''} ({mo}M)")
    if d > 0:
        parts.append(f"{d} day{'s' if d > 1 else ''} ({d}D)")
    if h > 0:
        parts.append(f"{h} hour{'s' if h > 1 else ''} ({h}h)")
    if m > 0:
        parts.append(f"{m} minute{'s' if m > 1 else ''} ({m}m)")
    if s > 0:
        parts.append(f"{s}s")
    return ", ".join(parts) if parts else "0s"


def format_retention_short(sec: int) -> str:
    """Formats seconds into compact notation (m, h, D, M)."""
    if sec < 60:
        return f"{sec}s"
    m = sec // 60
    if m < 60:
        s = sec % 60
        return f"{m}m" if s == 0 else f"{m}m {s}s"
    h = m // 60
    m_rem = m % 60
    if h < 24:
        return f"{h}h" if m_rem == 0 else f"{h}h {m_rem}m"
    d = h // 24
    h_rem = h % 24
    if d < 30:
        return f"{d}D" if h_rem == 0 else f"{d}D {h_rem}h"
    mo = d // 30
    d_rem = d % 30
    return f"{mo}M" if d_rem == 0 else f"{mo}M {d_rem}D"


def get_effective_retention(override=None):
    """
    Resolves active cache retention in seconds by priority:
    1. CLI override (--retention)
    2. HOW_CACHE_RETENTION env var
    3. config.json
    4. DEFAULT_CACHE_RETENTION (3h)
    """
    if override is not None:
        try:
            return parse_retention(override)
        except ValueError as e:
            print(f"{YELLOW}! Invalid retention flag ({e}), using current configuration.{RESET}")

    env_val = os.environ.get("HOW_CACHE_RETENTION", "").strip()
    if env_val:
        try:
            return parse_retention(env_val)
        except ValueError:
            pass

    cfg = load_config()
    if "cache_retention_seconds" in cfg:
        try:
            return max(0, int(cfg["cache_retention_seconds"]))
        except Exception:
            pass

    if "cache_retention" in cfg:
        try:
            return parse_retention(cfg["cache_retention"])
        except Exception:
            pass

    return DEFAULT_CACHE_RETENTION


def get_db_connection():
    """Opens connection to SQLite cache database with WAL mode and schema initialization."""
    import sqlite3
    os.makedirs(CACHE_DIR, exist_ok=True)
    conn = sqlite3.connect(CACHE_DB_FILE, timeout=5.0)
    try:
        conn.execute("PRAGMA journal_mode=WAL")
    except Exception:
        pass
    with conn:
        conn.execute("""
            CREATE TABLE IF NOT EXISTS response_cache (
                key TEXT PRIMARY KEY,
                query TEXT,
                model TEXT,
                verbosity TEXT,
                response TEXT,
                created_at REAL,
                expires_at REAL,
                hit_count INTEGER DEFAULT 1,
                last_hit_at REAL
            )
        """)
        try:
            conn.execute("ALTER TABLE response_cache ADD COLUMN hit_count INTEGER DEFAULT 1")
        except Exception:
            pass
        try:
            conn.execute("ALTER TABLE response_cache ADD COLUMN last_hit_at REAL")
        except Exception:
            pass
        conn.execute("CREATE INDEX IF NOT EXISTS idx_expires_at ON response_cache(expires_at)")
    return conn


class db_session:
    """Context manager yielding a SQLite connection, committing on success and rolling back on error."""
    def __init__(self):
        self.conn = None

    def __enter__(self):
        self.conn = get_db_connection()
        return self.conn

    def __exit__(self, exc_type, exc_val, exc_tb):
        if self.conn:
            try:
                if exc_type is None:
                    try:
                        self.conn.commit()
                    except Exception:
                        pass
                else:
                    try:
                        self.conn.rollback()
                    except Exception:
                        pass
            finally:
                try:
                    self.conn.close()
                except Exception:
                    pass
        return False


def compute_cache_key(query, model, verbosity, prompt_hash="", docs_hash=""):
    """Computes deterministic SHA256 cache key from query parameters and context hashes."""
    import hashlib
    import re
    norm_query = re.sub(r"\s+", " ", query.strip())
    parts = [model, verbosity, norm_query]
    if prompt_hash:
        parts.append(prompt_hash)
    if docs_hash:
        parts.append(docs_hash)
    return hashlib.sha256(":".join(parts).encode("utf-8")).hexdigest()


def get_cached_response(query, model, verbosity, retention_seconds, prompt_hash="", docs_hash="", return_hits=False):
    """Returns (response_text, created_at) on valid cache hit.

    With return_hits=True returns
    (response_text, created_at, hit_count, seconds_since_previous_hit).
    """
    if retention_seconds <= 0:
        return None
    import time
    try:
        cache_key = compute_cache_key(query, model, verbosity, prompt_hash=prompt_hash, docs_hash=docs_hash)
        now = time.time()
        with db_session() as conn:
            conn.execute("DELETE FROM response_cache WHERE expires_at < ?", (now,))
            cur = conn.cursor()
            cur.execute(
                "SELECT response, created_at, expires_at, COALESCE(hit_count, 1), last_hit_at "
                "FROM response_cache WHERE key = ?",
                (cache_key,),
            )
            row = cur.fetchone()
            if row:
                resp, created_at, expires_at, hits, last_hit_at = row
                if now < expires_at:
                    prev_touch = float(last_hit_at or created_at or now)
                    seconds_since_prev = max(0, int(now - prev_touch))
                    new_expires_at = now + retention_seconds
                    new_hits = int(hits or 1) + 1
                    conn.execute(
                        "UPDATE response_cache SET expires_at = ?, hit_count = ?, last_hit_at = ? WHERE key = ?",
                        (new_expires_at, new_hits, now, cache_key),
                    )
                    if return_hits:
                        return resp, created_at, new_hits, seconds_since_prev
                    return resp, created_at
    except Exception:
        pass
    return None


def save_cached_response(query, model, verbosity, response_text, retention_seconds, prompt_hash="", docs_hash=""):
    """Stores response in SQLite cache with TTL expiration timestamp. Never caches uncertain ('I don't know') responses."""
    if retention_seconds <= 0 or not response_text or is_uncertain_response(response_text):
        return
    import time
    try:
        cache_key = compute_cache_key(query, model, verbosity, prompt_hash=prompt_hash, docs_hash=docs_hash)
        now = time.time()
        expires_at = now + retention_seconds
        with db_session() as conn:
            conn.execute("""
                INSERT OR REPLACE INTO response_cache
                    (key, query, model, verbosity, response, created_at, expires_at, hit_count, last_hit_at)
                VALUES (?, ?, ?, ?, ?, ?, ?, 1, ?)
            """, (cache_key, query, model, verbosity, response_text, now, expires_at, now))
    except Exception:
        pass


def cache_status():
    """Displays detailed cache status."""
    import time
    retention_sec = get_effective_retention()
    ret_str = format_retention(retention_sec)
    status_label = f"{GREEN}enabled{RESET}" if retention_sec > 0 else f"{YELLOW}disabled (0s){RESET}"

    total_entries = 0
    active_entries = 0
    expired_entries = 0
    db_size_kb = 0.0

    if os.path.exists(CACHE_DB_FILE):
        try:
            db_size_kb = os.path.getsize(CACHE_DB_FILE) / 1024.0
            now = time.time()
            with db_session() as conn:
                cur = conn.cursor()
                cur.execute("SELECT COUNT(*) FROM response_cache")
                total_entries = cur.fetchone()[0]
                cur.execute("SELECT COUNT(*) FROM response_cache WHERE expires_at > ?", (now,))
                active_entries = cur.fetchone()[0]
                expired_entries = total_entries - active_entries
        except Exception:
            pass

    print(f"\n{BOLD}{MAGENTA}◆ Groq Response Cache Status{RESET}\n")
    print(f"  Status:    {status_label}")
    print(f"  Retention: {BOLD}{CYAN}{ret_str}{RESET} {DIM}({retention_sec}s){RESET}")
    print(f"  Entries:   {BOLD}{active_entries}{RESET} active {DIM}(total: {total_entries}, expired: {expired_entries}){RESET}")
    print(f"  DB Size:   {DIM}{db_size_kb:.1f} KB{RESET}")
    print(f"  Database:  {DIM}{CACHE_DB_FILE}{RESET}\n")
    print(f"{BOLD}Cache commands:{RESET}")
    print(f"  {CYAN}how cache retention <time>{RESET}  Change retention (e.g. 30m, 3h, 7D, 1M)")
    print(f"  {CYAN}how cache clear{RESET}             Clear entire cache")
    print(f"  {CYAN}how cache off / on{RESET}          Disable or enable cache")
    print(f"  {CYAN}how --no-cache <query>{RESET}      Query bypassing cache\n")


def cache_clear():
    """Clears all cached responses."""
    count = 0
    if os.path.exists(CACHE_DB_FILE):
        try:
            with db_session() as conn:
                cur = conn.cursor()
                cur.execute("SELECT COUNT(*) FROM response_cache")
                count = cur.fetchone()[0]
                cur.execute("DELETE FROM response_cache")
                conn.commit()
                try:
                    conn.isolation_level = None
                    conn.execute("VACUUM")
                except Exception:
                    pass
        except Exception as e:
            print(f"{RED}✗ Error clearing cache: {e}{RESET}\n")
            return
    print(f"\n{GREEN}✓ Cache cleared.{RESET} {DIM}Removed {count} entries.{RESET}\n")


def cache_set_retention(val=None):
    """Updates configured cache retention duration."""
    if not val:
        current_sec = get_effective_retention()
        current_str = format_retention(current_sec)
        print(f"\n{BOLD}{MAGENTA}◆ Set Cache Retention Time{RESET}\n")
        print(f"  Current retention: {BOLD}{CYAN}{current_str}{RESET}\n")
        print(f"  {BOLD}Retention format:{RESET} {CYAN}m{RESET} - minutes, {CYAN}h{RESET} - hours, {CYAN}D{RESET} - days, {CYAN}M{RESET} - months")
        print("  Examples: 30m, 3h (default), 7D, 1M, 0 / off\n")
        try:
            val = input(f"{BOLD}Enter new retention [{current_str}]: {RESET}").strip()
        except (KeyboardInterrupt, EOFError):
            print(f"\n{YELLOW}Cancelled.{RESET}\n")
            return
        if not val:
            print(f"\n{DIM}Kept retention: {current_str}{RESET}\n")
            return

    try:
        sec = parse_retention(val)
    except ValueError as e:
        print(f"\n{RED}✗ {e}{RESET}\n")
        return

    cfg = load_config()
    cfg["cache_retention_seconds"] = sec
    cfg["cache_retention"] = str(val).strip()
    save_config(cfg)

    formatted = format_retention(sec)
    if sec == 0:
        print(f"\n{YELLOW}✓ Response cache has been disabled (retention: 0s).{RESET}\n")
    else:
        print(f"\n{GREEN}✓ Cache retention updated to:{RESET} {BOLD}{CYAN}{formatted}{RESET} {DIM}({sec}s){RESET}\n")


