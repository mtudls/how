def parse_cli_args(raw_args):
    """Parses raw CLI arguments into options dict and remaining positional arguments."""
    verbosity = None
    no_cache = False
    custom_retention = None
    feedback_mode = False
    feedback_yes = False
    version_requested = False
    think_mode = None
    no_context = False
    force_context = False
    context_mode_override = None
    dry_run = False
    no_escalate = False
    offline = False
    reflex_first = False
    args = []

    if len(raw_args) == 1 and raw_args[0] in ("--version", "-V", "version"):
        return {"version_requested": True}, []

    is_feedback_context = False
    non_flags = [a.lower() for a in raw_args if not a.startswith("-")]
    if any(a.lower() in ("--feedback", "--bug", "--issue", "--report") for a in raw_args):
        is_feedback_context = True
    elif non_flags and non_flags[0] in ("feedback", "bug", "report", "issue", "run", "!"):
        is_feedback_context = True

    i = 0
    while i < len(raw_args):
        a = raw_args[i]
        a_lower = a.lower()
        if a_lower in ("--feedback", "--bug", "--issue", "--report"):
            feedback_mode = True
            i += 1
        elif is_feedback_context and a_lower in ("-y", "--yes"):
            feedback_yes = True
            i += 1
        elif a_lower in ("-0", "--zero", "-q", "--quiet"):
            verbosity = "zero"
            i += 1
        elif a_lower == "--low":
            verbosity = "low"
            i += 1
        elif a_lower == "--normal":
            verbosity = "normal"
            i += 1
        elif a_lower in ("-t", "--think", "--deep"):
            think_mode = "deep"
            i += 1
        elif a_lower == "--fast":
            think_mode = "fast"
            i += 1
        elif a_lower in ("--offline", "--local"):
            offline = True
            i += 1
        elif a_lower in ("--reflex", "--system1"):
            reflex_first = True
            i += 1
        elif a_lower == "--no-context":
            no_context = True
            i += 1
        elif a_lower == "--context":
            force_context = True
            i += 1
        elif a_lower == "--yolo":
            force_context = True
            context_mode_override = "yolo"
            i += 1
        elif a_lower == "--careful":
            context_mode_override = "careful"
            i += 1
        elif a_lower == "--dry-run":
            dry_run = True
            i += 1
        elif a_lower == "--no-escalate":
            no_escalate = True
            i += 1
        elif a_lower in ("-v", "--verbosity"):
            if i + 1 < len(raw_args):
                cand = raw_args[i + 1].lower().strip()
                if cand in ("zero", "0", "none", "quiet"):
                    verbosity = "zero"
                elif cand in ("low", "1", "minimal", "min"):
                    verbosity = "low"
                elif cand in ("normal", "2", "default", "standard"):
                    verbosity = "normal"
                else:
                    print(f"{RED}✗ Invalid verbosity level: '{raw_args[i + 1]}'{RESET}")
                    print(f"{DIM}Allowed: zero (command only), low (minimal description), normal (standard){RESET}\n")
                    sys.exit(2)
                i += 2
            else:
                print(f"{RED}✗ Provide verbosity level after {a} (zero, low, normal).{RESET}")
                sys.exit(2)
        elif a_lower.startswith("--verbosity="):
            cand = a.split("=", 1)[1].lower().strip()
            if cand in ("zero", "0", "none", "quiet"):
                verbosity = "zero"
            elif cand in ("low", "1", "minimal", "min"):
                verbosity = "low"
            elif cand in ("normal", "2", "default", "standard"):
                verbosity = "normal"
            else:
                print(f"{RED}✗ Invalid verbosity level: '{a.split('=', 1)[1]}'{RESET}")
                print(f"{DIM}Allowed: zero (command only), low (minimal description), normal (standard){RESET}\n")
                sys.exit(2)
            i += 1
        elif a_lower in ("--no-cache", "--fresh", "--refresh"):
            no_cache = True
            i += 1
        elif a_lower in ("--retention", "--cache-retention"):
            if i + 1 < len(raw_args):
                custom_retention = raw_args[i + 1]
                i += 2
            else:
                print(f"{RED}✗ Provide retention time after {a} (e.g. 30m, 3h, 7D, 1M).{RESET}")
                sys.exit(1)
        elif a_lower.startswith("--retention=") or a_lower.startswith("--cache-retention="):
            custom_retention = a.split("=", 1)[1]
            i += 1
        else:
            args.append(raw_args[i])
            i += 1

    opts = {
        "verbosity": verbosity,
        "no_cache": no_cache,
        "custom_retention": custom_retention,
        "feedback_mode": feedback_mode,
        "feedback_yes": feedback_yes,
        "version_requested": version_requested,
        "think_mode": think_mode,
        "no_context": no_context,
        "force_context": force_context,
        "context_mode_override": context_mode_override,
        "dry_run": dry_run,
        "no_escalate": no_escalate,
        "offline": offline,
        "reflex_first": reflex_first,
    }
    return opts, args


def dispatch_subcommand(args, opts):
    """Dispatches administrative CLI subcommands. Returns True if handled."""
    if not args:
        return False

    first = args[0].lower()

    if opts.get("version_requested") or (
        len(args) == 1 and (first in ("version", "--version") or args[0] == "-V")
    ):
        print(f"how {__version__}")
        return True

    if first == "status" and len(args) == 1:
        show_unified_status()
        return True

    if first in ("where", "locate"):
        run_where_command(args[1:], opts)
        return True

    if first in ("reflex", "offline"):
        run_offline_reflex(" ".join(args[1:]), verbosity=opts.get("verbosity"))
        return True

    if first in ("run", "!") and len(args) == 1:
        run_last_command(auto_yes=opts.get("feedback_yes", False), dry_run=opts.get("dry_run", False))
        return True

    if first in ("explain", "anatomy", "dissect"):
        run_explain_command(args[1:])
        return True

    if first in ("shell-init", "init-shell"):
        run_shell_init_command(args[1:])
        return True

    if first in ("fix", "repair", "diagnose"):
        run_fix_command(args[1:], opts)
        return True

    if first in ("build", "compile", "transpile"):
        build_rust_binary_command(args[1:])
        return True

    if first == "context":
        valid_ctx_subs = (
            "status", "info", "on", "off", "enable", "disable",
            "os", "stack", "refresh", "careful", "step", "step-by-step",
            "interactive", "yolo", "dry-run", "dry", "plan",
        )
        if opts.get("dry_run"):
            manage_context_command(["dry-run"] + args[1:])
            return True
        if len(args) == 1 or args[1].lower() in valid_ctx_subs:
            manage_context_command(args[1:])
            return True

    if first == "triage":
        manage_triage_command(args[1:])
        return True

    if first in ("verbosity", "verbose"):
        target_v = args[1] if len(args) > 1 else None
        set_verbosity_interactive(target_v)
        return True

    if first in ("self-test", "test", "check-self"):
        use_docker = any(x in args[1:] for x in ("--docker", "-d", "docker"))
        auto_stats = any(x in args[1:] for x in ("--stats", "-s", "--ci"))
        run_self_test(use_docker=use_docker, auto_stats=auto_stats)
        return True

    if first in ("feedback", "bug", "report", "issue"):
        msg = " ".join(args[1:])
        send_terminal_feedback(msg, auto_yes=opts.get("feedback_yes", False))
        return True

    if opts.get("feedback_mode"):
        msg = " ".join(args)
        send_terminal_feedback(msg, auto_yes=opts.get("feedback_yes", False))
        return True

    if first == "cache":
        if len(args) == 1:
            cache_status()
            return True
        sub = args[1].lower()
        if sub in ("clear", "clean", "purge", "flush", "reset") and len(args) == 2:
            cache_clear()
            return True
        if sub in ("status", "info") and len(args) == 2:
            cache_status()
            return True
        if sub in ("off", "disable") and len(args) == 2:
            cache_set_retention("0")
            return True
        if sub in ("on", "enable") and len(args) == 2:
            cache_set_retention("3h")
            return True
        if sub in ("retention", "set"):
            if len(args) > 2:
                cache_set_retention(" ".join(args[2:]))
            else:
                cache_set_retention(None)
            return True
        cand_time = " ".join(args[1:])
        try:
            parse_retention(cand_time)
            cache_set_retention(cand_time)
            return True
        except ValueError:
            pass

    if first == "auth":
        if len(args) == 1:
            auth_status()
            return True
        sub = args[1].lower()
        if sub in ("login", "in") and len(args) == 2:
            auth_login()
            return True
        if sub in ("logout", "out") and len(args) == 2:
            auth_logout()
            return True
        if sub == "status" and len(args) == 2:
            auth_status()
            return True

    if first in ("bash-history", "history-bash"):
        sub = args[1].lower() if len(args) > 1 else "status"
        set_bash_history_setting(sub)
        return True

    if first in ("history", "commands"):
        filter_t = args[1] if len(args) > 1 else None
        show_command_history(filter_term=filter_t)
        return True

    if first in ("model", "models"):
        if len(args) == 1:
            select_model_interactive()
            return True
        if len(args) >= 2:
            sub = args[1].lower()
            if sub == "check" and len(args) == 2:
                check_all_models()
                return True
            if sub == "think":
                cfg = load_config()
                if len(args) >= 3:
                    target_think = args[2].strip()
                    cfg["think_model"] = target_think
                    save_config(cfg)
                    print(f"\n{GREEN}✓ Deep thinking model set to:{RESET} {BOLD}{CYAN}{target_think}{RESET}\n")
                else:
                    prov, mod, _ = resolve_deep_provider(cfg)
                    print(f"\n{BOLD}Active Deep Thinking Model:{RESET} {CYAN}{prov}:{mod}{RESET}")
                    print(f"{DIM}Set custom model via: {CYAN}how model think <provider:model>{RESET} (e.g. groq:openai/gpt-oss-120b, gemini:gemini-2.5-pro, anthropic:claude-3-7-sonnet-latest, cli:claude)\n")
                return True
            if len(args) == 2 and (sub.isdigit() or "/" in sub):
                select_model_interactive(args[1])
                return True

    return False


def main():
    if len(sys.argv) < 2:
        print_help()
        sys.exit(0)

    raw_args = sys.argv[1:]

    if len(raw_args) == 1 and raw_args[0].lower() in ("--help", "-h", "help"):
        print_help()
        sys.exit(0)

    opts, args = parse_cli_args(raw_args)

    if opts.get("version_requested"):
        print(f"how {__version__}")
        sys.exit(0)

    if not args and opts.get("dry_run"):
        print_context_dry_run_plan()
        sys.exit(0)

    if not args and not opts.get("feedback_mode"):
        print_help()
        sys.exit(0)

    if dispatch_subcommand(args, opts):
        sys.exit(0)

    query = " ".join(args)
    intent = classify_query_intent(query)
    if intent == "where":
        run_where_command(args, opts)
        sys.exit(0)
    if intent == "fix":
        run_fix_command(args, opts)
        sys.exit(0)
    if intent == "explain":
        run_explain_command(args)
        sys.exit(0)

    ask_groq(
        query,
        verbosity=opts.get("verbosity"),
        no_cache=opts.get("no_cache", False),
        custom_retention=opts.get("custom_retention"),
        think_mode=opts.get("think_mode"),
        no_context=opts.get("no_context", False),
        force_context=opts.get("force_context", False),
        context_mode_override=opts.get("context_mode_override"),
        dry_run=opts.get("dry_run", False),
        no_escalate=opts.get("no_escalate", False),
        offline=opts.get("offline", False),
        reflex_first=opts.get("reflex_first", False),
    )


if __name__ == "__main__":
    main()
