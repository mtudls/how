def extract_executable_command(text):
    """Extracts the executable command from a ```bash or ```sh code block."""
    clean_text = text.strip().lower().rstrip(".!?:")
    if clean_text in ("i don't know", "i dont know", "idk"):
        return None

    import re
    m = re.search(r"```(?:bash|sh)?\s*\n(.*?)\n```", text, re.DOTALL)
    if not m:
        return None

    code = m.group(1).strip()
    lines = [line.strip() for line in code.splitlines() if line.strip() and not line.strip().startswith("#")]
    if not lines:
        return None

    if len(lines) == 1:
        return lines[0]

    if len(lines) <= 3:
        control_keywords = ("if", "then", "else", "fi", "for", "while", "do", "done", "case", "esac")
        if not any(lines[0].startswith(kw) for kw in control_keywords):
            return " && ".join(lines)

    return lines[0]


def classify_command_safety(command: str) -> dict:
    """
    Classifies a shell command into a traffic-light safety tier in <0.1ms:
    - 'safe': read-only inspection, listing, searching, or status queries (🟢 SAFE)
    - 'modifies': writes files, installs packages, updates config, or mutates git/services (🟡 MODIFIES)
    - 'destructive': deletes data, removes packages, alters disk/partitions/bootloader, or force-kills (🔴 DESTRUCTIVE / ADMIN)
    """
    import re
    cmd = (command or "").strip()
    if not cmd:
        return {
            "level": "safe",
            "badge": f"{GREEN}🟢 SAFE (read-only){RESET}",
            "short_badge": "🟢 safe",
            "reason": "empty command",
        }

    low = cmd.lower()

    destructive_rules = [
        (r"\brm\s+.*(?:-r|-f|--recursive|--force)", "removes files/directories recursively or forcefully"),
        (r"\bfind\b.*(?:-delete|-exec\s+rm\b)", "deletes matched filesystem entries"),
        (r"\b(?:dd\s+.*of=|mkfs|fdisk|parted|sfdisk|cfdisk|wipefs|shred)\b", "modifies or formats block devices/disks"),
        (r"\b(?:pacman|yay|paru)\s+-[a-z]*r[a-z]*\b", "removes installed system packages"),
        (r"\b(?:apt|apt-get|dnf)\s+(?:remove|purge|autoremove)\b", "removes installed packages"),
        (r"\bomarchy\s+pkg\s+remove\b", "removes packages via Omarchy"),
        (r"\bgit\s+(?:reset\s+--hard|clean\s+-[a-z]*f|push\s+.*(?:-f|--force)|branch\s+-D)\b", "discards uncommitted or remote Git history"),
        (r"\b(?:kill|killall|pkill)\s+(?:-9|-sigkill)\b", "force-terminates processes (SIGKILL)"),
        (r"\b(?:reboot|poweroff|shutdown|halt)\b", "powers off or reboots the system"),
        (r"\b(?:limine\s+enroll-config|sbctl|faillock\s+--reset|ufw\s+|iptables\b|nft\s+)", "alters bootloader, auth locks, or firewall rules"),
        (r"\b(?:chmod\s+-r\s+777|chown\s+-r)\b", "recursively changes ownership or world-writable permissions"),
        (r">\s*/dev/(?:sd[a-z]|nvme\d|vd[a-z])", "writes directly to a raw block device"),
    ]
    for pat, reason in destructive_rules:
        if re.search(pat, low):
            return {
                "level": "destructive",
                "badge": f"{RED}{BOLD}🔴 DESTRUCTIVE / ADMIN{RESET}",
                "short_badge": "🔴 destructive",
                "reason": reason,
            }

    modifies_rules = [
        (r"\b(?:rm|mv|cp|mkdir|rmdir|touch|ln|chmod|chown|chgrp|truncate|tee|rsync)\b", "creates, moves, links, or modifies files/permissions"),
        (r"\bsed\s+-[a-z]*i\b", "edits files in-place"),
        (r"(?:^|[^0-9>&])>>?\s*(?!/dev/null\b|&)\S+", "redirects output to write or overwrite a file"),
        (r"\b(?:pacman|yay|paru)\s+-(?:S|U)\b", "installs or upgrades system packages"),
        (r"\b(?:apt|apt-get|dnf|apk|zypper)\s+(?:install|update|upgrade)\b", "installs or updates packages"),
        (r"\bomarchy\s+(?:update|pkg\s+add|plugin\s+add|theme\s+set|font\s+set)\b", "updates Omarchy packages, plugins, or desktop theme/font"),
        (r"\b(?:pip|pipx|uv\s+add|uv\s+pip\s+install|npm\s+install|pnpm\s+add|bun\s+add|cargo\s+install|cargo\s+add)\b", "installs project/language dependencies"),
        (r"\bsystemctl\s+(?:--user\s+)?(?:start|stop|restart|reload|enable|disable|mask|unmask)\b", "changes systemd service state"),
        (r"\b(?:hostnamectl\s+set-|timedatectl\s+set-|nmcli\s+.*(?:connect|up|down|modify|add|delete)|wpctl\s+set-|xdg-settings\s+set|xdg-mime\s+default)\b", "modifies system or desktop settings"),
        (r"\bgit\s+(?:commit|push|pull|merge|rebase|checkout|switch|clone|init|add|stash|tag|remote\s+(?:add|set-url|remove|rename))\b", "modifies Git repository state or remotes"),
        (r"\bgh\s+(?:repo\s+create|issue\s+create|pr\s+create|auth\s+switch)\b", "modifies GitHub resources or active account"),
        (r"\b(?:sudo|pkexec|doas)\b", "executes with elevated administrator privileges"),
    ]
    for pat, reason in modifies_rules:
        if re.search(pat, low):
            return {
                "level": "modifies",
                "badge": f"{YELLOW}{BOLD}🟡 MODIFIES{RESET}",
                "short_badge": "🟡 modifies",
                "reason": reason,
            }

    return {
        "level": "safe",
        "badge": f"{GREEN}{BOLD}🟢 SAFE (read-only){RESET}",
        "short_badge": "🟢 safe",
        "reason": "read-only inspection or query",
    }


