def detect_os_profile() -> dict:
    """
    Discovers OS name, version, kernel, desktop/WM, shell, and package managers
    using fast, read-only local checks without spawning subprocesses.
    """
    import shutil
    profile = {
        "os_name": sys.platform,
        "os_version": "",
        "omarchy": False,
        "kernel": "",
        "desktop": "",
        "shell": "",
        "pkg_managers": [],
    }

    try:
        u = os.uname()
        profile["kernel"] = u.release
    except Exception:
        pass

    os_release_paths = ("/etc/os-release", "/usr/lib/os-release")
    for p in os_release_paths:
        if os.path.isfile(p):
            try:
                with open(p, "r", encoding="utf-8", errors="ignore") as f:
                    data = {}
                    for line in f:
                        line = line.strip()
                        if "=" in line and not line.startswith("#"):
                            k, v = line.split("=", 1)
                            data[k] = v.strip().strip('"').strip("'")
                    profile["os_name"] = data.get("PRETTY_NAME") or data.get("NAME") or profile["os_name"]
                    profile["os_version"] = data.get("VERSION_ID") or data.get("BUILD_ID") or ""
                break
            except Exception:
                pass

    if shutil.which("omarchy") or os.path.isdir("/usr/share/omarchy"):
        profile["omarchy"] = True

    desktop_parts = []
    xdg_desktop = os.environ.get("XDG_CURRENT_DESKTOP") or os.environ.get("DESKTOP_SESSION") or ""
    if xdg_desktop:
        desktop_parts.append(xdg_desktop)
    elif os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        desktop_parts.append("Hyprland")
    session_type = os.environ.get("XDG_SESSION_TYPE") or ("wayland" if os.environ.get("WAYLAND_DISPLAY") else "")
    if session_type and session_type.lower() not in " ".join(desktop_parts).lower():
        desktop_parts.append(session_type)
    profile["desktop"] = " / ".join(desktop_parts)

    shell_env = os.environ.get("SHELL") or ""
    if shell_env:
        profile["shell"] = os.path.basename(shell_env)

    pkgs = []
    for pm in ("pacman", "yay", "paru", "apt", "dnf", "apk", "zypper", "brew", "nix"):
        if shutil.which(pm):
            pkgs.append(pm)
    profile["pkg_managers"] = pkgs

    parts = []
    os_label = profile["os_name"]
    if profile["os_version"] and profile["os_version"] not in os_label:
        os_label += f" {profile['os_version']}"
    if profile["omarchy"] and "omarchy" not in os_label.lower():
        os_label += " (Omarchy)"
    parts.append(f"OS: {os_label}")
    if profile["kernel"]:
        parts.append(f"Kernel: {profile['kernel']}")
    if profile["desktop"]:
        parts.append(f"Desktop: {profile['desktop']}")
    if profile["shell"]:
        parts.append(f"Shell: {profile['shell']}")
    if profile["pkg_managers"]:
        parts.append(f"Pkg: {', '.join(profile['pkg_managers'])}")

    profile["summary"] = " | ".join(parts)
    return profile


def detect_local_stack(cwd=None) -> dict:
    """
    Detects the software stack and tools used in the given directory (default: os.getcwd()).
    Inspects only safe project manifest filenames and lightweight metadata (never .env or secrets).
    """
    import json
    target_dir = os.path.abspath(cwd or os.getcwd())
    try:
        entries = set(os.listdir(target_dir))
    except Exception:
        return {"dir": os.path.basename(target_dir), "tools": [], "summary": ""}

    tools = []
    details = []

    # Python stack
    if "uv.lock" in entries:
        tools.append("Python (uv)")
    elif "poetry.lock" in entries:
        tools.append("Python (poetry)")
    elif "Pipfile" in entries:
        tools.append("Python (pipenv)")
    elif "pyproject.toml" in entries or "requirements.txt" in entries or "setup.py" in entries:
        tools.append("Python")

    if "manage.py" in entries:
        details.append("Django")
    if ".ruff.toml" in entries or "ruff.toml" in entries:
        details.append("ruff")
    if "pytest.ini" in entries or "conftest.py" in entries:
        details.append("pytest")

    # Node / JS / TS stack
    if "bun.lockb" in entries or "bun.lock" in entries:
        tools.append("Bun")
    elif "pnpm-lock.yaml" in entries:
        tools.append("Node.js (pnpm)")
    elif "yarn.lock" in entries:
        tools.append("Node.js (yarn)")
    elif "package-lock.json" in entries:
        tools.append("Node.js (npm)")
    elif "package.json" in entries:
        tools.append("Node.js")

    if "deno.json" in entries or "deno.jsonc" in entries:
        tools.append("Deno")
    if "tsconfig.json" in entries:
        details.append("TypeScript")

    if "package.json" in entries:
        pkg_path = os.path.join(target_dir, "package.json")
        try:
            if os.path.getsize(pkg_path) <= 65536:
                with open(pkg_path, "r", encoding="utf-8", errors="ignore") as f:
                    pkg = json.load(f)
                deps = {}
                deps.update(pkg.get("dependencies") or {})
                deps.update(pkg.get("devDependencies") or {})
                for fw, label in (
                    ("next", "Next.js"),
                    ("vite", "Vite"),
                    ("astro", "Astro"),
                    ("svelte", "Svelte"),
                    ("react", "React"),
                    ("vue", "Vue"),
                    ("tailwindcss", "Tailwind"),
                ):
                    if fw in deps and label not in details:
                        details.append(label)
                scripts = list((pkg.get("scripts") or {}).keys())[:6]
                if scripts:
                    details.append(f"scripts: {','.join(scripts)}")
        except Exception:
            pass

    # Rust, Go, Ruby, Elixir, Zig, C/C++, Nix, Arch
    if "Cargo.toml" in entries:
        tools.append("Rust (cargo)")
    if "go.mod" in entries:
        tools.append("Go (go)")
    if "Gemfile" in entries:
        if os.path.exists(os.path.join(target_dir, "bin", "rails")):
            tools.append("Ruby on Rails (bundle exec rails)")
        else:
            tools.append("Ruby (bundler)")
    if "mix.exs" in entries:
        tools.append("Elixir (mix)")
    if "build.zig" in entries:
        tools.append("Zig")
    if "CMakeLists.txt" in entries:
        tools.append("CMake")
    if "flake.nix" in entries or "shell.nix" in entries:
        tools.append("Nix")
    if "PKGBUILD" in entries:
        tools.append("Arch PKGBUILD (makepkg)")

    # Containers & Task runners
    if any(f in entries for f in ("compose.yaml", "compose.yml", "docker-compose.yml", "docker-compose.yaml")):
        tools.append("Docker Compose")
    elif "Dockerfile" in entries or "Containerfile" in entries:
        tools.append("Docker")

    if "justfile" in entries or "Justfile" in entries:
        details.append("just")
    if "Makefile" in entries or "makefile" in entries:
        details.append("make")
    if "Taskfile.yml" in entries or "Taskfile.yaml" in entries:
        details.append("task")
    if ".git" in entries or os.path.isdir(os.path.join(target_dir, ".git")):
        details.append("git")
    if "manifest.json" in entries and "qml" in entries:
        details.append("Omarchy QML Plugin")

    dir_name = os.path.basename(target_dir) or target_dir
    if not tools and not details:
        return {"dir": dir_name, "tools": [], "details": [], "summary": ""}

    summary_items = tools + [d for d in details if d not in tools]
    summary = f"Project ({dir_name}): {', '.join(summary_items)}"
    return {
        "dir": dir_name,
        "tools": tools,
        "details": details,
        "summary": summary,
    }


def ensure_context_permissions(cfg=None, interactive_allowed=True) -> dict:
    """
    Ensures user permission settings for OS/version discovery and local stack discovery exist.
    Prompts once on first interactive run and caches the choices in config.json.
    """
    if cfg is None:
        cfg = load_config()

    if "discover_os" in cfg and "discover_stack" in cfg:
        return cfg

    # Check environment variable overrides
    env_ctx = os.environ.get("HOW_CONTEXT", "").strip().lower()
    if env_ctx in ("0", "off", "false", "none", "no"):
        cfg["discover_os"] = False
        cfg["discover_stack"] = False
        return cfg
    if env_ctx in ("1", "on", "true", "yes", "all"):
        cfg["discover_os"] = True
        cfg["discover_stack"] = True
        if not cfg.get("os_profile"):
            cfg["os_profile"] = detect_os_profile()
        return cfg

    is_tty = (
        interactive_allowed
        and sys.stdin.isatty()
        and sys.stdout.isatty()
        and not os.environ.get("CI")
        and not os.environ.get("TESTING")
        and not os.environ.get("HOW_NO_BROWSER")
        and not os.environ.get("HOW_NO_PROMPT")
    )

    if not is_tty or cfg.get("context_prompted"):
        cfg.setdefault("discover_os", False)
        cfg.setdefault("discover_stack", False)
        return cfg

    print(f"\n{BOLD}{MAGENTA}◆ Environment & Stack Discovery Permission (One-Time Setup){RESET}")
    print(f"{DIM}`how` can tailor commands to your exact OS/version and current project folder.{RESET}")
    try:
        ans_os = input(f"  {CYAN}1. Allow discovering OS, version & desktop environment? [Y/n]:{RESET} ").strip().lower()
        allow_os = ans_os in ("", "y", "yes")
        ans_stack = input(f"  {CYAN}2. Allow discovering project stack (Cargo, npm, uv, Docker...) in current dir? [Y/n]:{RESET} ").strip().lower()
        allow_stack = ans_stack in ("", "y", "yes")
    except (KeyboardInterrupt, EOFError):
        print()
        allow_os = False
        allow_stack = False

    cfg["discover_os"] = allow_os
    cfg["discover_stack"] = allow_stack
    cfg["context_prompted"] = True
    if allow_os:
        cfg["os_profile"] = detect_os_profile()
    save_config(cfg)
    status_os = f"{GREEN}on{RESET}" if allow_os else f"{DIM}off{RESET}"
    status_st = f"{GREEN}on{RESET}" if allow_stack else f"{DIM}off{RESET}"
    print(f"  {GREEN}✓ Saved preferences{RESET} (OS: {status_os}, Stack: {status_st} — change anytime via `{CYAN}how context{RESET}`).\n")
    return cfg


def get_active_environment_context(cfg=None, no_context=False, force_context=False, cwd=None) -> str:
    """
    Returns formatted OS + local stack context string according to granted user permissions.
    Never reads or returns environment data without explicit permission or --context override.
    """
    if no_context or os.environ.get("HOW_NO_CONTEXT") in ("1", "true", "yes"):
        return ""

    if cfg is None:
        cfg = load_config()

    if not force_context:
        cfg = ensure_context_permissions(cfg)

    use_os = force_context or bool(cfg.get("discover_os", False))
    use_stack = force_context or bool(cfg.get("discover_stack", False))

    lines = []
    if use_os:
        os_prof = cfg.get("os_profile")
        if not isinstance(os_prof, dict) or not os_prof.get("summary"):
            os_prof = detect_os_profile()
            if cfg.get("discover_os"):
                cfg["os_profile"] = os_prof
                save_config(cfg)
        if os_prof.get("summary"):
            lines.append(os_prof["summary"])

    if use_stack:
        stack_info = detect_local_stack(cwd=cwd)
        if stack_info.get("summary"):
            lines.append(stack_info["summary"])

    return "\n".join(lines)


def manage_context_command(args):
    """Handles `how context [status|on|off|os|stack|refresh]` subcommand."""
    cfg = load_config()
    sub = args[0].lower() if args else "status"

    if sub in ("on", "enable", "1", "true"):
        cfg["discover_os"] = True
        cfg["discover_stack"] = True
        cfg["context_prompted"] = True
        cfg["os_profile"] = detect_os_profile()
        save_config(cfg)
        print(f"\n{GREEN}✓ Environment & stack discovery ENABLED.{RESET}")
        print(f"  {DIM}{cfg['os_profile'].get('summary', '')}{RESET}\n")
        return

    if sub in ("off", "disable", "0", "false"):
        cfg["discover_os"] = False
        cfg["discover_stack"] = False
        cfg["context_prompted"] = True
        save_config(cfg)
        print(f"\n{YELLOW}✓ Environment & stack discovery DISABLED.{RESET}\n")
        return

    if sub == "refresh":
        cfg["os_profile"] = detect_os_profile()
        save_config(cfg)
        print(f"\n{GREEN}✓ Refreshed OS profile:{RESET} {cfg['os_profile'].get('summary', '')}\n")
        return

    if sub == "os":
        action = args[1].lower() if len(args) > 1 else "status"
        if action in ("on", "enable", "1", "true"):
            cfg["discover_os"] = True
            cfg["context_prompted"] = True
            cfg["os_profile"] = detect_os_profile()
            save_config(cfg)
            print(f"\n{GREEN}✓ OS discovery ENABLED:{RESET} {cfg['os_profile'].get('summary', '')}\n")
        elif action in ("off", "disable", "0", "false"):
            cfg["discover_os"] = False
            cfg["context_prompted"] = True
            save_config(cfg)
            print(f"\n{YELLOW}✓ OS discovery DISABLED.{RESET}\n")
        else:
            st = f"{GREEN}enabled{RESET}" if cfg.get("discover_os") else f"{DIM}disabled{RESET}"
            print(f"\n{BOLD}OS Discovery:{RESET} {st}\n")
        return

    if sub == "stack":
        action = args[1].lower() if len(args) > 1 else "status"
        if action in ("on", "enable", "1", "true"):
            cfg["discover_stack"] = True
            cfg["context_prompted"] = True
            save_config(cfg)
            st_info = detect_local_stack()
            print(f"\n{GREEN}✓ Local stack discovery ENABLED.{RESET}")
            if st_info.get("summary"):
                print(f"  {DIM}{st_info['summary']}{RESET}")
            print()
        elif action in ("off", "disable", "0", "false"):
            cfg["discover_stack"] = False
            cfg["context_prompted"] = True
            save_config(cfg)
