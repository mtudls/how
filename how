def format_query(raw_query):
    """Optymalizuje prompt w kontekście konsoli Omarchy."""
    q = raw_query.strip()
    if "in omarchy" in q.lower():
        return q

    # Usuń ewentualny zbędny przedrostek 'to' jeśli podano 'how to ...'
    if q.lower().startswith("to "):
        return f"In Omarchy console how {q}"
    else:
        if any(q.lower().startswith(prefix) for prefix in ("auth ", "model ", "display ", "audio ", "network ")):
            return f"In Omarchy console: how {q}"
        return f"In Omarchy console: {q}"

def log_command_proposal(query, command, executed=False):
    """Zapisuje propozycję komendy do lokalnego logu ~/.config/how/commands.log"""
    try:
        os.makedirs(CONFIG_DIR, exist_ok=True)
        with open(COMMANDS_LOG, "a", encoding="utf-8") as f:
            status = "WYKONANO" if executed else "ZAPROPONOWANO"
            ts = time.strftime("%Y-%m-%d %H:%M:%S")
            q_clean = query.strip() if query else "-"
            f.write(f"[{ts}] [{status}] Pytanie: \"{q_clean}\" | Komenda: {command.strip()}\n")
    except Exception:
        pass

def copy_to_clipboard(text):
    """Kopiuje tekst do schowka Wayland (wl-copy) lub X11 (xclip), jeśli dostępne."""
    import subprocess
    for cmd in (["wl-copy"], ["xclip", "-selection", "clipboard"], ["xsel", "--clipboard"]):
        try:
            p = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            p.communicate(input=text.encode("utf-8"), timeout=1)
            if p.returncode == 0:
                return True
        except Exception:
            continue
    return False

def show_command_history(limit=15, filter_term=None):
    """Wyświetla ostatnie proponowane komendy."""
    if not os.path.exists(COMMANDS_LOG):
        print(f"\n{DIM}Brak zarejestrowanych komend w historii.{RESET}\n")
        return

    try:
        with open(COMMANDS_LOG, "r", encoding="utf-8") as f:
            lines = [line.strip() for line in f if line.strip()]

        if filter_term:
            ft = filter_term.lower()
            lines = [l for l in lines if ft in l.lower()]

        print(f"\n{BOLD}{MAGENTA}◆ Historia proponowanych komend{RESET}\n")
        if not lines:
            print(f"  {DIM}Brak komend pasujących do filtru.{RESET}\n")
            return
        recent = lines[-limit:]
        for line in recent:
            if "[WYKONANO]" in line:
                print(f"  {GREEN}✓{RESET} {DIM}{line}{RESET}")
            else:
                print(f"  {CYAN}➜{RESET} {DIM}{line}{RESET}")
        print(f"\n{DIM}Wskazówka: Komendy są zapisywane w ~/.bash_history oraz kopiowane do schowka systemowego.{RESET}\n")
    except Exception as e:
        print(f"{RED}Błąd odczytu historii: {e}{RESET}\n")

def save_to_bash_history(cmd):
    """Zapisuje polecenie do ~/.bash_history użytkownika."""
    try:
        hist_path = os.path.expanduser("~/.bash_history")
        with open(hist_path, "a", encoding="utf-8") as f:
            f.write(cmd.strip() + "\n")
    except Exception:
        pass

def extract_executable_command(text):
    """Wyodrębnia pierwszą komendę z bloku ```bash ... ``` lub ```sh ... ```."""
    clean_text = text.strip().lower().rstrip(".!?:")
    if clean_text in ("nie wiem", "nie wiem", "i don't know", "idk"):
        return None

    m = re.search(r"```(?:bash|sh)?\s*\n(.*?)\n```", text, re.DOTALL)
    if not m:
        return None

    code = m.group(1).strip()
    lines = [line.strip() for line in code.splitlines() if line.strip() and not line.strip().startswith("#")]
    if not lines:
        return None

    if len(lines) == 1:
        return lines[0]

    if len(lines) <= 3:
        control_keywords = ("if", "then", "else", "fi", "for", "while", "do", "done", "case", "esac")
        if not any(lines[0].startswith(kw) for kw in control_keywords):
            return " && ".join(lines)

    return lines[0]

def display_suggested_command(command, query="", is_cached=False):
    """
    Wypisuje sugerowaną komendę bezpośrednio w konsoli-rodzicu,
    kopiuje ją do schowka i rejestruje w logu oraz historii basha.
    how NIGDY nie uruchamia sam żadnej komendy ani konsoli potomnej!
    """
    cmd = command.strip()
    if not cmd:
        return

    save_to_bash_history(cmd)
    log_command_proposal(query, cmd, executed=False)
    copied = copy_to_clipboard(cmd)
    clip_hint = f" {GREEN}[skopiowano do schowka: wklej Ctrl+Shift+V]{RESET}" if copied else ""
    cache_tag = f" {YELLOW}[cache]{RESET}" if is_cached else ""

    print(f"{BOLD}{CYAN}Sugerowana komenda:{RESET}{cache_tag}{clip_hint}")
    print(f"  {BOLD}{GREEN}{cmd}{RESET}\n")

