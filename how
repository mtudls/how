def improve_query_locally(raw_query: str) -> tuple[str, list[str]]:
    """
    Repairs common CLI typos and expands ambiguous shorthand before retrying an uncertain query.
    Returns (improved_query, list_of_improvement_notes).
    """
    import re
    q = raw_query.strip()
    notes = []

    def _replace_word(match):
        word = match.group(0)
        low = word.lower()
        if low in TYPO_CORRECTIONS:
            fixed = TYPO_CORRECTIONS[low]
            notes.append(f"typo '{word}' -> '{fixed}'")
            return fixed
        return word

    improved = re.sub(r"[a-zA-Z0-9_]+", _replace_word, q)
    imp_low = improved.lower().strip(" ?!.")

    shorthand_expansions = [
        (r"^(?:to\s+)?see\s+origin$", "to see git remote origin url", "expanded git origin shorthand"),
        (r"^(?:to\s+)?check\s+origin$", "to check git remote origin url", "expanded git origin shorthand"),
        (r"^(?:to\s+)?(?:make|create)\s+symlink$", "to create a symbolic link with ln -s", "expanded symlink shorthand"),
        (r"^(?:to\s+)?add\s+private\s+repo\b", "to create or add a private git repository with gh or git", "clarified private git repo intent"),
    ]
    for pat, replacement, note in shorthand_expansions:
        if re.search(pat, imp_low):
            improved = re.sub(pat, replacement, imp_low, flags=re.IGNORECASE)
            notes.append(note)
            break

    return improved, notes


