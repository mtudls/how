def locate_where_targets(query: str) -> list[dict]:
    """
    Fast <5ms read-only spatial locator for configs, logs, binaries, directories, and ports.
    Combines curated `WHERE_KNOWLEDGE_BASE` with live local filesystem and `PATH` probes.
    """
    import re
    import shutil

    q_clean = (query or "").strip()
    q_low = q_clean.lower()
    for pfx in ("where is ", "where are ", "where's ", "where ", "locate ", "path to ", "location of ", "the ", "my "):
        if q_low.startswith(pfx):
            q_low = q_low[len(pfx):].strip()

    tokens = [
        t for t in re.findall(r"[a-z0-9_\-\.]+", q_low)
        if t not in ("where", "is", "are", "the", "my", "in", "on", "for", "of", "to", "a", "an", "file", "files", "path", "location", "located", "stored", "folder", "dir", "directory", "config", "configuration", "settings")
    ]
    all_tokens = set(re.findall(r"[a-z0-9_\-\.]+", q_low))
    results = []
    seen_paths = set()

    # 1. Port lookup probe (e.g. "where is port 8080")
    port_m = re.search(r"\bport\s+(\d{2,5})\b", q_low)
    if port_m:
        port_num = port_m.group(1)
        results.append({
            "title": f"Listening Socket on TCP/UDP Port {port_num}",
            "path": f"inet://0.0.0.0:{port_num}",
            "exists": True,
            "kind": "port",
            "inspect_cmd": f"ss -tulpn | grep :{port_num}",
            "description": f"Inspect process and socket bound to port {port_num}.",
            "score": 10.0,
        })

    # 2. `how` own config/cache/log lookup
    if "how" in all_tokens and any(k in all_tokens for k in ("config", "cache", "log", "history", "db", "settings")):
        for title, p, kind, cmd, desc in (
            ("how Configuration File", CONFIG_FILE, "config", f"cat {CONFIG_FILE}", "Active `how` settings and model preferences."),
            ("how Command History Log", COMMANDS_LOG, "log", f"tail -n 20 {COMMANDS_LOG}", "Log of suggested and executed commands."),
            ("how SQLite Response Cache", CACHE_DB_FILE, "config", f"ls -lh {CACHE_DB_FILE}", "Sliding-TTL SQLite WAL response cache."),
        ):
            seen_paths.add(p)
            results.append({
                "title": title,
                "path": p,
                "exists": os.path.exists(p),
                "kind": kind,
                "inspect_cmd": cmd,
                "description": desc,
                "score": 9.0,
            })

    # 3. Score curated WHERE_KNOWLEDGE_BASE entries
    for slug, kw_tuple, title, raw_path, kind, inspect_cmd, desc in WHERE_KNOWLEDGE_BASE:
        score = 0.0
        for kw in kw_tuple:
            if kw in q_low:
                score += 2.5 if " " in kw else 1.8
            elif kw in all_tokens:
                score += 1.8
        if any(t in raw_path.lower() for t in tokens):
            score += 1.5
        if score > 0:
            exp_path = os.path.expanduser(raw_path)
            exists = os.path.exists(exp_path)
            if exists:
                score += 0.4
            if exp_path not in seen_paths:
                seen_paths.add(exp_path)
                results.append({
                    "title": title,
                    "path": exp_path,
                    "exists": exists,
                    "kind": kind,
                    "inspect_cmd": inspect_cmd,
                    "description": desc,
                    "score": score,
                })

    # 4. Live read-only local probes: `~/.config/<token>` and `shutil.which(<token>)`
    for tok in (tokens or list(all_tokens)):
        if len(tok) < 2:
            continue
        user_cfg_dir = os.path.expanduser(f"~/.config/{tok}")
        if os.path.exists(user_cfg_dir) and user_cfg_dir not in seen_paths:
            seen_paths.add(user_cfg_dir)
            results.append({
                "title": f"User Config Directory for '{tok}'",
                "path": user_cfg_dir,
                "exists": True,
                "kind": "dir" if os.path.isdir(user_cfg_dir) else "config",
                "inspect_cmd": f"ls -la ~/.config/{tok}",
                "description": f"Discovered in local XDG config directory (`~/.config/{tok}`).",
                "score": 4.2,
            })

        bin_path = shutil.which(tok)
        if bin_path and bin_path not in seen_paths:
            seen_paths.add(bin_path)
            results.append({
                "title": f"Executable Binary '{tok}'",
                "path": bin_path,
                "exists": True,
                "kind": "binary",
                "inspect_cmd": f"ls -la {bin_path}",
                "description": f"Resolved on system `$PATH` (`{bin_path}`).",
                "score": 3.5 if results else 5.0,
            })

    results.sort(key=lambda r: r.get("score", 0.0), reverse=True)
    return results[:4]


def run_where_command(args, opts=None):
    """Handles `how where <query...>` — <5ms spatial locator."""
    import time
    t0 = time.perf_counter()
    opts = opts or {}
    cfg = load_config()
    verbosity = opts.get("verbosity") or cfg.get("verbosity", DEFAULT_VERBOSITY)

    query = " ".join(args).strip()
    if not query:
        print(f"\n{YELLOW}! Please specify what config, file, log, binary, or port to locate.{RESET}")
        print(f"{DIM}Examples:{RESET}")
        print(f"  {CYAN}how where hyprland monitor config{RESET}")
        print(f"  {CYAN}how where pacman log{RESET}")
        print(f"  {CYAN}how -0 where waybar config{RESET}\n")
        return

    targets = locate_where_targets(query)
    elapsed_ms = (time.perf_counter() - t0) * 1000

    if not targets:
        if verbosity == "zero":
            print("I don't know\n")
        else:
            print(f"\n{YELLOW}! No local path or standard config matched '{query}'.{RESET}\n")
        return

    top = targets[0]
    if verbosity == "zero":
        copy_to_clipboard(top["path"])
        print(f"{top['path']}\n")
        return

    print(
        f"\n{BOLD}{MAGENTA}◆ Spatial Locator (`where`){RESET} "
        f"{DIM}— resolved in {elapsed_ms:.2f}ms (read-only){RESET}\n"
    )
    for idx, item in enumerate(targets, 1):
        status_badge = (
            f"{GREEN}✓ exists{RESET}"
            if item.get("exists")
            else f"{DIM}○ standard path{RESET}"
        )
        prefix = f"{BOLD}{GREEN}➜{RESET}" if idx == 1 else f"  {DIM}•{RESET}"
        print(f"  {prefix} {BOLD}{item['title']}{RESET} [{status_badge}]")
        print(f"    {BOLD}{CYAN}{item['path']}{RESET}")
        print(f"    {DIM}{item['description']}{RESET}\n")

    display_suggested_command(top["inspect_cmd"], query=f"where: {query}", is_cached=False)


def get_shell_init_script(shell_name: str = "bash") -> str:
    """
    Golden Alternative (GA) Readline In-Place Prompt Injection (`Alt+H` / `\\eh`):
    Returns a tiny shell keybinding script for `bash`, `zsh`, or `fish`.
    Type `# kill process on port 3000` (or any query) in your prompt and press `Alt+H`
    to replace the current command line buffer in-place with the exact command.
    """
    sh = (shell_name or "bash").lower().strip()
    if sh == "zsh":
        return """# how in-place readline prompt widget (Alt+H)
_how_zle_widget() {
  local q="${BUFFER#\\#}"
  q="${q#"${q%%[![:space:]]*}"}"
  [ -z "$q" ] && return 0
  local out
  out="$(how -0 "$q" 2>/dev/null | head -n 1)"
  if [ -n "$out" ] && [ "$out" != "I don't know" ]; then
    BUFFER="$out"
    CURSOR=${#BUFFER}
  fi
  zle redisplay
}
zle -N _how_zle_widget
bindkey '\\eh' _how_zle_widget
"""
    if sh == "fish":
        return """# how in-place prompt widget (Alt+H)
function _how_fish_widget
  set -l q (string replace -r '^\\s*#?\\s*' '' -- (commandline -b))
  test -z "$q"; and return
  set -l out (how -0 "$q" 2>/dev/null | head -n 1)
  if test -n "$out" -a "$out" != "I don't know"
    commandline -r -- "$out"
    commandline -f repaint
  end
end
bind \\eh _how_fish_widget
"""
    return """# how in-place readline prompt widget (Alt+H)
_how_readline_widget() {
  local q="${READLINE_LINE#\\#}"
  q="${q#"${q%%[![:space:]]*}"}"
  [ -z "$q" ] && return 0
  local out
  out="$(how -0 "$q" 2>/dev/null | head -n 1)"
  if [ -n "$out" ] && [ "$out" != "I don't know" ]; then
    READLINE_LINE="$out"
    READLINE_POINT=${#READLINE_LINE}
  fi
}
bind -x '"\\eh": _how_readline_widget'
"""


def run_shell_init_command(args):
    """Handles `how shell-init [bash|zsh|fish]` to print the Alt+H in-place readline widget."""
    shell_name = args[0] if args else os.path.basename(os.environ.get("SHELL", "bash"))
    if shell_name not in ("bash", "zsh", "fish"):
        shell_name = "bash"
    sys.stdout.write(get_shell_init_script(shell_name))


