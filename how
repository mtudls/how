def run_last_command(auto_yes=False, dry_run=False):
    """Safely previews (dry-run) with Traffic-Light Safety Badge and optionally executes the last command."""
    if not os.path.exists(COMMANDS_LOG):
        print(f"\n{YELLOW}! No recent suggested command found in {COMMANDS_LOG}.{RESET}\n")
        return

    last_cmd, last_query = get_last_suggested_command()
    if not last_cmd:
        print(f"\n{YELLOW}! No executable command found in history.{RESET}\n")
        return

    safety = classify_command_safety(last_cmd)
    print(f"\n{BOLD}{MAGENTA}◆ Last Suggested Command{RESET}")
    if last_query:
        print(f"  Query:     {DIM}{last_query}{RESET}")
    print(f"  Safety:    {safety['badge']} {DIM}— {safety['reason']}{RESET}")
    print(f"  {YELLOW}[dry-run]{RESET}  {BOLD}{GREEN}$ {last_cmd}{RESET}\n")

    if dry_run:
        return

    is_destructive = safety.get("level") == "destructive"

    if not auto_yes:
        if not (sys.stdin.isatty() and sys.stdout.isatty()):
            print(f"{YELLOW}! Non-interactive shell: showing dry-run only (pass -y to execute).{RESET}\n")
            return
        try:
            if is_destructive:
                print(
                    f"  {RED}{BOLD}Warning:{RESET} this command is marked "
                    f"{RED}🔴 DESTRUCTIVE / ADMIN{RESET} {DIM}({safety.get('reason', '')}){RESET}."
                )
                ans = input(
                    f"  {CYAN}Type {BOLD}yes{RESET}{CYAN} to execute, or anything else to cancel:{RESET} "
                ).strip().lower()
                if ans != "yes":
                    print(f"  {DIM}Cancelled (destructive commands require typing 'yes').{RESET}\n")
                    return
            else:
                ans = input(f"  {CYAN}Execute this command now? [y/N]:{RESET} ").strip().lower()
                if ans not in ("y", "yes"):
                    print(f"  {DIM}Cancelled.{RESET}\n")
                    return
        except (KeyboardInterrupt, EOFError):
            print()
            return
    elif is_destructive:
        print(
            f"  {YELLOW}! Executing destructive command with -y / --yes "
            f"(no interactive confirmation).{RESET}\n"
        )

    import subprocess
    log_command_proposal(last_query, last_cmd, executed=True)
    res = subprocess.run(last_cmd, shell=True)  # nosec B602
    sys.exit(res.returncode)


def get_repo_dir() -> str:
    """Returns the repository directory containing `how`, supporting both file and embedded execution."""
    if os.environ.get("HOW_REPO_DIR"):
        return os.path.abspath(os.environ["HOW_REPO_DIR"])
    if "__file__" in globals():
        return os.path.dirname(os.path.realpath(__file__))
    return os.getcwd()


def build_rust_binary_command(args):
    """Transpiles `how` Python source into a native Rust binary locally without any LLM."""
    import subprocess
    repo_dir = get_repo_dir()
    transpiler = os.path.join(repo_dir, "scripts", "transpile_rust.py")
    if not os.path.exists(transpiler):
        print(f"\n{RED}✗ Rust transpiler not found at {transpiler}.{RESET}\n")
        sys.exit(1)

    target_bin = os.path.join(os.environ.get("HOW_INSTALL_DIR") or os.path.expanduser("~/.local/bin"), "how")
    cmd = [sys.executable, transpiler, os.path.join(repo_dir, "how"), "-o", target_bin] + list(args)
    res = subprocess.run(cmd)
    sys.exit(res.returncode)


