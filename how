def format_query(raw_query):
    """Formats the user query with Omarchy console context."""
    q = raw_query.strip()
    if "in omarchy" in q.lower():
        return q
    if q.lower().startswith("to "):
        return f"In Omarchy console how {q}"
    if any(q.lower().startswith(p) for p in ("auth ", "model ", "display ", "audio ", "network ")):
        return f"In Omarchy console: how {q}"
    return f"In Omarchy console: {q}"


def log_command_proposal(query, command, executed=False):
    """Logs proposed command to ~/.config/how/commands.log."""
    import time
    try:
        os.makedirs(CONFIG_DIR, exist_ok=True)
        with open(COMMANDS_LOG, "a", encoding="utf-8") as f:
            status = "EXECUTED" if executed else "PROPOSED"
            ts = time.strftime("%Y-%m-%d %H:%M:%S")
            q_clean = query.strip() if query else "-"
            f.write(f'[{ts}] [{status}] Query: "{q_clean}" | Command: {command.strip()}\n')
    except Exception:
        pass


def copy_to_clipboard(text):
    """Copies text to Wayland (wl-copy) or X11 (xclip/xsel) clipboard if available."""
    import subprocess
    for cmd in (["wl-copy"], ["xclip", "-selection", "clipboard"], ["xsel", "--clipboard"]):
        try:
            p = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            p.communicate(input=text.encode("utf-8"), timeout=1)
            if p.returncode == 0:
                return True
        except Exception:
            continue
    return False


def show_command_history(limit=15, filter_term=None):
    """Displays recent command suggestions from commands.log."""
    if not os.path.exists(COMMANDS_LOG):
        print(f"\n{DIM}No command history recorded.{RESET}\n")
        return

    try:
        with open(COMMANDS_LOG, "r", encoding="utf-8") as f:
            lines = [line.strip() for line in f if line.strip()]

        if filter_term:
            ft = filter_term.lower()
            lines = [line for line in lines if ft in line.lower()]

        print(f"\n{BOLD}{MAGENTA}◆ Command History{RESET}\n")
        if not lines:
            print(f"  {DIM}No commands matching filter.{RESET}\n")
            return
        for line in lines[-limit:]:
            if "[EXECUTED]" in line:
                print(f"  {GREEN}✓{RESET} {DIM}{line}{RESET}")
            else:
                print(f"  {CYAN}➜{RESET} {DIM}{line}{RESET}")
        print(f"\n{DIM}Tip: Run 'how bash-history on' to append suggestions to ~/.bash_history.{RESET}\n")
    except Exception as e:
        print(f"{RED}Error reading history: {e}{RESET}\n")


def is_bash_history_enabled():
