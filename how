def format_query(raw_query):
    """Formats the user query with Omarchy console context."""
    q = raw_query.strip()
    q_low = q.lower()
    for prefix in ("how do i ", "how can i ", "how to "):
        if q_low.startswith(prefix):
            q = "to " + q[len(prefix):].strip()
            q_low = q.lower()
            break
    if "in omarchy" in q_low:
        return q
    if q_low.startswith("to "):
        return f"In Omarchy console how {q}"
    if any(q_low.startswith(p) for p in ("auth ", "model ", "display ", "audio ", "network ")):
        return f"In Omarchy console: how {q}"
    return f"In Omarchy console: {q}"


